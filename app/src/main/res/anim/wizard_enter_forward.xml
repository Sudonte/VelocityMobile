<?xml version="1.0" encoding="utf-8"?>
<!-- A step coming in from the right: a short slide and fade. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@android:interpolator/fast_out_slow_in">
    <translate android:fromXDelta="6%" android:toXDelta="0" android:duration="220" />
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="220" />
</set>
