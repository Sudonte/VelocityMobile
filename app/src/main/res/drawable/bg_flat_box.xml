<?xml version="1.0" encoding="utf-8"?>
<!-- Flat, square section box: 1dp hairline border, no shadow, no corner radius.
     The shared surface for the booking/reservation screens (see ThemeOverlay.Velocity.Flat). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/velocity_surface_elevated" />
    <stroke
        android:width="1dp"
        android:color="@color/velocity_divider_hairline" />
    <corners android:radius="0dp" />
</shape>
