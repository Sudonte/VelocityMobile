<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fades toward the screen's own background tone (velocity_red_bg_end)
         instead of a hardcoded white, so this blends correctly with
         welcome.xml's root background in both Light and Dark Mode. -->
    <gradient
        android:angle="90"
        android:endColor="@color/velocity_red_bg_end"
        android:startColor="@color/velocity_red_alpha_00"
        android:type="linear" />
</shape>
