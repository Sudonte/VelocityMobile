<?xml version="1.0" encoding="utf-8"?>
<!-- The receipt's Grand Total panel: the same soft-red fill as bg_receipt_total_panel
     (the "Total Amount Paid" panel) plus a brand-red outline, so the two read as a
     hierarchy - Grand Total is the outlined, primary one - rather than as two identical
     boxes competing for attention. Both colors are theme-aware (values-night), so this
     works unchanged in dark mode. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/velocity_red_soft" />
    <stroke
        android:width="1.5dp"
        android:color="@color/velocity_red_primary" />
    <corners android:radius="0dp" />
</shape>
