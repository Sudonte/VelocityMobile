<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="@color/velocity_red_subtle" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <gradient
                    android:angle="0"
                    android:endColor="@color/velocity_red_medium"
                    android:startColor="@color/velocity_red_rose"
                    android:type="linear" />
                <corners android:radius="8dp" />
            </shape>
        </clip>
    </item>
</layer-list>
