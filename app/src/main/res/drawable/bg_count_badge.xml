<?xml version="1.0" encoding="utf-8"?>
<!-- The round count badge in a Dashboard section header: solid red, so it reads in dark mode too (the number is white). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/velocity_red_primary" />
    <corners android:radius="12dp" />
</shape>
