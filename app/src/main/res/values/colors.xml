<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <!-- Scrims/overlays used by layouts instead of inline hex values. -->
    <color name="velocity_scrim_40">#66000000</color>
    <color name="velocity_scrim_60">#99000000</color>
    <color name="velocity_white_15">#26FFFFFF</color>
    <color name="velocity_white_20">#33FFFFFF</color>

    <!-- Velocity Suites Red & White Theme -->
    <!-- The whole app renders in red and white only. The resource names are kept
         so every existing layout/style/drawable reference stays valid. -->
    <color name="velocity_red_deep">#5A0A0A</color>
    <color name="velocity_red_dark">#7F1212</color>
    <color name="velocity_red_medium">#B71C1C</color>
    <color name="velocity_red_primary">#D32F2F</color>
    <color name="velocity_red_rose">#EF5350</color>
    <color name="velocity_red_soft">#FDECEC</color>
    <color name="velocity_red_subtle">#F7D4D4</color>
    <color name="velocity_red_bg_start">#FDE7E7</color>
    <color name="velocity_red_bg_end">#FFFFFF</color>
    <color name="velocity_text_secondary">#5A4141</color>
    <color name="velocity_text_primary">#1A1010</color>
    <color name="velocity_inactive_gray">#9E9E9E</color>
    <!-- Elevated surface (navigation drawer + its header) - separate from
         bg_glass_card_white's translucent card look since these are solid,
         opaque surfaces. Overridden per-theme in values-night/colors.xml -
         see Dark Mode support. -->
    <!-- A card / chip / stepper-button surface that must be white in Light and a dark surface in Dark (unlike "white",
         which stays white on purpose for logos, text on red, and photo overlays). -->
    <color name="velocity_card_surface">#FFFFFF</color>
    <!-- The empty track of a step-progress bar. -->
    <color name="velocity_track">#F0F0F0</color>
    <color name="velocity_surface_elevated">#FFFFFF</color>

    <!-- Status Colors (mapped to red shades to keep the red & white palette) -->
    <color name="velocity_green_primary">#B71C1C</color>
    <color name="velocity_green_dark">#7F1212</color>
    <color name="velocity_green_soft">#FDECEC</color>
    <!-- A real green, only for "nothing owed" (the brand family above is red): dark green in Light, light green in Dark. -->
    <color name="velocity_success_text">#1B5E20</color>
    <color name="velocity_green_subtle">#F7D4D4</color>

    <!-- Blue Status (Checked-In) -> red -->
    <color name="velocity_blue_primary">#C62828</color>
    <color name="velocity_blue_soft">#FCE4E4</color>

    <!-- Gray Status (Checked-Out) - neutral -->
    <color name="velocity_gray_primary">#757575</color>
    <color name="velocity_gray_soft">#F5F5F5</color>

    <!-- Status accents (red) -->
    <color name="velocity_red_status_dark">#7F1212</color>
    <color name="velocity_red_status_soft">#FDECEC</color>
    <color name="velocity_red_status_subtle">#F7D4D4</color>

    <!-- Warning/Yellow -> red -->
    <color name="velocity_orange_primary">#E53935</color>
    <color name="velocity_orange_soft">#FFEAEA</color>

    <!-- GCash Branding -> red -->
    <color name="gcash_blue">#D32F2F</color>
    <color name="gcash_blue_soft">#FDECEC</color>

    <!-- Payment-status badge colors (TransactionStatusHelper) - the ONE place a transaction's
         status gets its color, shared by Transaction History, the detail screen, the receipt
         and the notification cards. Unlike the velocity_green_*/blue_*/orange_* names above
         (kept as red aliases so the rest of the app stays red & white), these are real
         amber / green / blue / gray / red so a guest can tell the states apart at a glance.
         Every bg/fg pair is >= 4.5:1 (WCAG AA) in both themes - enforced by
         StatusColorContrastTest. The brand red stays the chrome/accent color everywhere else. -->
    <color name="status_pending_bg">#FFF1CC</color>
    <color name="status_pending_fg">#7A4F00</color>
    <color name="status_paid_bg">#DDF3E1</color>
    <color name="status_paid_fg">#176B2C</color>
    <color name="status_partial_bg">#DCEBFB</color>
    <color name="status_partial_fg">#0B569E</color>
    <color name="status_cancelled_bg">#E6E6E6</color>
    <color name="status_cancelled_fg">#4D4D4D</color>
    <color name="status_rejected_bg">#FADADA</color>
    <color name="status_rejected_fg">#9B1C1C</color>

    <!-- Brand-red TEXT for small actions/chips on light or tinted cards (e.g. "View Transaction",
         "Mark as read", the category chip). velocity_red_primary is fine for fills and large text
         but only ~4.2:1 on the pale chip/unread tints (and ~3:1 on dark surfaces) - too low for
         11-12sp labels. Darker in light mode, lighter in dark mode (values-night). -->
    <color name="velocity_action_text">#B71C1C</color>

    <!-- Alpha Reds for effects -->
    <color name="velocity_red_alpha_40">#66D32F2F</color>
    <color name="velocity_red_alpha_20">#33D32F2F</color>
    <color name="velocity_red_alpha_00">#00D32F2F</color>

    <!-- Premium accents (red instead of gold to stay red & white) -->
    <color name="velocity_gold_deep">#7F1212</color>
    <color name="velocity_gold_dark">#B71C1C</color>
    <color name="velocity_gold_primary">#D32F2F</color>

    <!-- Landing surface tints -->
    <color name="velocity_landing_overlay">#66000000</color>

    <!-- Overlay / scrim tints (loading overlays, sticky bar backgrounds, hairline dividers) -->
    <color name="velocity_overlay_scrim_light">#80FFFFFF</color>
    <color name="velocity_sticky_bar_bg">#E6FFFFFF</color>
    <color name="velocity_divider_hairline">#1A000000</color>
    <!-- Text in the dark-red family: unchanged in Light, a light red in Dark so it stays readable on dark surfaces. -->
    <color name="velocity_red_text">#7F1212</color>
    <color name="velocity_filter_stroke">#8C8080</color>
    <!-- "Unpaid": red text on its soft chip. Light mode keeps the brand red; dark mode lightens it so it stays readable on the dark chip. -->
    <color name="status_unpaid_fg">#D32F2F</color>
    <!-- A card sitting inside another bordered container (the payment cards in Payment Status): a touch off the container's surface, so it does not look heavy. -->
    <color name="velocity_card_inset">#FBF7F7</color>
</resources>
