<?xml version="1.0" encoding="utf-8"?>
<!--
    Flat controls with ROUNDED CARDS for the whole app (originally the flat/square Booking and Reservation screens; cards are now 12dp with a subtle 2dp elevation, see dimens card_corner_radius / card_elevation):
      - no shadows: elevation 0 on cards, buttons, dialogs and bottom sheets, and no button press
        shadow (stateListAnimator @null);
      - every box fully square: corner radius 0 on cards, buttons, text fields, chips, image
        previews, badges, dialogs and bottom sheets;
      - sections are separated by thin 1dp borders and spacing instead of shadows;
      - touch targets are at least 48dp.
    It is wired once into the base Theme.VelocitySuites (day and night), so every widget and
    dialog picks it up. Brand colors and fonts are untouched (this file only sets shape/elevation).
-->
<resources>

    <!-- Cards (and dialogs / sheets that share the medium-component shape): 12dp corners, app-wide. -->
    <style name="ShapeAppearance.Velocity.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/card_corner_radius</item>
    </style>

    <style name="ShapeAppearance.Velocity.Square" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.Velocity.Flat.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Velocity.Square</item>
    </style>

    <style name="Widget.Velocity.Flat.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/velocity_red_primary</item>
        <item name="android:textColor">@color/velocity_red_primary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Velocity.Square</item>
    </style>

    <style name="Widget.Velocity.Flat.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="cornerRadius">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Velocity.Square</item>
    </style>

    <!-- Cards: 1dp hairline border instead of a shadow -->
    <style name="Widget.Velocity.Card.Flat" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardBackgroundColor">@color/velocity_surface_elevated</item>
        <item name="strokeColor">@color/velocity_divider_hairline</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Velocity.Card</item>
    </style>

    <!-- A card inside a bordered container: a subtle off-surface fill, a thin hairline, no shadow. -->
    <style name="Widget.Velocity.Card.Flat.Inset" parent="Widget.Velocity.Card.Flat">
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/velocity_card_inset</item>
    </style>

    <!-- Choice chips -->
    <style name="Widget.Velocity.Flat.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="shapeAppearance">@style/ShapeAppearance.Velocity.Square</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Velocity.Square</item>
        <item name="chipCornerRadius">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="chipMinHeight">48dp</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Text fields: label above (outside) the field, square outline -->
    <style name="Widget.Velocity.TextInputLayout.OutlinedBox.Square" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">0dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusTopEnd">0dp</item>
        <item name="boxCornerRadiusTopStart">0dp</item>
        <item name="boxStrokeColor">@color/velocity_red_primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="startIconTint">@color/velocity_red_primary</item>
        <item name="endIconTint">@color/velocity_red_primary</item>
        <item name="hintEnabled">false</item>
    </style>

    <style name="Widget.Velocity.TextInputLayout.ExposedDropdown.Square" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusBottomEnd">0dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusTopEnd">0dp</item>
        <item name="boxCornerRadiusTopStart">0dp</item>
        <item name="boxStrokeColor">@color/velocity_red_primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="endIconTint">@color/velocity_red_primary</item>
        <item name="hintTextColor">@color/velocity_red_primary</item>
        <item name="android:textColorHint">@color/velocity_text_secondary</item>
    </style>

    <!-- Dialogs: square, no window shadow -->
    <style name="ThemeOverlay.Velocity.Flat.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:windowElevation">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Velocity.Square</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Velocity.Square</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Velocity.Square</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Velocity.Square</item>
        <item name="materialButtonStyle">@style/Widget.Velocity.Flat.Button.Text</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Velocity.Flat.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.Velocity.Flat.Button.Text</item>
        <item name="materialCardViewStyle">@style/Widget.Velocity.Card.Flat</item>
        <item name="chipStyle">@style/Widget.Velocity.Flat.Chip</item>
        <item name="textInputStyle">@style/Widget.Velocity.TextInputLayout.OutlinedBox.Square</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Velocity.Flat.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Velocity.Flat.Button.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Velocity.Flat.Button.Text</item>
    </style>

    <!-- Bottom sheets: square, no shadow, a hairline top border -->
    <style name="Widget.Velocity.Flat.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Velocity.Square</item>
        <item name="android:elevation">0dp</item>
        <item name="backgroundTint">@color/velocity_surface_elevated</item>
    </style>

    <style name="ThemeOverlay.Velocity.Flat.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Velocity.Flat.BottomSheet</item>
        <item name="android:windowElevation">0dp</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Velocity.Square</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Velocity.Square</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Velocity.Square</item>
        <item name="materialButtonStyle">@style/Widget.Velocity.Flat.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Velocity.Flat.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.Velocity.Flat.Button.Text</item>
        <item name="materialCardViewStyle">@style/Widget.Velocity.Card.Flat</item>
        <item name="chipStyle">@style/Widget.Velocity.Flat.Chip</item>
        <item name="textInputStyle">@style/Widget.Velocity.TextInputLayout.OutlinedBox.Square</item>
    </style>

    <!-- Snackbars: square, no shadow, hairline border -->
    <style name="Widget.Velocity.Flat.Snackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="android:background">@drawable/bg_snackbar_flat</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Kept as a named alias: the flat look now lives in the base Theme.VelocitySuites. -->
    <style name="Theme.VelocitySuites.Flat" parent="Theme.VelocitySuites" />

    <!-- A Transaction History filter field: outlined, flat, a floating label that stays visible, one border colour for all. -->
    <style name="Widget.Velocity.TextInputLayout.Filter.Dropdown" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusBottomEnd">0dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusTopEnd">0dp</item>
        <item name="boxCornerRadiusTopStart">0dp</item>
        <item name="boxStrokeColor">@color/filter_box_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/filter_hint_color</item>
        <item name="android:textColorHint">@color/velocity_text_secondary</item>
        <item name="endIconTint">@color/velocity_text_secondary</item>
        <item name="hintEnabled">true</item>
        <item name="hintAnimationEnabled">true</item>
    </style>

    <style name="Widget.Velocity.TextInputLayout.Filter.Date" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">0dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusTopEnd">0dp</item>
        <item name="boxCornerRadiusTopStart">0dp</item>
        <item name="boxStrokeColor">@color/filter_box_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/filter_hint_color</item>
        <item name="android:textColorHint">@color/velocity_text_secondary</item>
        <item name="startIconTint">@color/velocity_text_secondary</item>
        <item name="endIconTint">@color/velocity_text_secondary</item>
        <item name="hintEnabled">true</item>
        <item name="hintAnimationEnabled">true</item>
    </style>

    <!-- A search field next to the filter fields: outlined and square, the same quiet gray border (red only while focused). The
         placeholder is the EditText's own hint (the theme turns floating labels off). -->
    <style name="Widget.Velocity.TextInputLayout.Filter.Search" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">0dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusTopEnd">0dp</item>
        <item name="boxCornerRadiusTopStart">0dp</item>
        <item name="boxStrokeColor">@color/filter_box_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="startIconTint">@color/velocity_text_secondary</item>
        <item name="endIconTint">@color/velocity_text_secondary</item>
        <item name="hintEnabled">false</item>
    </style>

    <!-- "Show all (4)" / "Show less" under a Dashboard list, and the Pay Now button: compact, wrap-content, 40dp to look at and
         48dp to touch (the 4dp insets are inside the touch target), normal-case text with no letter-spacing. -->
    <style name="Widget.Velocity.Flat.Button.Compact" parent="Widget.Velocity.Flat.Button.Outlined">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- The compact primary action (Pay Now): filled, about 40dp tall visually, normal-case text, no outline. -->
    <style name="Widget.Velocity.Flat.Button.Compact.Filled" parent="Widget.Velocity.Flat.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="android:textColor">@color/button_primary_text</item>
    </style>

    <!-- Sort and Filters in the results bar: compact (about 36dp to look at, 48dp to touch) with a light hairline instead of a heavy box. -->
    <style name="Widget.Velocity.Flat.Button.Compact.Subtle" parent="Widget.Velocity.Flat.Button.Compact">
        <item name="android:insetTop">6dp</item>
        <item name="android:insetBottom">6dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/velocity_text_primary</item>
        <item name="strokeColor">@color/velocity_divider_hairline</item>
    </style>

    <!-- THE button / tab / segmented-button text: sentence case, no letter-spacing. The Material default (ALL CAPS, 0.09 letter-spacing)
         reaches every Button, MaterialButton, toggle-group segment and Tab through ?attr/textAppearanceButton, so it is replaced here
         once, in the theme (both Theme.VelocitySuites variants set textAppearanceButton and tabStyle). -->
    <style name="TextAppearance.Velocity.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.Velocity.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabTextAppearance">@style/TextAppearance.Velocity.Button</item>
        <item name="tabIndicatorColor">@color/velocity_red_primary</item>
    </style>

    <style name="TextAppearance.Velocity.Overline" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- The Material text appearances with the letter-spacing taken out (the theme points textAppearance* at these). -->
    <style name="TextAppearance.Velocity.Base.Headline1" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Velocity.Base.Headline2" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Velocity.Base.Headline3" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Velocity.Base.Headline4" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Velocity.Base.Headline5" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Velocity.Base.Headline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Velocity.Base.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Velocity.Base.Subtitle2" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Velocity.Base.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Velocity.Base.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Velocity.Base.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- THE dashboard section container (Your Next Stay, Quick Actions, Stay Calendar, Other Recent & Upcoming Stays, Pending & Confirmed
         Stays, the summary, Recent Bookings, Notifications, Payment Status, Account Summary): one border, radius and elevation. -->
    <style name="Widget.Velocity.Card.Section" parent="Widget.Velocity.Card.Glass.Compact">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/velocity_red_subtle</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
