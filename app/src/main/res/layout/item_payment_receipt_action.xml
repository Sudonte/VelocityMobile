<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivReceiptStatusIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvReceiptStatusTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:textSize="13sp"
                tools:text="✓ Payment Verified" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvReceiptStatusDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="12sp"
            tools:text="Your official payment receipt is ready." />

        <LinearLayout
            android:id="@+id/layoutReceiptButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewReceipt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:minHeight="48dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:text="@string/view_receipt_button_label"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:backgroundTint="@color/velocity_red_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloadReceipt"
                style="@style/Widget.Velocity.Flat.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:text="@string/download_receipt_button_label"
                android:textAllCaps="false"
                android:textColor="@color/velocity_red_primary"
                android:textSize="14sp"
                app:strokeColor="@color/velocity_red_primary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
