<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/velocity_surface_elevated"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardBackgroundColor="@color/velocity_red_soft"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lock"
                app:tint="@color/velocity_red_primary" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/termsDialogTitle"
            style="@style/TextAppearance.Velocity.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/terms_dialog_title"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/termsCloseButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/terms_dialog_close_desc"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="@color/velocity_text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/shape_intro_pill"
        android:backgroundTint="@color/velocity_red_primary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/velocity_red_soft" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/termsScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/termsBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/velocity_text_primary"
            android:textSize="14sp" />
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/velocity_red_soft" />

    <!-- Pinned so it is always reachable, however long the text or large the font. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/termsDoneButton"
        style="@style/Widget.Velocity.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:minHeight="52dp"
        android:text="@string/terms_done" />

</LinearLayout>
