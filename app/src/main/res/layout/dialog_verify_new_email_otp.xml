<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Velocity.Card.Glass"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card_white"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardBackgroundColor="@color/velocity_orange_soft"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_email"
                    app:tint="@color/velocity_orange_primary" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.Velocity.ScreenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/verify_new_email_title"
                android:textSize="20sp" />
        </LinearLayout>

        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/shape_intro_pill"
            android:backgroundTint="@color/velocity_orange_primary" />

        <TextView
            android:id="@+id/verifyNewEmailDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="14sp"
            tools:text="Enter the 6-digit OTP sent to new@example.com" />

        <TextView
            style="@style/TextAppearance.Velocity.Label.Input"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:labelFor="@+id/verifyNewEmailOtp"
            android:text="@string/otp_hint"
            android:textColor="@color/velocity_text_primary" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/verifyNewEmailOtpLayout"
            style="@style/Widget.Velocity.TextInputLayout.OutlinedBox.Rounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            app:startIconDrawable="@drawable/ic_lock">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/verifyNewEmailOtp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="6" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/resendVerifyNewEmailOtpLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="2dp"
            android:text="@string/resend_otp"
            android:textColor="@color/velocity_orange_primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@color/velocity_orange_soft" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelVerifyNewEmailOtp"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/cancel_label"
                android:textColor="@color/velocity_text_secondary"
                android:textAllCaps="false"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmVerifyNewEmailOtp"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:paddingHorizontal="20dp"
                android:text="@string/verify_email_button"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/white"
                app:backgroundTint="@color/velocity_orange_primary"
                app:cornerRadius="24dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
