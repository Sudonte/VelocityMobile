<?xml version="1.0" encoding="utf-8"?>
<!-- Dates and rooms in one step: "Your stays" (from the second stay on), then the editor of the stay being edited. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/staysScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/staysContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Every stay so far: its dates and nights, rooms and price, the same Edit / Remove for each, and the total of all of them. -->
        <LinearLayout
            android:id="@+id/layoutStaysSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_glass_card_white"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="visible"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvStaysTitle"
                style="@style/TextAppearance.Velocity.Label.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stays_title"
                android:textColor="@color/velocity_text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvStaysEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/stays_empty_desc"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutStayRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <View
                android:id="@+id/viewStaysTotalRule"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="@color/velocity_divider_hairline" />

            <LinearLayout
                android:id="@+id/layoutStaysTotalRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/stays_total_label"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvStaysTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="end"
                    android:textColor="@color/velocity_action_text"
                    android:textSize="15sp"
                    tools:text="₱18,600.00" />
            </LinearLayout>
        </LinearLayout>

        <!-- The date step: first on the page while the guest is still choosing (before the rooms card), under the Your dates and rooms card from a second range on. -->
        <LinearLayout
            android:id="@+id/layoutStayDates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- "Choose your dates" + one line saying why: which stay is being edited, and what to do. -->
        <TextView
            android:id="@+id/tvActiveStayHeading"
            style="@style/TextAppearance.Velocity.Label.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="18dp"
            android:textColor="@color/velocity_text_primary"
            android:textSize="15sp"
            tools:text="Choose your dates" />

        <TextView
            android:id="@+id/tvChooseDatesHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="2dp"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Pick check-in and check-out for the rooms you selected"
            tools:visibility="visible" />

        <FrameLayout
            android:id="@+id/stayDatesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Two stays with the very same check-in and check-out: the guest adds rooms to that stay instead. -->
        <TextView
            android:id="@+id/tvStayDuplicate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/velocity_action_text"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="You already added a stay for Oct 25 – Oct 26. Pick different dates or add rooms to that stay."
            tools:visibility="visible" />

        <!-- The picked rooms were lowered because fewer are free for these dates. -->
        <TextView
            android:id="@+id/tvRoomsLowered"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/velocity_action_text"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Only 1 of Deluxe Room is free for these dates, so your selection was lowered from 2 to 1." />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutStayEditor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <FrameLayout
            android:id="@+id/stayRoomsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvStayIncomplete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/velocity_action_text"
            android:textSize="13sp"
            android:visibility="gone" />


        <!-- Only with at least one room: the stay is final once the guest confirms it (and then collapses into "Your stays"). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmStay"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:text="@string/confirm_this_stay"
            android:textSize="13sp"
            android:visibility="gone"
            app:backgroundTint="@color/velocity_red_primary"
            tools:visibility="visible" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddAnotherStay"
            style="@style/Widget.Velocity.Flat.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:text="@string/add_another_stay"
            android:visibility="gone"
            tools:visibility="visible"
            android:textColor="@color/velocity_text_primary"
            android:textSize="12sp"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/velocity_red_primary" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
