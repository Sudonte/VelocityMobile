<?xml version="1.0" encoding="utf-8"?>
<!-- Steps 1 and 2 in one: the stays summary (when there is more than one), then the dates and rooms of the stay being edited. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Every stay so far (dates, nights, rooms, price) with edit and remove; shown from the second stay on. -->
        <LinearLayout
            android:id="@+id/layoutStaysSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="22dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_glass_card_white"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/TextAppearance.Velocity.Label.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stays_title"
                android:textColor="@color/velocity_text_primary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/layoutStayRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvStaysGroupTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/velocity_action_text"
                android:textSize="15sp"
                tools:text="Group total: ₱17,500.00" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvActiveStayHeading"
            style="@style/TextAppearance.Velocity.Label.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="22dp"
            android:layout_marginTop="18dp"
            android:textColor="@color/velocity_red_primary"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Stay 2 of 2"
            tools:visibility="visible" />

        <FrameLayout
            android:id="@+id/stayDatesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:id="@+id/stayRoomsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvStayIncomplete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="22dp"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/velocity_red_primary"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddAnotherStay"
            style="@style/Widget.Velocity.Flat.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="22dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="22dp"
            android:text="@string/add_another_stay"
            android:textColor="@color/velocity_text_primary"
            android:textSize="12sp"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/velocity_red_primary" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
