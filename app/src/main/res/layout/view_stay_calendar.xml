<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard "Stay Calendar": a month grid with a dot on every day that has a check-in or check-out, Daily / Weekly /
     Monthly filters, and a short summary of the transactions in the chosen window. Built by DashboardStayCalendar. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stayCalendarCard"
    style="@style/Widget.Velocity.Card.Flat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.Velocity.Label.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/stay_calendar_title" />

            <ImageButton
                android:id="@+id/stayCalToggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="-10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/section_collapse"
                android:src="@drawable/ic_expand_less"
                app:tint="@color/velocity_text_secondary" />
        </LinearLayout>

        <!-- Shown instead of the body while the section is collapsed. -->
        <TextView
            android:id="@+id/stayCalCollapsedSummary"
            style="@style/TextAppearance.Velocity.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/velocity_text_primary"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/stayCalBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            style="@style/TextAppearance.Velocity.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/stay_calendar_desc" />

        <!-- Segmented Daily / Weekly / Monthly control: always one selected. -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/stayCalMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stayCalModeDaily"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/stay_calendar_daily"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stayCalModeWeekly"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/stay_calendar_weekly"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stayCalModeMonthly"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/stay_calendar_monthly"
                android:textSize="13sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/stayCalPrev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/stay_calendar_prev_month"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/velocity_text_primary" />

            <TextView
                android:id="@+id/stayCalMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:textColor="@color/velocity_text_primary"
                android:textSize="15sp"
                tools:text="October 2026" />

            <ImageButton
                android:id="@+id/stayCalNext"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/stay_calendar_next_month"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/velocity_text_primary" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/stayCalGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="7" />

        <!-- The chosen window and its transactions; a host screen that lists them itself hides this group. -->
        <LinearLayout
            android:id="@+id/stayCalSummaryGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:alpha="0.12"
            android:background="@color/velocity_text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/stayCalRange"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/velocity_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/stayCalCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/shape_intro_pill"
                android:backgroundTint="@color/velocity_red_soft"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="@color/velocity_red_primary"
                android:textSize="12sp"
                tools:text="3 transactions" />
        </LinearLayout>

        <!-- Cancelled and rejected transactions stay out of the list unless the guest asks for them. -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/stayCalShowCancelled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/stay_calendar_show_cancelled"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/stayCalSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/stayCalEmpty"
            style="@style/TextAppearance.Velocity.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:paddingVertical="14dp"
            android:text="@string/stay_calendar_empty"
            android:visibility="gone" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
