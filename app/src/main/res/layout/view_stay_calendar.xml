<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard "Stay Calendar": a month grid with a dot on every day that has a check-in or check-out, Daily / Weekly /
     Monthly filters, and a short summary of the transactions in the chosen window. Built by DashboardStayCalendar. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stayCalendarCard"
    style="@style/Widget.Velocity.Card.Flat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            style="@style/TextAppearance.Velocity.Label.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/stay_calendar_title" />

        <TextView
            style="@style/TextAppearance.Velocity.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/stay_calendar_desc" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/stayCalMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/stayCalModeDaily"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/stay_calendar_daily" />

            <com.google.android.material.chip.Chip
                android:id="@+id/stayCalModeWeekly"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stay_calendar_weekly" />

            <com.google.android.material.chip.Chip
                android:id="@+id/stayCalModeMonthly"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stay_calendar_monthly" />
        </com.google.android.material.chip.ChipGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/stayCalPrev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/stay_calendar_prev_month"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/velocity_text_primary" />

            <TextView
                android:id="@+id/stayCalMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:textColor="@color/velocity_text_primary"
                android:textSize="15sp"
                tools:text="October 2026" />

            <ImageButton
                android:id="@+id/stayCalNext"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/stay_calendar_next_month"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/velocity_text_primary" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/stayCalGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="7" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:alpha="0.12"
            android:background="@color/velocity_text_primary" />

        <TextView
            android:id="@+id/stayCalRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/velocity_text_primary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/stayCalSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/stayCalEmpty"
            style="@style/TextAppearance.Velocity.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/stay_calendar_empty"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stayCalOpenAll"
            style="@style/Widget.Velocity.Flat.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="48dp"
            android:text="@string/stay_calendar_open_all" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
