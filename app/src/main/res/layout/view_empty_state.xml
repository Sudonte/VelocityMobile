<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="36dp"
    android:paddingVertical="54dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/emptyIconContainer"
        android:layout_width="160dp"
        android:layout_height="160dp"
        app:cardBackgroundColor="@color/velocity_surface_elevated"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="@dimen/card_elevation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/velocity_red_subtle"
        app:strokeWidth="2dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.15"
                android:background="@drawable/shape_intro_red_glow" />

            <ImageView
                android:id="@+id/emptyIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:alpha="0.6"
                android:contentDescription="@null"
                android:src="@drawable/ic_notifications"
                app:tint="@color/velocity_red_primary" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/emptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="29dp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/velocity_red_text"
        android:textSize="22sp"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emptyIconContainer"
        tools:text="No Notifications" />

    <TextView
        android:id="@+id/emptyDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:alpha="0.7"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:textColor="@color/velocity_text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emptyTitle"
        tools:text="You're all caught up! Check back later for new alerts." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEmptyAction"
        style="@style/Widget.MaterialComponents.Button.Icon"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginTop="36dp"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0"
        android:paddingHorizontal="29dp"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:visibility="gone"
        app:backgroundTint="@color/velocity_red_primary"
        app:cornerRadius="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emptyDesc"
        tools:icon="@drawable/ic_clock"
        tools:text="Refresh"
        tools:visibility="visible" />

    <!-- An optional second, quieter action ("Change dates" next to "Clear filters"). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEmptyAction2"
        style="@style/Widget.Velocity.Flat.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0"
        android:minHeight="48dp"
        android:textAllCaps="false"
        android:textColor="@color/velocity_action_text"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnEmptyAction"
        tools:text="Change dates" />

</androidx.constraintlayout.widget.ConstraintLayout>
