<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/velocity_card_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="8dp"
    app:strokeColor="@color/velocity_red_subtle"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="2dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/tvNotifPopupTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/title_notifications"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvNotifPopupUnread"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/velocity_red_primary"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="3 unread"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Hidden when nothing is unread. -->
            <TextView
                android:id="@+id/btnNotifPopupMarkAll"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingHorizontal="8dp"
                android:text="@string/mark_all_read_label"
                android:textColor="@color/velocity_red_primary"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageButton
                android:id="@+id/btnNotifPopupClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/notif_popup_close"
                android:src="@drawable/ic_close"
                app:tint="@color/velocity_text_secondary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/velocity_red_subtle" />

        <LinearLayout
            android:id="@+id/layoutNotifPopupRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvNotifPopupEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:paddingVertical="24dp"
            android:text="@string/notif_popup_empty"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            app:drawableTint="@color/velocity_inactive_gray"
            app:drawableTopCompat="@drawable/ic_notifications" />

        <ProgressBar
            android:id="@+id/progressNotifPopup"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="18dp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/velocity_red_subtle" />

        <TextView
            android:id="@+id/btnNotifPopupViewAll"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="@string/notif_popup_view_all"
            android:textColor="@color/velocity_red_primary"
            android:textSize="13sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
