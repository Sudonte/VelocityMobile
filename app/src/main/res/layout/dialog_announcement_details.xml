<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Velocity.Card.Glass"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card_white"
        android:padding="24dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/iconContainer"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:cardBackgroundColor="@color/velocity_blue_soft"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_info"
                app:tint="@color/velocity_blue_primary" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnnouncementClose"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:backgroundTint="@color/velocity_red_soft"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_close"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/velocity_red_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:rippleColor="@color/white" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/announcementDetailImageContainer"
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iconContainer"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/ivAnnouncementDetailImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                tools:src="@drawable/bg_landing_banner_wellness" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvAnnouncementDetailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/velocity_red_dark"
            android:textSize="22sp"
            android:letterSpacing="-0.02"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/announcementDetailImageContainer"
            tools:text="Grand Reopening Celebration" />

        <TextView
            android:id="@+id/tvAnnouncementDetailDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/velocity_inactive_gray"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAnnouncementDetailTitle"
            tools:text="Published Aug 14, 2026" />

        <View
            android:id="@+id/divider"
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/shape_intro_pill"
            android:backgroundTint="@color/velocity_red_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAnnouncementDetailDate" />

        <TextView
            android:id="@+id/tvAnnouncementDetailMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.4"
            android:textColor="@color/velocity_text_primary"
            android:textSize="15sp"
            android:alpha="0.9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider"
            tools:text="We're excited to announce our newly renovated lobby and guest lounge, now open for every guest to enjoy during their stay!" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnnouncementDismiss"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-bold"
            android:text="@string/close_label"
            android:textAllCaps="false"
            android:textColor="@color/velocity_inactive_gray"
            app:layout_constraintTop_toBottomOf="@+id/tvAnnouncementDetailMessage" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
