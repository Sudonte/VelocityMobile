<?xml version="1.0" encoding="utf-8"?>
<!-- One read-only amenity tag on a room card: a plain TextView with a drawable, not a Material Chip - a Chip builds
     several drawables per instance, which is what made fast scrolling stutter. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_amenity_tag"
    android:drawablePadding="4dp"
    android:gravity="center_vertical"
    android:includeFontPadding="false"
    android:minHeight="26dp"
    android:paddingHorizontal="8dp"
    android:paddingVertical="3dp"
    android:textColor="@color/velocity_text_secondary"
    android:textSize="12sp" />
