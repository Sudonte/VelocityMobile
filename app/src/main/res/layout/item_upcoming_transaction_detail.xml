<?xml version="1.0" encoding="utf-8"?>
<!-- One transaction in Upcoming Hotel Transactions, easy to scan top to bottom:
     1) type + reference, with the status badge on the right
     2) the room
     3) what happens next and when (check-in / check-out), in a tinted panel
     4) the stay dates and guests
     5) balance and payment status, then a button to the details.
     Tapping anywhere on the card opens the transaction details sheet. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardUpcomingTransaction"
    style="@style/Widget.Velocity.Card.Flat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/tvTomorrowBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/shape_intro_pill"
            android:backgroundTint="@color/velocity_red_primary"
            android:fontFamily="sans-serif-black"
            android:paddingHorizontal="11dp"
            android:paddingVertical="5dp"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Check-in Tomorrow"
            tools:visibility="visible" />

        <!-- 1) The full ID (wraps, never cut off) and the status chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTransactionBookingId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/velocity_text_primary"
                android:textSize="16sp"
                tools:text="Booking #338" />

            <TextView
                android:id="@+id/tvTransactionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_success"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:textColor="@color/velocity_green_dark"
                android:textSize="12sp"
                tools:text="Confirmed" />
        </LinearLayout>

        <!-- 2) Type chip -->
        <TextView
            android:id="@+id/tvTransactionType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/shape_intro_pill"
            android:backgroundTint="@color/status_cancelled_bg"
            android:fontFamily="sans-serif-black"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textAllCaps="false"
            android:textColor="@color/status_cancelled_fg"
            android:textSize="11sp"
            tools:text="Booking" />

        <!-- 3) Room -->
        <TextView
            android:id="@+id/tvTransactionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:drawablePadding="8dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:textColor="@color/velocity_text_primary"
            android:textSize="14sp"
            app:drawableStartCompat="@drawable/ic_bed"
            app:drawableTint="@color/velocity_text_secondary"
            tools:text="Deluxe Room x2" />

        <!-- 3) What happens next, and when -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_flat_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/shape_intro_pill"
                android:backgroundTint="@color/velocity_red_soft"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_clock"
                app:tint="@color/velocity_red_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEventKind"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0"
                    android:textAllCaps="false"
                    android:textColor="@color/velocity_text_secondary"
                    android:textSize="11sp"
                    tools:text="Check-in" />

                <TextView
                    android:id="@+id/tvEventWhen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="14sp"
                    tools:text="Oct 18, 2026 at 02:00:00 PM" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4) Stay dates and guests -->
        <TextView
            android:id="@+id/tvTransactionStay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="12sp"
            app:drawableStartCompat="@drawable/ic_calendar"
            app:drawableTint="@color/velocity_text_secondary"
            tools:text="Oct 18 → Oct 20, 2026" />

        <TextView
            android:id="@+id/tvTransactionMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="2dp"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="12sp"
            tools:text="2 nights · 2 guests" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/velocity_divider_hairline" />

        <!-- 5) Balance and payment status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/upcoming_balance_label"
                    android:textColor="@color/velocity_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvTransactionBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="17sp"
                    tools:text="₱3,000.00" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTransactionPaymentStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_intro_pill"
                android:backgroundTint="@color/velocity_green_soft"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/velocity_green_dark"
                android:textSize="12sp"
                tools:text="Fully Paid" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewFullDetails"
            style="@style/Widget.Velocity.Flat.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/upcoming_view_details" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
