<?xml version="1.0" encoding="utf-8"?>
<!-- One Booking / Reservation in the Booking & Reservation list (the same card for both tabs):
       Row 1  "Booking #569" (bold, never cut off) ........ status chip  >
       Row 2  room type(s)             Row 3  "Oct 21 → Oct 22, 2026 · 1 night · 2 guests"
       (divider)
       Row 4  Total ........ ₱7,860.00 (bold, right)
       Row 5  "Paid ₱7,560.00 · Balance ₱300.00" (balance coloured) and a small payment-method chip
       Row 6  (only when a balance is paid at the hotel) one small secondary line
       Actions on one compact row; only ONE filled (primary) button per card. The whole card opens the details. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Velocity.Card.Flat.Inset"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="@color/velocity_red_subtle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvModifiedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/shape_flat_badge"
                android:backgroundTint="@color/status_cancelled_bg"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="@string/status_modified"
                android:textColor="@color/status_cancelled_fg"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvBookingId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/velocity_text_primary"
                android:textSize="16sp"
                tools:text="Booking #569" />

            <TextView
                android:id="@+id/tvBookingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/shape_intro_pill"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textSize="12sp"
                tools:text="Checked in" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:alpha="0.4"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/velocity_text_secondary" />
        </LinearLayout>

        <!-- Row 2: hidden (never an empty gap) when no room type is known. -->
        <TextView
            android:id="@+id/tvBookingRoomName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/velocity_text_primary"
            android:textSize="13sp"
            tools:text="Deluxe, Executive" />

        <!-- Row 3 -->
        <TextView
            android:id="@+id/tvBookingDates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="12sp"
            tools:text="Oct 21 → Oct 22, 2026 · 1 night · 2 guests" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/velocity_divider_hairline" />

        <!-- Row 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/booking_card_total_label"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvBookingPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:gravity="end"
                android:textColor="@color/velocity_text_primary"
                android:textSize="15sp"
                tools:text="₱7,860.00" />
        </LinearLayout>

        <!-- Row 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBookingPaidLine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="12sp"
                tools:text="Paid ₱7,560.00 · Balance ₱300.00" />

            <TextView
                android:id="@+id/tvBookingPaymentMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/shape_intro_pill"
                android:backgroundTint="@color/status_cancelled_bg"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/status_cancelled_fg"
                android:textSize="12sp"
                tools:text="GCash" />
        </LinearLayout>

        <!-- Row 6: replaces the old pink box. -->
        <TextView
            android:id="@+id/tvFrontDeskNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Pay the balance at the front desk"
            tools:visibility="visible" />

        <!-- ONE aligned action row (CardActionRow): buttons on the left, text actions on the right; the text actions wrap to a
             second row, right-aligned, when they do not fit. Only one filled button (Pay now) per card. -->
        <com.example.velocitysuites.CardActionRow
            android:id="@+id/layoutActionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/layoutActionsLeft"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPayNow"
                    style="@style/Widget.Velocity.Flat.Button.Compact.Filled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:ellipsize="none"
                    android:maxLines="1"
                    android:text="@string/pay_now"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBookAgain"
                    style="@style/Widget.Velocity.Flat.Button.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:ellipsize="none"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:text="@string/book_again_button"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewBooking"
                    style="@style/Widget.Velocity.Flat.Button.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="none"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:text="@string/view_booking_format"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewDetails"
                    style="@style/Widget.Velocity.Flat.Button.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="none"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:text="@string/view_details" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewDetailsText"
                    style="@style/Widget.Velocity.Flat.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="none"
                    android:insetTop="4dp"
                    android:insetBottom="4dp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/view_details"
                    android:textColor="@color/velocity_action_text"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutActionsRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModify"
                    style="@style/Widget.Velocity.Flat.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="none"
                    android:insetTop="4dp"
                    android:insetBottom="4dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/booking_card_edit"
                    android:textColor="@color/velocity_action_text"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvActionDot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/action_dot_separator"
                    android:textColor="@color/velocity_text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    style="@style/Widget.Velocity.Flat.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="none"
                    android:insetTop="4dp"
                    android:insetBottom="4dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/cancel_label"
                    android:textColor="?attr/colorError"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    style="@style/Widget.Velocity.Flat.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="none"
                    android:insetTop="4dp"
                    android:insetBottom="4dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/delete_permanently_button_label"
                    android:textColor="?attr/colorError"
                    android:textSize="13sp"
                    android:visibility="gone"
                    app:icon="@drawable/ic_delete"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="16dp"
                    app:iconTint="?attr/colorError" />
            </LinearLayout>
        </com.example.velocitysuites.CardActionRow>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
