<?xml version="1.0" encoding="utf-8"?>
<!-- One amenity for one room: bold name, description, price, and the quantity stepper. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_flat_box"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivAmenityRowIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            app:tint="@color/velocity_red_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAmenityRowName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/velocity_text_primary"
                android:textSize="13sp"
                tools:text="Extra bed" />

            <TextView
                android:id="@+id/tvAmenityRowDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="12sp"
                tools:text="A rollaway bed with fresh linens." />

            <TextView
                android:id="@+id/tvAmenityRowPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/velocity_text_primary"
                android:textSize="12sp"
                tools:text="₱300.00 each" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAmenityRowMinus"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/cd_decrease_quantity"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/velocity_card_surface"
                app:icon="@drawable/ic_remove"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="16dp"
                app:iconTint="@color/velocity_red_primary" />

            <TextView
                android:id="@+id/tvAmenityRowQty"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:textColor="@color/velocity_text_primary"
                android:textSize="14sp"
                tools:text="0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAmenityRowPlus"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/cd_increase_quantity"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/velocity_card_surface"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="16dp"
                app:iconTint="@color/velocity_red_primary" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvAmenityRowLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-bold"
        android:gravity="end"
        android:textColor="@color/velocity_red_primary"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="2 × ₱300.00 = ₱600.00"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvAmenityRowLimit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/velocity_action_text"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
