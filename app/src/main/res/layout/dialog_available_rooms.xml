<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Velocity.Card.Glass"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/room_card_corner_radius">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card_white"
        android:orientation="vertical"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingTop="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/available_rooms_title"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvAvailableRoomsSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/velocity_text_secondary"
                    android:textSize="12sp"
                    tools:text="Aug 4, 2026 – Aug 5, 2026 · 1 night" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseAvailableRooms"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/cd_close_dialog"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/velocity_red_subtle"
                app:cornerRadius="17dp"
                app:icon="@drawable/ic_close"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="17dp"
                app:iconTint="@color/velocity_red_primary" />
        </LinearLayout>

        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/shape_intro_pill"
            android:backgroundTint="@color/velocity_red_soft" />

        <!-- 0dp height + weight="1" (NOT wrap_content + android:maxHeight) - NestedScrollView
             never honors android:maxHeight (only a few widgets like ImageView enforce that
             attribute; ScrollView/NestedScrollView silently ignore it), so with an unbounded
             wrap_content height this would grow to fit every room card and push the footer
             below the dialog window's actual clipped bounds. Weight-based sizing genuinely
             caps this region to whatever space is left after the header/footer are laid out
             within the window's own bounded height (see showAvailableRoomsDialog()'s explicit
             dialog.getWindow().setLayout(...) call, which gives this LinearLayout chain a real
             EXACTLY/AT_MOST height to distribute instead of an effectively infinite one) -
             the footer stays pinned below this, always on-screen, regardless of room count. -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/layoutAvailableRoomsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingBottom="6dp" />
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/layoutAvailableRoomsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="32dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:alpha="0.5"
                android:contentDescription="@null"
                android:src="@drawable/ic_bed"
                app:tint="@color/velocity_text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/no_available_rooms_desc"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Bottom action area: stays outside the scrollable area so it's always
             visible while reviewing selected rooms. Deliberately compact - the full
             per-room-type breakdown lives in dialog_selected_rooms_summary.xml
             (opened via "View Selection Details" below), not here, so the room
             list above (NestedScrollView, layout_weight="1") gets the large
             majority of the dialog's height instead of competing with a tall
             summary block. This entire container - divider, View Selection
             Details, Room Total, and the commit button (Book Now on the New
             Booking tab, Reserve Now on New Reservation - text set in the
             Activity) - is only shown once at least one room is staged above
             (see updateFooter() in Step1RoomSelectionFragment#showAvailableRoomsDialog());
             no reserved empty space while the selection is empty. -->
        <LinearLayout
            android:id="@+id/layoutSelectionFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@color/velocity_red_subtle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:paddingHorizontal="18dp">

                <!-- Opens dialog_selected_rooms_summary.xml with the full
                     per-room-type price breakdown (room-type count, quantity
                     per type, quantity × price/night × nights = subtotal for
                     each, and the grand total). -->
                <TextView
                    android:id="@+id/tvViewSelectionDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="@string/view_selection_details_label"
                    android:textColor="@color/velocity_red_primary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/room_total_label"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvSelectionTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="16sp"
                        tools:text="₱48,000.00" />
                </LinearLayout>

                <!-- Commit action - text set to Book Now/Reserve Now in the
                     Activity/Fragment depending on transaction mode. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBookOrReserveRoom"
                    style="@style/Widget.Velocity.Button"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:letterSpacing="0"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    app:cornerRadius="23dp"
                    app:icon="@drawable/ic_check_circle"
                    app:iconGravity="textStart"
                    tools:text="@string/book_now" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
