<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Velocity.Card.Glass"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/room_card_corner_radius">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card_white"
        android:orientation="vertical"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingTop="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/available_rooms_title"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvAvailableRoomsSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/velocity_text_secondary"
                    android:textSize="12sp"
                    tools:text="Aug 4, 2026 – Aug 5, 2026 · 1 night" />
            </LinearLayout>

            <!-- Top-right commit action: labeled "Book Now" on the New Booking tab
                 or "Reserve Now" on the New Reservation tab (set in the Activity),
                 enabled once at least one room is staged below. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBookOrReserveRoom"
                style="@style/Widget.Velocity.Button"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:enabled="false"
                android:letterSpacing="0"
                android:paddingHorizontal="14dp"
                android:textAllCaps="false"
                android:textSize="12sp"
                app:cornerRadius="17dp"
                tools:text="@string/book_now" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseAvailableRooms"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/cd_close_dialog"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/velocity_red_subtle"
                app:cornerRadius="17dp"
                app:icon="@drawable/ic_close"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="17dp"
                app:iconTint="@color/velocity_red_primary" />
        </LinearLayout>

        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/shape_intro_pill"
            android:backgroundTint="@color/velocity_red_soft" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:maxHeight="460dp"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/layoutAvailableRoomsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp" />
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/layoutAvailableRoomsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="32dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:alpha="0.5"
                android:contentDescription="@null"
                android:src="@drawable/ic_bed"
                app:tint="@color/velocity_text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/no_available_rooms_desc"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Footer: stays outside the scrollable area so it's always visible. The
             guest may stage multiple room types/quantities above; this count
             updates live as cards are toggled, mirroring the top-right
             Book Now/Reserve Now button that actually commits the selection. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/velocity_red_subtle" />

        <TextView
            android:id="@+id/tvStagedRoomsCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="18dp"
            android:gravity="center"
            android:text="@string/rooms_staged_count_none"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
