<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/velocity_red_bg_end"
    tools:context=".TransactionHistoryActivity">

    <!-- Main Content Area -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/screenContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:liftOnScroll="true"
            app:liftOnScrollTargetViewId="@id/rvTransactions">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                app:contentScrim="@drawable/bg_guest_header"
                app:layout_scrollFlags="scroll|exitUntilCollapsed"
                app:statusBarScrim="@android:color/transparent">

                <!-- Background Glow -->
                <View
                    android:layout_width="600dp"
                    android:layout_height="600dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="-450dp"
                    android:alpha="0.2"
                    android:background="@drawable/shape_intro_red_glow"
                    android:importantForAccessibility="no"
                    app:layout_collapseMode="parallax" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="83dp">

                    <TextView
                        android:id="@+id/screenTitle"
                        style="@style/TextAppearance.Velocity.ScreenTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="22dp"
                        android:textSize="15sp"
                        android:textColor="@color/velocity_red_primary"
                        android:text="@string/title_transaction_history" />

                    <View
                        android:layout_width="56dp"
                        android:layout_height="6dp"
                        android:layout_marginHorizontal="22dp"
                        android:layout_marginTop="11dp"
                        android:background="@drawable/shape_intro_pill"
                        android:backgroundTint="@color/velocity_red_primary"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/screenDescription"
                        style="@style/TextAppearance.Velocity.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="22dp"
                        android:layout_marginTop="11dp"
                        android:layout_marginBottom="18dp"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/transaction_history_desc"
                        android:textSize="12sp" />

                    <!-- Search, then the filter panel: dropdowns (Transaction, Booking status, Room type) and two date fields. -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Velocity.Card.Glass.Compact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="22dp"
                        android:layout_marginBottom="13dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_glass_card_white"
                            android:orientation="vertical"
                            android:padding="11dp">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/searchLayout"
                                style="@style/Widget.Velocity.TextInputLayout.OutlinedBox.Rounded"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:endIconMode="clear_text"
                                app:startIconDrawable="@drawable/ic_search">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etSearch"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:hint="@string/search_transactions_hint"
                                    android:imeOptions="actionSearch"
                                    android:inputType="text"
                                    android:maxLines="1"
                                    android:paddingVertical="8dp"
                                    android:textSize="13sp" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <TextView
                                android:id="@+id/btnToggleFilters"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:drawablePadding="6dp"
                                android:focusable="true"
                                android:fontFamily="sans-serif-bold"
                                android:gravity="center_vertical"
                                android:minHeight="48dp"
                                android:text="@string/filters_hide"
                                android:textColor="@color/velocity_action_text"
                                android:textSize="13sp"
                                app:drawableStartCompat="@drawable/ic_filter"
                                app:drawableTint="@color/velocity_action_text" />

                            <LinearLayout
                                android:id="@+id/layoutFilterPanel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:baselineAligned="false"
                                    android:orientation="horizontal">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/layoutTransactionFilter"
                                    style="@style/Widget.Velocity.TextInputLayout.ExposedDropdown"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="4dp"
                                    android:layout_weight="1"
                                    android:hint="@string/filter_label_transaction">

                                    <AutoCompleteTextView
                                        android:id="@+id/dropdownTransaction"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:includeFontPadding="false"
                                        android:inputType="none"
                                        android:maxLines="1"
                                        android:paddingVertical="8dp"
                                        android:textColor="@color/velocity_text_primary"
                                        android:textSize="13sp"
                                        tools:ignore="LabelFor" />
                                </com.google.android.material.textfield.TextInputLayout>
                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/layoutBookingStatusFilter"
                                    style="@style/Widget.Velocity.TextInputLayout.ExposedDropdown"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:layout_weight="1"
                                    android:hint="@string/filter_label_booking_status">

                                    <AutoCompleteTextView
                                        android:id="@+id/dropdownBookingStatus"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:includeFontPadding="false"
                                        android:inputType="none"
                                        android:maxLines="1"
                                        android:paddingVertical="8dp"
                                        android:textColor="@color/velocity_text_primary"
                                        android:textSize="13sp"
                                        tools:ignore="LabelFor" />
                                </com.google.android.material.textfield.TextInputLayout>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:baselineAligned="false"
                                    android:orientation="horizontal">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/layoutRoomTypeFilter"
                                    style="@style/Widget.Velocity.TextInputLayout.ExposedDropdown"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/filter_label_room_type">

                                    <AutoCompleteTextView
                                        android:id="@+id/dropdownRoomType"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:includeFontPadding="false"
                                        android:inputType="none"
                                        android:maxLines="1"
                                        android:paddingVertical="8dp"
                                        android:textColor="@color/velocity_text_primary"
                                        android:textSize="13sp"
                                        tools:ignore="LabelFor" />
                                </com.google.android.material.textfield.TextInputLayout>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:baselineAligned="false"
                                    android:orientation="horizontal">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/layoutCheckIn"
                                    style="@style/Widget.Velocity.TextInputLayout.OutlinedBox.Rounded"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="4dp"
                                    android:layout_weight="1"
                                    android:hint="@string/filter_label_check_in"
                                    app:endIconDrawable="@drawable/ic_close"
                                    app:endIconMode="custom"
                                    app:startIconDrawable="@drawable/ic_calendar">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etCheckIn"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:clickable="true"
                                        android:cursorVisible="false"
                                        android:focusable="false"
                                        android:fontFamily="sans-serif-medium"
                                        android:inputType="none"
                                        android:maxLines="1"
                                        android:paddingVertical="8dp"
                                        android:textSize="13sp" />
                                </com.google.android.material.textfield.TextInputLayout>
                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/layoutCheckOut"
                                    style="@style/Widget.Velocity.TextInputLayout.OutlinedBox.Rounded"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:layout_weight="1"
                                    android:hint="@string/filter_label_check_out"
                                    app:endIconDrawable="@drawable/ic_close"
                                    app:endIconMode="custom"
                                    app:startIconDrawable="@drawable/ic_calendar">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etCheckOut"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:clickable="true"
                                        android:cursorVisible="false"
                                        android:focusable="false"
                                        android:fontFamily="sans-serif-medium"
                                        android:inputType="none"
                                        android:maxLines="1"
                                        android:paddingVertical="8dp"
                                        android:textSize="13sp" />
                                </com.google.android.material.textfield.TextInputLayout>
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/btnClearFilters"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="end"
                                    android:background="?attr/selectableItemBackground"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:minHeight="48dp"
                                    android:paddingHorizontal="8dp"
                                    android:text="@string/txn_clear_filters_button"
                                    android:textColor="@color/velocity_action_text"
                                    android:textSize="13sp"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    app:contentInsetStart="0dp"
                    app:layout_collapseMode="pin">

                    <include
                        layout="@layout/guest_header"
                        android:layout_width="match_parent"
                        android:layout_height="72dp" />
                </androidx.appcompat.widget.Toolbar>

            </com.google.android.material.appbar.CollapsingToolbarLayout>

            <!-- Sticky Stats / Export Bar -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/velocity_sticky_bar_bg"
                    android:paddingHorizontal="22dp"
                    android:paddingVertical="11dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="@color/velocity_divider_hairline"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="11dp"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnExport"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/tvTransactionHeader"
                            style="@style/TextAppearance.Velocity.Section.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/transactions_title" />

                        <TextView
                            android:id="@+id/tvResultCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite"
                            android:textColor="@color/velocity_text_secondary"
                            android:textSize="12sp"
                            tools:text="12 results" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExport"
                        style="@style/Widget.Velocity.Flat.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:letterSpacing="0"
                        android:text="@string/export_label"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_upload"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </com.google.android.material.appbar.AppBarLayout>

        <!-- The list is the direct scrolling child: a RecyclerView that recycles its rows (it used to sit
             in a NestedScrollView at wrap_content height, which inflated EVERY row at once and meant it
             never scrolled by itself - so scroll-based paging could never fire). The collapsing header
             still collapses, through the standard nested-scroll chain. -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTransactions"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingTop="13dp"
                    android:paddingBottom="90dp"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_transaction_history_card" />

                <!-- Empty / load-error state (scrolls on its own so a short screen or a big font
                     can still reach its button). -->
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/scrollEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:overScrollMode="never"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <include
                        android:id="@+id/layoutEmptyState"
                        layout="@layout/view_empty_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </androidx.core.widget.NestedScrollView>

                <!-- First-load-only indicator: shown in place of (never alongside) the list and the
                     empty state, exactly once per screen open while nothing has loaded yet. -->
                <LinearLayout
                    android:id="@+id/layoutInitialLoading"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <ProgressBar
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:indeterminateTint="@color/velocity_red_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/loading_transactions_label"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        style="@style/Widget.VelocitySuites.NavigationView"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/velocity_surface_elevated"
        app:headerLayout="@layout/nav_header_guest"
        app:menu="@menu/menu_dashboard" />

</androidx.drawerlayout.widget.DrawerLayout>
