<?xml version="1.0" encoding="utf-8"?>
<!-- "Other Deluxe rooms >": opens the room type's other options (rooms with their own price or capacity). Sits right under the type's card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowOtherToggle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/shape_search_field"
    android:backgroundTint="@color/velocity_red_bg_end"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">

    <TextView
        android:id="@+id/tvOtherToggle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="sans-serif-bold"
        android:textColor="@color/velocity_text_primary"
        android:textSize="14sp"
        tools:text="Other Deluxe rooms" />

    <ImageView
        android:id="@+id/imgOtherChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/velocity_text_secondary"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>
