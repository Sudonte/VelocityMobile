<?xml version="1.0" encoding="utf-8"?>
<!-- One stay in the "Your stays" card: "Stay 1" + its dates and nights, its rooms and price, and the same Edit / Remove for every stay. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_stay_card"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingVertical="4dp"
        android:paddingStart="8dp"
        android:paddingEnd="0dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- "Stay 1" in bold, then "Oct 25 → Oct 26 · 1 night" in regular text (one TextView so it wraps as a sentence). -->
        <TextView
            android:id="@+id/tvStayRowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/velocity_text_primary"
            android:textSize="13sp"
            tools:text="Stay 1  Oct 25 → Oct 26 · 1 night" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStayRowRooms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="12sp"
                tools:text="2 rooms · ₱9,300.00" />

            <TextView
                android:id="@+id/tvStayRowEditing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_count_badge"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="8dp"
                android:paddingVertical="1dp"
                android:text="@string/stay_editing_badge"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStayRowEdit"
        style="@style/Widget.Velocity.Flat.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:minWidth="0dp"
        android:paddingHorizontal="10dp"
        android:text="@string/stay_edit"
        android:textColor="@color/velocity_text_primary"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStayRowRemove"
        style="@style/Widget.Velocity.Flat.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:minWidth="0dp"
        android:paddingHorizontal="10dp"
        android:text="@string/stay_remove"
        android:textColor="@color/velocity_action_text"
        android:textSize="12sp" />
    </LinearLayout>

    <!-- the rooms of this date range: type, count, price per night, and what each adds up to -->
    <LinearLayout
        android:id="@+id/layoutStayRowRooms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="8dp" />

    <LinearLayout
        android:id="@+id/layoutStayRowSubtotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/stay_subtotal_label"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvStayRowSubtotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/velocity_text_primary"
            android:textSize="13sp"
            tools:text="₱14,000.00" />
    </LinearLayout>
</LinearLayout>
