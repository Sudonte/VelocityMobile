<?xml version="1.0" encoding="utf-8"?>
<!-- The shared stay card (StayCardBinder): Dashboard Stay Calendar, Other Stays, Pending & Confirmed Stays.
       Row 1  the full ID (never cut off - it wraps instead) ........ status chip  >
       Row 2  type chip + Upcoming / Recent chip (their own line, so they can never squeeze the ID)
       Row 3  room        Row 4  compact dates on one line        Row 5  nights - guests
     Tapping opens Upcoming Hotel Transactions on this transaction with its type and status filters applied. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRecentUpcomingStay"
    style="@style/Widget.Velocity.Card.Flat.Inset"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRecentStayRef"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/velocity_text_primary"
                android:textSize="16sp"
                tools:text="Reservation #123" />

            <TextView
                android:id="@+id/tvRecentStayStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/shape_intro_pill"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="12sp"
                tools:text="Confirmed" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:alpha="0.4"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/velocity_text_secondary" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRecentStayType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_intro_pill"
                android:backgroundTint="@color/status_cancelled_bg"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:letterSpacing="0"
                android:textColor="@color/status_cancelled_fg"
                android:textSize="11sp"
                tools:text="Booking" />

            <TextView
                android:id="@+id/tvRecentStayTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/shape_intro_pill"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:letterSpacing="0"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Upcoming"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Row 3 -->
        <TextView
            android:id="@+id/tvRecentStayRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/velocity_text_primary"
            android:textSize="13sp"
            tools:text="Deluxe ×2" />

        <!-- Row 4: one line, never split -->
        <TextView
            android:id="@+id/tvRecentStayDates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="12sp"
            tools:text="Oct 20 → Oct 21, 2026" />

        <!-- Row 5 -->
        <TextView
            android:id="@+id/tvRecentStayMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="12sp"
            tools:text="1 night · 2 guests" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
