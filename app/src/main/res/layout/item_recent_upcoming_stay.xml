<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the Dashboard's "Recent Upcoming Stay": type, reference number, room, stay dates and the status badge.
     Tapping opens Upcoming Hotel Transactions on this transaction with its type and status filters applied. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRecentUpcomingStay"
    style="@style/Widget.Velocity.Card.Flat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRecentStayType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_intro_pill"
                    android:backgroundTint="@color/velocity_red_soft"
                    android:fontFamily="sans-serif-black"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textAllCaps="true"
                    android:textColor="@color/velocity_red_primary"
                    android:textSize="10sp"
                    tools:text="Booking" />

                <TextView
                    android:id="@+id/tvRecentStayTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/shape_intro_pill"
                    android:fontFamily="sans-serif-black"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textAllCaps="true"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="Upcoming"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvRecentStayRef"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="14sp"
                    tools:text="Booking #338" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRecentStayRoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/velocity_text_primary"
                android:textSize="12sp"
                tools:text="Deluxe Room x2" />

            <TextView
                android:id="@+id/tvRecentStayDates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="12sp"
                tools:text="Oct 20, 2026 – Oct 22, 2026" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRecentStayStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/shape_intro_pill"
            android:fontFamily="sans-serif-black"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textSize="12sp"
            tools:text="Confirmed" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:alpha="0.4"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/velocity_text_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
