<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/velocity_red_subtle"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/velocity_red_soft"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvRequestableAmenityName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/velocity_text_primary"
            android:textSize="14sp"
            tools:text="Additional Towel" />

        <TextView
            android:id="@+id/tvRequestableAmenitySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="11sp"
            android:alpha="0.85"
            tools:text="₱50 each  •  Booked ×2  •  Already requested ×1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRequestableAmenityMinus"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/cd_decrease_quantity"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/white"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_remove"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="14dp"
                app:iconTint="@color/velocity_red_primary" />

            <TextView
                android:id="@+id/tvRequestableAmenityQty"
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:textColor="@color/velocity_text_primary"
                android:textSize="13sp"
                tools:text="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRequestableAmenityPlus"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/cd_increase_quantity"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/white"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="14dp"
                app:iconTint="@color/velocity_red_primary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRequestableAmenitySubmit"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/request_amenity_submit_button"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:paddingHorizontal="16dp"
                app:backgroundTint="@color/velocity_red_primary"
                app:cornerRadius="18dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
