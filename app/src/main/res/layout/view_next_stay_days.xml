<?xml version="1.0" encoding="utf-8"?>
<!-- Body of "Your Next Stay": the day selector, ONE context row ("Tue, Oct 20 · Your next stay · In 2 days · 1 stay" and a
     small Today button), then the stay cards - all straight in the section, no card around them
     (built by DashboardActivity#renderNextStayDays). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Daily | Weekly | Monthly: always one selected, remembered like the other section state. -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/nextStayMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextStayModeDaily"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0"
            android:minHeight="48dp"
            android:text="@string/stay_calendar_daily"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextStayModeWeekly"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0"
            android:minHeight="48dp"
            android:text="@string/stay_calendar_weekly"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextStayModeMonthly"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0"
            android:minHeight="48dp"
            android:text="@string/stay_calendar_monthly"
            android:textSize="13sp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <HorizontalScrollView
        android:id="@+id/nextStayDayScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/nextStayDayStrip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/nextStayDayInfoRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/nextStayDayInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextStayToday"
            style="@style/Widget.Velocity.Flat.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:letterSpacing="0"
            android:minHeight="48dp"
            android:text="@string/next_stay_jump_today"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nextStayDayCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/nextStayDayEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_flat_box"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/next_stay_day_empty"
        android:textColor="@color/velocity_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
