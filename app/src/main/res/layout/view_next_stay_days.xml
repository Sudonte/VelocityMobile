<?xml version="1.0" encoding="utf-8"?>
<!-- Body of "Your Next Stay": a horizontally scrolling day selector, then the transactions on the chosen day
     (built by DashboardActivity#updateNextStay). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <HorizontalScrollView
        android:id="@+id/nextStayDayScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/nextStayDayStrip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- "Your next stay is in 3 days" (only when the chosen day is not Today) and the jump back to Today. -->
    <LinearLayout
        android:id="@+id/nextStayDayInfoRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/nextStayDayInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:paddingTop="8dp"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextStayToday"
            style="@style/Widget.Velocity.Flat.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/next_stay_jump_today"
            app:icon="@drawable/ic_calendar" />
    </LinearLayout>

    <TextView
        android:id="@+id/nextStayDayHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:fontFamily="sans-serif-black"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:textColor="@color/velocity_red_primary"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/nextStayDayCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/nextStayDayEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:paddingVertical="22dp"
        android:text="@string/next_stay_day_empty"
        android:textColor="@color/velocity_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
