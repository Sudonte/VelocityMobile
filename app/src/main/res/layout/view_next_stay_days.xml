<?xml version="1.0" encoding="utf-8"?>
<!-- Body of "Your Next Stay": a horizontally scrolling day selector, then the transactions on the chosen day
     (built by DashboardActivity#updateNextStay). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <HorizontalScrollView
        android:id="@+id/nextStayDayScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/nextStayDayStrip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/nextStayDayHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:fontFamily="sans-serif-black"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:textColor="@color/velocity_red_primary"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/nextStayDayCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/nextStayDayEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:paddingVertical="22dp"
        android:text="@string/next_stay_day_empty"
        android:textColor="@color/velocity_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
