<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/introductionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_introduction"
    android:clipChildren="false">

    <!-- Atmospheric Glow Effects for Depth & Modernity -->
    <View
        android:id="@+id/glowTop"
        android:layout_width="800dp"
        android:layout_height="800dp"
        android:layout_marginTop="-400dp"
        android:alpha="0.45"
        android:background="@drawable/shape_intro_red_glow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/glowBottom"
        android:layout_width="700dp"
        android:layout_height="700dp"
        android:layout_marginEnd="-250dp"
        android:layout_marginBottom="-250dp"
        android:alpha="0.3"
        android:background="@drawable/shape_intro_red_glow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Hero Branding Section -->
    <LinearLayout
        android:id="@+id/logoGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/loadingPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <!-- Logo Halo Effect for Visual Depth -->
        <View
            android:id="@+id/logoHalo"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:alpha="0.3"
            android:layout_marginBottom="-240dp"
            android:background="@drawable/shape_intro_logo_halo" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/logoContainer"
            android:layout_width="170dp"
            android:layout_height="170dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="50dp"
            app:cardElevation="16dp"
            app:strokeColor="@color/velocity_red_primary"
            app:strokeWidth="2dp">

            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_logo"
                android:padding="24dp"
                android:scaleType="fitCenter"
                android:src="@drawable/velocity_suites_logo" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="@string/velocity_suites"
            android:textColor="@color/velocity_red_primary"
            android:textSize="20sp"
            android:textAllCaps="true"/>

    </LinearLayout>

    <!-- Sleek Loading Footer Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loadingPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ProgressBar
            android:id="@+id/introductionProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="100dp"
            android:layout_height="2dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_intro_loading"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/loadingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:text="@string/preparing_stay"
            android:textColor="@color/velocity_red_primary"
            android:textSize="10sp"
            android:textAllCaps="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/introductionProgress" />

        <LinearLayout
            android:id="@+id/statusContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/loadingLabel">

            <View
                android:id="@+id/loadingIndicatorDot"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:background="@drawable/shape_intro_loading_dot" />

            <TextView
                android:id="@+id/loadingMessageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif"
                android:text="@string/introduction_loading_message"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/loadingPercentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-black"
                android:text="0%"
                android:textColor="@color/velocity_red_primary"
                android:textSize="11sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Connection-failed state: shown instead of loadingPanel below the same
         logoGroup (the logo stays visible in both states). Hidden by default -
         MainActivity toggles this and loadingPanel's visibility, never both
         visible at once. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/errorPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:paddingHorizontal="32dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/errorTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="@string/introduction_error_title"
            android:textColor="@color/velocity_red_dark"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/errorDescriptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="13sp"
            tools:text="Please connect to Wi-Fi or mobile data and try again."
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/errorTitleText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIntroductionRetry"
            style="@style/Widget.Velocity.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="18dp"
            android:minWidth="140dp"
            android:paddingHorizontal="24dp"
            android:text="@string/retry_label"
            android:textSize="13sp"
            app:cornerRadius="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/errorDescriptionText" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
