<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingVertical="12dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/stateIconContainer"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:cardBackgroundColor="@color/velocity_red_soft"
        app:cardCornerRadius="26dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/stateIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_info"
            app:tint="@color/velocity_red_primary" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/stateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/velocity_text_primary"
        android:textSize="14sp"
        tools:text="No Ongoing Promotions" />

    <TextView
        android:id="@+id/stateDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.72"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="@color/velocity_text_secondary"
        android:textSize="11sp"
        tools:text="Check back soon for new special offers." />
</LinearLayout>
