<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Booking summary card: a 1dp border and no elevation, like every other flat box in the app. -->
        <LinearLayout
            android:id="@+id/cardBookingSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_flat_box"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/TextAppearance.Velocity.Label.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/bill_summary_title"
                android:textColor="@color/velocity_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvSummaryDates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvSummaryGuests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvSummaryAdultsChildren"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvSummaryRepresentative"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="13sp"
                tools:text="Representative: Juan Dela Cruz" />

            <LinearLayout
                android:id="@+id/layoutSummaryRooms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/layoutSummaryAmenities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="@color/velocity_red_soft" />

                <LinearLayout
                    android:id="@+id/layoutSummaryAmenitiesRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/summary_amenities_subtotal_label"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:id="@+id/tvSummaryAmenitiesSubtotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-bold" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/velocity_red_soft" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/total_label"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/tvSummaryTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zero_price"
                    android:textColor="@color/velocity_red_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-black" />
            </LinearLayout>

            <!-- A claimed discount: its estimated value (from the Discount module), applied after the receptionist verifies the ID. -->
            <TextView
                android:id="@+id/tvSummaryDiscountNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Edit Reservation only: previous total, new total, already paid, and the balance due
             (or excess) - filled in by Step8ReviewPaymentFragment#renderEditTotals(). -->
        <LinearLayout
            android:id="@+id/layoutEditTotals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_flat_box"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/edit_totals_title"
                android:textColor="@color/velocity_text_primary"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/layoutEditTotalsRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Fresh (non-edit) Reservation only: read-only recap of the choice
             made on Step 7 - never editable here, and never any "Paid" text,
             since nothing has been submitted or paid yet. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPaymentMethodSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/velocity_red_bg_end"
            app:strokeColor="@color/velocity_red_subtle"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvSummaryPaymentMethod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="13sp"
                    tools:text="Payment Method: GCash" />

                <TextView
                    android:id="@+id/tvSummaryPaymentMethodNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/velocity_text_secondary"
                    android:textSize="12sp"
                    tools:text="You can complete your GCash payment later by selecting Pay Now from your reservation." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Modify-mode only: lets the guest change payment method (Cash <->
             GCash) as part of the one-time modification, per spec. Hidden for
             a brand-new Reservation (chosen one step earlier, on Step 7, and
             shown read-only above instead) and Booking mode (GCash-only,
             chosen on payment.xml). -->
        <LinearLayout
            android:id="@+id/layoutEditPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/TextAppearance.Velocity.Label.Input"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/payment_method_section_label"
                android:textColor="@color/velocity_text_secondary" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgEditPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="10dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditGcash"
                    style="@style/Widget.Velocity.Flat.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textSize="14sp"
                    android:text="@string/payment_method_gcash"
                    app:chipIcon="@drawable/ic_payment"
                    app:chipIconTint="@color/velocity_red_primary"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditCash"
                    style="@style/Widget.Velocity.Flat.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textSize="14sp"
                    android:text="@string/payment_method_cash"
                    app:chipIcon="@drawable/ic_cash"
                    app:chipIconTint="@color/velocity_red_primary"
                    app:chipIconVisible="true" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Booking mode only: GCash payment happens on payment.xml next, not
             here - Confirm Booking only reviews/accepts terms. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPaymentNextNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/velocity_red_bg_end"
            app:strokeColor="@color/velocity_red_subtle"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_payment"
                    app:tint="@color/velocity_red_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/booking_payment_next_notice"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/velocity_red_soft" />

        <TextView
            style="@style/TextAppearance.Velocity.Label.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/terms_policy_section_title"
            android:textColor="@color/velocity_text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/terms_policy_section_desc"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="12sp" />

        <!-- Shared consent block (guidance, View Terms and Policy, agreement checkbox) - see TermsConsentView. -->
        <com.example.velocitysuites.TermsConsentView
            android:id="@+id/termsConsent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Pinned so Confirm is always visible; the hint says what is still missing. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/velocity_surface_elevated"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tvConfirmHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="12sp"
            tools:text="Still needed: open and read the Terms and Policy, then check the box." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmTransaction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:enabled="false"
            android:text="@string/confirm_booking_button"
            app:backgroundTint="@color/velocity_red_primary" />
    </LinearLayout>

</LinearLayout>
