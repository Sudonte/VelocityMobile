<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/TextAppearance.Velocity.Label.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/bill_summary_title"
            android:textColor="@color/velocity_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSummaryDates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSummaryGuests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSummaryAdultsChildren"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSummaryRepresentative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="13sp"
            tools:text="Representative: Juan Dela Cruz" />

        <LinearLayout
            android:id="@+id/layoutSummaryRooms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/layoutSummaryAmenities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/velocity_red_soft" />

            <LinearLayout
                android:id="@+id/layoutSummaryAmenitiesRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/summary_amenities_subtotal_label"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/tvSummaryAmenitiesSubtotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-bold" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/velocity_red_soft" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/total_label"
                android:textColor="@color/velocity_text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:id="@+id/tvSummaryTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/zero_price"
                android:textColor="@color/velocity_red_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-black" />
        </LinearLayout>

        <!-- Fresh (non-edit) Reservation only: read-only recap of the choice
             made on Step 7 - never editable here, and never any "Paid" text,
             since nothing has been submitted or paid yet. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPaymentMethodSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/velocity_red_bg_end"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/velocity_red_subtle"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvSummaryPaymentMethod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="13sp"
                    tools:text="Payment Method: GCash" />

                <TextView
                    android:id="@+id/tvSummaryPaymentMethodNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/velocity_text_secondary"
                    android:textSize="12sp"
                    tools:text="You can complete your GCash payment later by selecting Pay Now from your reservation." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Modify-mode only: lets the guest change payment method (Cash <->
             GCash) as part of the one-time modification, per spec. Hidden for
             a brand-new Reservation (chosen one step earlier, on Step 7, and
             shown read-only above instead) and Booking mode (GCash-only,
             chosen on payment.xml). -->
        <LinearLayout
            android:id="@+id/layoutEditPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/TextAppearance.Velocity.Label.Input"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/payment_method_section_label"
                android:textColor="@color/velocity_text_secondary" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgEditPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="10dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditGcash"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:textSize="14sp"
                    android:text="@string/payment_method_gcash"
                    app:chipIcon="@drawable/ic_payment"
                    app:chipIconTint="@color/velocity_red_primary"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditCash"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:textSize="14sp"
                    android:text="@string/payment_method_cash"
                    app:chipIcon="@drawable/ic_cash"
                    app:chipIconTint="@color/velocity_red_primary"
                    app:chipIconVisible="true" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Booking mode only: GCash payment happens on payment.xml next, not
             here - Confirm Booking only reviews/accepts terms. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPaymentNextNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/velocity_red_bg_end"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/velocity_red_subtle"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_payment"
                    app:tint="@color/velocity_red_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/booking_payment_next_notice"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/velocity_red_soft" />

        <TextView
            style="@style/TextAppearance.Velocity.Label.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/terms_policy_section_title"
            android:textColor="@color/velocity_text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/terms_policy_section_desc"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="12sp" />

        <!-- Must be tapped (and scrolled to the bottom of the dialog it opens)
             before cbTermsAgreement becomes enabled - see
             Step8ReviewPaymentFragment#showHotelTermsDialog(). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewHotelTerms"
            style="@style/Widget.Velocity.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="12dp"
            android:text="@string/view_hotel_terms_button_label"
            android:textAllCaps="false"
            android:textColor="@color/velocity_red_primary"
            android:textSize="13sp"
            app:icon="@drawable/ic_lock"
            app:iconTint="@color/velocity_red_primary" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbTermsAgreement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/hotel_terms_agreement_checkbox_label"
            android:textColor="@color/velocity_text_primary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmTransaction"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="@string/confirm_booking_button"
            app:backgroundTint="@color/velocity_red_primary" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
