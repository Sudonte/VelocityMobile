<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/velocity_red_bg_end"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".RoomBrowsingActivity">

    <!-- Main Content Area -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/screenContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/velocity_red_bg_end"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            android:outlineProvider="bounds"
            android:translationZ="0dp"
            app:elevation="0dp"
            app:liftOnScroll="true"
            app:liftOnScrollTargetViewId="@id/swipeRefresh">

            <!-- Collapsible Section: Header, Intro, and Search -->
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:minHeight="72dp"
                app:contentScrim="@drawable/bg_guest_header"
                app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
                app:statusBarScrim="@android:color/transparent">

                <!-- Decorative Background Elements -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    app:layout_collapseMode="parallax">

                    <View
                        android:id="@+id/glowTop"
                        android:layout_width="600dp"
                        android:layout_height="600dp"
                        android:layout_marginTop="-300dp"
                        android:alpha="0.25"
                        android:background="@drawable/shape_intro_red_glow"
                        android:layout_gravity="center_horizontal" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="83dp">

                    <TextView
                        android:id="@+id/screenTitle"
                        style="@style/TextAppearance.Velocity.ScreenTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="22dp"
                        android:text="@string/title_room_browsing"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="48dp"
                        android:layout_height="4dp"
                        android:layout_marginHorizontal="22dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/shape_intro_pill"
                        android:backgroundTint="@color/velocity_red_primary" />

                    <TextView
                        android:id="@+id/screenDescription"
                        style="@style/TextAppearance.Velocity.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="22dp"
                        android:layout_marginTop="11dp"
                        android:layout_marginBottom="20dp"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/room_browsing_desc" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/searchCard"
                        style="@style/Widget.Velocity.Card.Glass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:cardCornerRadius="0dp"
                        app:strokeWidth="0dp"
                        app:cardElevation="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_search_panel_full_width"
                            android:padding="16dp">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardSearchHeaderIcon"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                app:cardBackgroundColor="@color/velocity_red_soft"
                                app:cardCornerRadius="@dimen/card_corner_radius"
                                app:cardElevation="@dimen/card_elevation"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="@id/tvSearchHeader">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_bed"
                                    app:tint="@color/velocity_red_primary" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/tvSearchHeader"
                                style="@style/TextAppearance.Velocity.Label.Section"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:ellipsize="end"
                                android:gravity="center_vertical"
                                android:maxLines="1"
                                android:text="@string/find_perfect_stay"
                                android:textAllCaps="false"
                                android:textSize="15sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@id/cardSearchHeaderIcon"
                                app:layout_constraintTop_toTopOf="parent" />

                            <!-- Check-in / Check-out: equal-width symmetric row -->
                            <LinearLayout
                                android:id="@+id/dateFieldsRow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="11dp"
                                android:baselineAligned="false"
                                android:orientation="horizontal"
                                app:layout_constraintTop_toBottomOf="@id/tvSearchHeader">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="@dimen/date_field_gap"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvCheckInLabel"
                                        style="@style/TextAppearance.Velocity.Label.Input"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="@dimen/date_field_label_margin_bottom"
                                        android:labelFor="@+id/etCheckIn"
                                        android:text="@string/check_in_label"
                                        android:textColor="@color/velocity_text_primary" />

                                    <com.google.android.material.textfield.TextInputLayout
                                        android:id="@+id/checkInLayout"
                                        style="@style/Widget.Velocity.TextInputLayout.OutlinedBox.Rounded"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textColorHint="@color/velocity_text_secondary"
                                        app:helperText="@string/helper_checkin_window"
                                        app:helperTextTextColor="@color/velocity_text_secondary"
                                        app:hintTextColor="@color/velocity_text_secondary"
                                        app:startIconDrawable="@drawable/ic_calendar"
                                        app:startIconTint="@color/velocity_red_primary">

                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/etCheckIn"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:focusable="false"
                                            android:hint="@string/select_date_hint"
                                            android:inputType="none"
                                            android:paddingVertical="@dimen/date_field_text_padding"
                                            android:textColor="@color/velocity_text_primary"
                                            android:fontFamily="sans-serif-black"
                                            android:includeFontPadding="false"
                                            android:textSize="@dimen/date_field_text_size" />
                                    </com.google.android.material.textfield.TextInputLayout>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/date_field_gap"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvCheckOutLabel"
                                        style="@style/TextAppearance.Velocity.Label.Input"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="@dimen/date_field_label_margin_bottom"
                                        android:labelFor="@+id/etCheckOut"
                                        android:text="@string/check_out_label"
                                        android:textColor="@color/velocity_text_primary" />

                                    <com.google.android.material.textfield.TextInputLayout
                                        android:id="@+id/checkOutLayout"
                                        style="@style/Widget.Velocity.TextInputLayout.OutlinedBox.Rounded"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textColorHint="@color/velocity_text_secondary"
                                        app:helperText="@string/helper_checkout_after_checkin"
                                        app:helperTextTextColor="@color/velocity_text_secondary"
                                        app:hintTextColor="@color/velocity_text_secondary"
                                        app:startIconDrawable="@drawable/ic_calendar"
                                        app:startIconTint="@color/velocity_red_primary">

                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/etCheckOut"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:focusable="false"
                                            android:hint="@string/select_date_hint"
                                            android:inputType="none"
                                            android:paddingVertical="@dimen/date_field_text_padding"
                                            android:textColor="@color/velocity_text_primary"
                                            android:fontFamily="sans-serif-black"
                                            android:includeFontPadding="false"
                                            android:textSize="@dimen/date_field_text_size" />
                                    </com.google.android.material.textfield.TextInputLayout>
                                </LinearLayout>
                            </LinearLayout>

                            <!-- "2 nights" once both dates are picked. -->
                            <TextView
                                android:id="@+id/tvNightsSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:drawablePadding="6dp"
                                android:fontFamily="sans-serif-bold"
                                android:gravity="center_vertical"
                                android:textColor="@color/velocity_red_primary"
                                android:textSize="13sp"
                                android:visibility="gone"
                                app:drawableStartCompat="@drawable/ic_clock"
                                app:drawableTint="@color/velocity_red_primary"
                                app:layout_constraintTop_toBottomOf="@id/dateFieldsRow"
                                tools:text="2 nights"
                                tools:visibility="visible" />

                            <!-- 48-hour advance check-in note; text from CheckInNotice so the date is never hard-coded. -->
                            <TextView
                                android:id="@+id/tvCheckInAdvanceNotice"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@color/velocity_red_bg_end"
                                android:drawablePadding="8dp"
                                android:padding="11dp"
                                android:textColor="@color/velocity_text_primary"
                                android:textSize="12sp"
                                app:drawableStartCompat="@drawable/ic_info"
                                app:drawableTint="@color/velocity_red_primary"
                                app:layout_constraintTop_toBottomOf="@id/tvNightsSummary" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSearchAvailability"
                                style="@style/Widget.Velocity.Button"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/search_button_height"
                                android:layout_marginTop="11dp"
                                android:text="@string/search_availability"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                app:backgroundTint="@color/bg_button_primary"
                                app:iconTint="@color/white"
                                app:layout_constraintTop_toBottomOf="@id/tvCheckInAdvanceNotice"
                                app:icon="@drawable/ic_room_search"
                                app:iconGravity="textStart"
                                app:iconPadding="10dp"
                                app:iconSize="18dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnResetSearch"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:minHeight="48dp"
                                android:text="@string/reset_label"
                                android:textColor="@color/velocity_red_primary"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-black"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:icon="@drawable/ic_close"
                                app:iconGravity="textStart"
                                app:iconSize="14dp"
                                app:iconPadding="4dp"
                                app:iconTint="@color/velocity_red_primary"
                                app:layout_constraintTop_toBottomOf="@id/btnSearchAvailability" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Pinned Header -->
                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    app:contentInsetStart="0dp"
                    app:layout_collapseMode="pin">
                    <include
                        android:id="@+id/header"
                        layout="@layout/guest_header"
                        android:layout_width="match_parent"
                        android:layout_height="72dp" />
                </androidx.appcompat.widget.Toolbar>

            </com.google.android.material.appbar.CollapsingToolbarLayout>

            <!-- Sticky Control Bar (Pinned) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/stickyControlBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="0dp"
                android:outlineProvider="bounds"
                android:translationZ="0dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/velocity_surface_elevated"
                    android:orientation="vertical">

                    <!-- Top Accent Line -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/velocity_red_subtle" />

                    <!-- One compact row: result count | Sort | FILTERS (n). Type / Status / Capacity / Price live in the Filters dialog. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/tvResultsCount"
                            style="@style/TextAppearance.Velocity.Price"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:textColor="@color/velocity_red_text"
                            android:textSize="13sp"
                            tools:text="25 Rooms Found" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSort"
                            style="@style/Widget.Velocity.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:maxWidth="132dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="10dp"
                            android:text="@string/sort_default"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_expand_more"
                            app:iconGravity="end"
                            app:iconPadding="2dp"
                            app:iconSize="18dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFilters"
                            style="@style/Widget.Velocity.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="10dp"
                            android:maxLines="1"
                            android:text="@string/filter_label"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_filter"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconSize="16dp" />
                    </LinearLayout>

                    <!-- Compact dates, shown once dates are picked; tap = back up to the search card. -->
                    <TextView
                        android:id="@+id/tvPinnedDates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:drawablePadding="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center_vertical"
                        android:minHeight="40dp"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="12sp"
                        android:visibility="gone"
                        app:drawableStartCompat="@drawable/ic_calendar"
                        app:drawableTint="@color/velocity_red_primary"
                        tools:text="Oct 12 - Oct 14 - 2 nights"
                        tools:visibility="visible" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:background="@drawable/shape_bottom_shadow_light"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Room Listing -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:translationZ="0dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRooms"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/velocity_red_bg_end"
                android:clipToPadding="false"
                android:elevation="0dp"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="never"
                android:paddingHorizontal="22dp"
                android:paddingTop="8dp"
                android:paddingBottom="101dp"
                android:scrollbarStyle="outsideOverlay"
                tools:listitem="@layout/item_room_card" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Skeleton loader: placeholder cards in the list area while rooms load. Sits where the list sits (below
             the app bar, scrolling with it) and swallows taps so nothing underneath is hit mid-load. -->
        <FrameLayout
            android:id="@+id/loadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/velocity_red_bg_end"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:id="@+id/skeletonList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="22dp"
                android:paddingTop="8dp">

                <include layout="@layout/view_room_skeleton_card" />

                <include layout="@layout/view_room_skeleton_card" />

                <include layout="@layout/view_room_skeleton_card" />
            </LinearLayout>
        </FrameLayout>

        <!-- Empty State View -->
        <include
            android:id="@+id/noResultsView"
            layout="@layout/view_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:behavior_overlapTop="150dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <!-- Persistent network/API failure state - distinct from noResultsView
             above ("no rooms match your filters" vs "couldn't load at all").
             Reuses the same shared component; child views are looked up scoped
             to this include's own root, so its emptyIcon/emptyTitle/emptyDesc/
             btnEmptyAction ids never collide with noResultsView's copies. -->
        <include
            android:id="@+id/layoutRoomError"
            layout="@layout/view_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:behavior_overlapTop="150dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <!-- Multi-room selection cart: same pattern as landing.xml's
             cardSelectionSummaryBar - hidden until >=1 room has a quantity
             set. Two full-width rows (info, then actions) rather than
             packing the info column and all 3 buttons into one row - see
             landing.xml's copy of this bar for the width-overflow bug this
             avoids. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSelectionSummaryBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:visibility="gone"
            tools:visibility="visible"
            app:cardBackgroundColor="@color/velocity_surface_elevated"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:strokeColor="@color/velocity_red_subtle"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="11dp">

                <LinearLayout
                    android:id="@+id/layoutSelectionSummaryDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/view_details_label">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSelectionSummaryCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="@color/velocity_text_primary"
                            android:textSize="12sp"
                            tools:text="2 room(s) selected · Up to 4 guests" />

                        <TextView
                            android:id="@+id/tvSelectionSummaryTotal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/velocity_red_primary"
                            android:textSize="14sp"
                            tools:text="&#8369;7,000 total / night" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/view_details_label"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCartClear"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/cart_clear_button"
                        android:textAllCaps="false"
                        android:textColor="@color/velocity_inactive_gray"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCartReserve"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingHorizontal="4dp"
                        android:text="@string/cart_reserve_button"
                        android:textAllCaps="false"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="11sp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-bold"
                        app:cornerRadius="0dp"
                        app:strokeColor="@color/velocity_red_soft" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCartBook"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingHorizontal="4dp"
                        android:text="@string/cart_book_button"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-bold"
                        app:backgroundTint="@color/velocity_red_primary"
                        app:cornerRadius="0dp"
                        app:elevation="0dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

