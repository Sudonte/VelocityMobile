<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Velocity.Card.Glass"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/room_list_card_spacing"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card_white"
        android:orientation="vertical"
        android:padding="@dimen/room_list_card_content_padding">

        <!-- Image column + info column. Info column is centered vertically
             against the image so shorter content doesn't sit top-heavy.
             On a narrow screen or with a large system font this row (and the action row below) is
             restacked top-to-bottom by RoomAdapter#applyRoomyLayout(): a 140dp photo beside a column
             that is only ~80dp wide leaves the text breaking in the middle of words. -->
        <LinearLayout
            android:id="@+id/roomCardTopRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Room Image - clean: only the availability badge, favorite
                 toggle, and price badge live on the photo. Amenities live in
                 their own full-width section below (see amenitiesChipGroup). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/roomImageCard"
                android:layout_width="@dimen/room_list_card_image_width"
                android:layout_height="@dimen/room_list_card_image_height"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/roomImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@color/velocity_red_soft"
                        android:contentDescription="@string/cd_room_image" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/gradient_overlay"
                        android:importantForAccessibility="no" />

                    <!-- Availability status pill - top-left of the image. Self-styled
                         via bg_badge_* drawables set in RoomAdapter#bindRoom(). -->
                    <TextView
                        android:id="@+id/roomStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="6dp"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="3dp"
                        android:text="@string/available_label"
                        android:textColor="@color/velocity_green_primary"
                        android:textSize="10sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05" />

                    <!-- Favorite toggle - top-right of the image. -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/card_elevation"
                        app:strokeColor="@color/velocity_red_subtle"
                        app:strokeWidth="1dp">

                        <ImageButton
                            android:id="@+id/btnFavorite"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="9dp"
                            android:src="@drawable/ic_favorite_border"
                            android:contentDescription="@string/cd_add_to_favorites"
                            app:tint="@color/velocity_red_primary" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Price Tag - bottom-left of the image. -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="8dp"
                        app:cardBackgroundColor="@color/velocity_red_primary"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/card_elevation">

                        <TextView
                            android:id="@+id/roomPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:letterSpacing="-0.02"
                            tools:text="3,500 / night" />
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Info column. The three facts are 12sp and may wrap onto a second line (they used to be 10sp
                 and cut off with an ellipsis), so a large font or a long bed description is still readable. -->
            <LinearLayout
                android:id="@+id/roomInfoColumn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/roomName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="15sp"
                    android:letterSpacing="-0.02"
                    tools:text="Standard Room" />

                <!-- Guest capacity -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_people"
                        app:tint="@color/velocity_red_primary" />

                    <TextView
                        android:id="@+id/roomGuestsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="sans-serif-bold"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="12sp"
                        tools:text="2 Guests" />
                </LinearLayout>

                <!-- Bed type -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_bed"
                        app:tint="@color/velocity_red_primary" />

                    <TextView
                        android:id="@+id/roomBedType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="sans-serif-bold"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="12sp"
                        tools:text="King Bed" />
                </LinearLayout>

                <!-- Room size -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_area"
                        app:tint="@color/velocity_red_primary" />

                    <TextView
                        android:id="@+id/roomSizeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="sans-serif-bold"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="12sp"
                        tools:text="42 sqm" />
                </LinearLayout>

                <!-- LIMITED-tier hint only - see RoomAvailabilityStatus. Hidden for
                     AVAILABLE/FULLY_BOOKED so the compact card stays uncluttered. -->
                <TextView
                    android:id="@+id/tvRoomsLeftHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/velocity_action_text"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="Only 2 room(s) left"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <!-- Amenities - full-width section directly below the image/info
             row, showing every amenity assigned to this room type (never
             capped/hidden, never truncated). Full-width, wrapping ChipGroup
             (no singleLine, no HorizontalScrollView) so every amenity is
             visible directly in the card - once a row fills, remaining
             amenities automatically flow onto the next row - populated in
             RoomAdapter#bindAmenities. -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/amenitiesChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:chipSpacingHorizontal="4dp"
            app:chipSpacingVertical="4dp" />

        <!-- Room Quantity - full-width row, directly above the divider and
             action buttons. Multi-room cart stepper: lets a guest stage N
             units of this room type into a running multi-room cart
             (landing.xml/roombrowsing.xml summary bar) without leaving the
             list, capped at Room#getAvailableCount(). Hidden entirely for
             unavailable rooms and in details-only mode - see
             RoomAdapter#bindRoom(). The - and + buttons are 40dp (they were 22dp)
             and the label and count are readable sizes. -->
        <LinearLayout
            android:id="@+id/cardRoomQtyStepper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/shape_search_field"
            android:backgroundTint="@color/velocity_red_bg_end"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:text="@string/room_quantity_label"
                android:textColor="@color/velocity_text_primary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRoomQtyMinus"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/cd_decrease_quantity"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                app:backgroundTint="@color/velocity_red_soft"
                app:cornerRadius="0dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_remove"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/velocity_action_text" />

            <TextView
                android:id="@+id/tvRoomQty"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:textColor="@color/velocity_text_primary"
                android:textSize="14sp"
                tools:text="0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRoomQtyPlus"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/cd_increase_quantity"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                app:backgroundTint="@color/velocity_red_primary"
                app:cornerRadius="0dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/white" />
        </LinearLayout>

        <!-- Occupied info row: shown instead of the CTA row for unavailable rooms.
             Only the occupancy period is surfaced here - no guest/booking identity. -->
        <LinearLayout
            android:id="@+id/layoutOccupiedInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/shape_search_field"
            android:backgroundTint="@color/velocity_red_bg_end"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="9dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_calendar"
                app:tint="@color/velocity_text_secondary" />

            <TextView
                android:id="@+id/tvOccupiedRange"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="12sp"
                tools:text="Occupied: Aug 10, 2026 – Aug 14, 2026" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:background="@color/velocity_red_subtle"
            android:alpha="0.5"
            android:importantForAccessibility="no" />

        <!-- Action area: Reserve Now / Book Now side by side (Book Now, the filled one, is the main action),
             View Details underneath. Every room card always offers all three - a fully-booked room keeps them
             visible but disabled rather than hiding them. Each is a real 48dp touch target with 13sp text that
             can wrap onto a second line; in one cramped 9sp row (the old layout) the labels were unreadable
             and cut off at a large font size. -->
        <LinearLayout
            android:id="@+id/layoutRoomActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layoutRoomActionsPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReserveNow"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-bold"
                    android:includeFontPadding="false"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="2"
                    android:minHeight="48dp"
                    android:paddingHorizontal="6dp"
                    android:stateListAnimator="@null"
                    android:text="@string/reserve_now"
                    android:textAllCaps="false"
                    android:textColor="@color/velocity_action_text"
                    android:textSize="13sp"
                    app:cornerRadius="0dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_calendar"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/velocity_action_text"
                    app:strokeColor="@color/velocity_red_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickBook"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-bold"
                    android:includeFontPadding="false"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="2"
                    android:minHeight="48dp"
                    android:paddingHorizontal="6dp"
                    android:stateListAnimator="@null"
                    android:text="@string/book_now"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    app:backgroundTint="@color/velocity_red_primary"
                    app:cornerRadius="0dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_booking"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/white" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewDetails"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:includeFontPadding="false"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:maxLines="2"
                android:minHeight="48dp"
                android:paddingHorizontal="6dp"
                android:stateListAnimator="@null"
                android:text="@string/view_details"
                android:textAllCaps="false"
                android:textColor="@color/velocity_text_primary"
                android:textSize="13sp"
                app:cornerRadius="0dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_eye"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="@color/velocity_text_primary"
                app:strokeColor="@color/velocity_red_subtle" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
