<?xml version="1.0" encoding="utf-8"?>
<!-- A room in Room Browsing and on the landing page: only the important details.
       Photo (availability chip + favorite heart; tapping the photo or the name opens the details)
       Name (about 20sp, bold, shown once) ..... price (about 20sp, bold) - side by side when they fit, else the price under the name
       A small type chip only when the room type differs from the name
       One compact facts row with small icons: guests, beds, size   +  a "No refund" chip
       "+5 amenities" (small, secondary) and a "View details" text link
       Room quantity stepper, then Reserve (outlined) and Book now (filled) side by side.
     The description and the full amenity list live on the Room Details screen. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Velocity.Card.Glass"
    tools:ignore="UselessParent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/room_list_card_spacing"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card_white"
        android:orientation="vertical"
        android:padding="@dimen/room_list_card_content_padding">

        <!-- On a narrow screen or with a large system font RoomAdapter#applyRoomyLayout() restacks the actions; this
             column is already one vertical stack. -->
        <LinearLayout
            android:id="@+id/roomCardTopRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/roomImageCard"
                android:layout_width="match_parent"
                android:layout_height="@dimen/room_list_card_photo_height"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/roomImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/velocity_red_soft"
                        android:contentDescription="@string/cd_room_image"
                        android:scaleType="centerCrop" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/gradient_overlay"
                        android:importantForAccessibility="no" />

                    <!-- Availability chip, top-left; styled by RoomAdapter#bindRoom(). -->
                    <TextView
                        android:id="@+id/roomStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="6dp"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:letterSpacing="0"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="3dp"
                        android:text="@string/available_label"
                        android:textAllCaps="false"
                        android:textColor="@color/velocity_green_primary"
                        android:textSize="12sp" />

                    <!-- Favorite toggle, top-right. -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        app:cardBackgroundColor="@color/velocity_surface_elevated"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/card_elevation"
                        app:strokeColor="@color/velocity_red_primary"
                        app:strokeWidth="1dp">

                        <ImageButton
                            android:id="@+id/btnFavorite"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/cd_add_to_favorites"
                            android:padding="9dp"
                            android:src="@drawable/ic_favorite_border"
                            app:tint="@color/velocity_red_primary" />
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/roomInfoColumn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <!-- Name left, price right - or the price directly under the name when both do not fit. -->
                <com.example.velocitysuites.NamePriceRow
                    android:id="@+id/roomNamePriceRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/roomName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:letterSpacing="0"
                        android:maxLines="2"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="20sp"
                        tools:text="Deluxe" />

                    <TextView
                        android:id="@+id/roomPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="20sp"
                        tools:text="₱3,500 / night" />
                </com.example.velocitysuites.NamePriceRow>

                <!-- Only when the room type is not just the name again. -->
                <TextView
                    android:id="@+id/roomTypeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/shape_intro_pill"
                    android:backgroundTint="@color/status_cancelled_bg"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/status_cancelled_fg"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="Deluxe Suite"
                    tools:visibility="visible" />

                <!-- One compact facts row: small icon + value, wrapping to a second line only when they cannot fit. -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <LinearLayout
                        android:id="@+id/factGuests"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_people"
                            app:tint="@color/velocity_red_primary" />

                        <TextView
                            android:id="@+id/roomGuestsText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/velocity_text_primary"
                            android:textSize="12sp"
                            tools:text="2 guests" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/factBeds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_bed"
                            app:tint="@color/velocity_red_primary" />

                        <TextView
                            android:id="@+id/roomBedType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:maxWidth="200dp"
                            android:textColor="@color/velocity_text_primary"
                            android:textSize="12sp"
                            tools:text="2 beds" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/factSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_area"
                            app:tint="@color/velocity_red_primary" />

                        <TextView
                            android:id="@+id/roomSizeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/velocity_text_primary"
                            android:textSize="12sp"
                            tools:text="29.99 sqm" />
                    </LinearLayout>

                    <androidx.constraintlayout.helper.widget.Flow
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:constraint_referenced_ids="factGuests,factBeds,factSize"
                        app:flow_horizontalBias="0"
                        app:flow_horizontalGap="12dp"
                        app:flow_horizontalStyle="packed"
                        app:flow_verticalGap="4dp"
                        app:flow_wrapMode="chain"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Rarely used hint; always hidden on the compact card. -->
                <TextView
                    android:id="@+id/tvRoomsLeftHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <!-- Refund policy, as a small chip. -->
                <TextView
                    android:id="@+id/tvNoRefundBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_badge_warning"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:letterSpacing="0"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp"
                    android:text="@string/no_refund_badge"
                    android:textColor="@color/velocity_action_text"
                    android:textSize="12sp" />

                <!-- "+5 amenities" (small, secondary) and the View details link. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvAmenitiesMore"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="12sp"
                        tools:text="+5 amenities" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewDetails"
                        style="@style/Widget.Velocity.Flat.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="none"
                        android:insetTop="4dp"
                        android:insetBottom="4dp"
                        android:letterSpacing="0"
                        android:maxLines="1"
                        android:minWidth="0dp"
                        android:paddingHorizontal="4dp"
                        android:text="@string/view_details"
                        android:textColor="@color/velocity_action_text"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Room quantity: a compact stepper, "+" disabled once the available count is reached. Hidden for unavailable rooms
             and in details-only mode (RoomAdapter#bindQuantityStepper). -->
        <LinearLayout
            android:id="@+id/cardRoomQtyStepper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/shape_search_field"
            android:backgroundTint="@color/velocity_red_bg_end"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:text="@string/room_quantity_label"
                android:textColor="@color/velocity_text_primary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRoomQtyMinus"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/cd_decrease_quantity"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                app:backgroundTint="@color/velocity_red_soft"
                app:cornerRadius="0dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_remove"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/velocity_action_text" />

            <TextView
                android:id="@+id/tvRoomQty"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:textColor="@color/velocity_text_primary"
                android:textSize="13sp"
                tools:text="0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRoomQtyPlus"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/cd_increase_quantity"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                app:backgroundTint="@color/velocity_red_primary"
                app:cornerRadius="0dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/white" />
        </LinearLayout>

        <!-- Occupied info row: shown instead of the stepper for unavailable rooms (the occupancy period only - no guest identity). -->
        <LinearLayout
            android:id="@+id/layoutOccupiedInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/shape_search_field"
            android:backgroundTint="@color/velocity_red_bg_end"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="9dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_calendar"
                app:tint="@color/velocity_text_secondary" />

            <TextView
                android:id="@+id/tvOccupiedRange"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:maxLines="2"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="12sp"
                tools:text="Occupied: Aug 10, 2026 – Aug 14, 2026" />
        </LinearLayout>

        <!-- Actions: Reserve (outlined) and Book now (filled) side by side, compact. A fully-booked room keeps them visible but disabled. -->
        <LinearLayout
            android:id="@+id/layoutRoomActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layoutRoomActionsPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReserveNow"
                    style="@style/Widget.Velocity.Flat.Button.Compact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:text="@string/room_card_reserve"
                    app:icon="@drawable/ic_calendar"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/velocity_action_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickBook"
                    style="@style/Widget.Velocity.Flat.Button.Compact.Filled"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:text="@string/room_card_book_now"
                    app:icon="@drawable/ic_booking"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/button_primary_text" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
