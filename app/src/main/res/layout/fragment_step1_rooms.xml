<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Shown only while the initial date-aware availability fetch for this step is in flight - see Step1RoomSelectionFragment#onViewCreated(). -->
        <LinearLayout
            android:id="@+id/layoutCheckingAvailability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <ProgressBar
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="10dp"
                android:indeterminateTint="@color/velocity_red_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/checking_available_rooms_message"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Shown instead of everything below when the initial availability fetch itself fails (network/server error) - distinct from the zero-availability empty state below it, since "no rooms for these dates" and "couldn't reach the server" need different messaging and this one offers Retry. -->
        <LinearLayout
            android:id="@+id/layoutRoomLoadError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/shape_tab_background"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginBottom="10dp"
                android:alpha="0.6"
                android:contentDescription="@null"
                android:src="@drawable/ic_wifi_off"
                app:tint="@color/velocity_text_secondary" />

            <TextView
                style="@style/TextAppearance.Velocity.Label.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/room_load_error_title"
                android:textColor="@color/velocity_text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/room_load_error_message"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryRoomLoad"
                style="@style/Widget.Velocity.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:paddingHorizontal="20dp"
                android:text="@string/retry_label"
                android:textColor="@color/velocity_red_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Shown instead of everything below once the fetch above comes back with zero availability across every room type for the selected dates. -->
        <LinearLayout
            android:id="@+id/layoutNoRoomsAvailableForDates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/shape_tab_background"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginBottom="10dp"
                android:alpha="0.6"
                android:contentDescription="@null"
                android:src="@drawable/ic_bed"
                app:tint="@color/velocity_text_secondary" />

            <TextView
                style="@style/TextAppearance.Velocity.Label.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/no_available_rooms_title"
                android:textColor="@color/velocity_text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/no_available_rooms_message"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeDates"
                style="@style/Widget.Velocity.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:paddingHorizontal="20dp"
                android:text="@string/change_dates_button"
                android:textColor="@color/velocity_red_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutRoomSelectionContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            style="@style/TextAppearance.Velocity.Label.Input"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/add_room_hint"
            android:textColor="@color/velocity_text_primary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddRoom"
            style="@style/Widget.Velocity.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/add_room_button_label"
            android:textColor="@color/velocity_text_primary"
            android:textSize="13sp"
            app:icon="@drawable/ic_bed"
            app:iconTint="@color/velocity_red_primary" />

        <TextView
            android:id="@+id/tvRoomSelectionHelper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/booking_select_room_helper_multi"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/layoutSelectedRooms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/layoutNoRoomsSelected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/shape_tab_background"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="18dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginBottom="6dp"
                android:alpha="0.6"
                android:contentDescription="@null"
                android:src="@drawable/ic_bed"
                app:tint="@color/velocity_text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/no_rooms_selected_hint"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:cardBackgroundColor="@color/velocity_red_subtle"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/velocity_red_soft"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_people"
                    app:tint="@color/velocity_red_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Velocity.Label.Input"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/capacity_label"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvCapacityIndicator"
                        style="@style/TextAppearance.Velocity.Price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add_room_hint"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRoomsSelectedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_intro_pill"
                    android:backgroundTint="@color/white"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/no_rooms_selected_yet"
                    android:textColor="@color/velocity_red_primary"
                    android:fontFamily="sans-serif-black"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
