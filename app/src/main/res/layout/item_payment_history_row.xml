<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@color/velocity_red_bg_end"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPhAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/velocity_text_primary"
            android:textSize="16sp"
            tools:text="₱1,200.00" />

        <TextView
            android:id="@+id/tvPhStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/shape_flat_badge"
            android:fontFamily="sans-serif-bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textSize="12sp"
            tools:text="Verified" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPhMethodType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/velocity_text_primary"
        android:textSize="13sp"
        tools:text="GCash · Deposit" />

    <TextView
        android:id="@+id/tvPhDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/velocity_text_secondary"
        android:textSize="12sp"
        tools:text="Oct 12, 2026 · 3:45 PM" />

    <TextView
        android:id="@+id/tvPhReference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/velocity_text_secondary"
        android:textSize="12sp"
        tools:text="Ref. 1234 567 890123" />

    <TextView
        android:id="@+id/tvPhReceiptHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:drawablePadding="4dp"
        android:fontFamily="sans-serif-bold"
        android:minHeight="32dp"
        android:gravity="center_vertical"
        android:text="@string/ph_view_receipt"
        android:textColor="@color/velocity_red_primary"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
