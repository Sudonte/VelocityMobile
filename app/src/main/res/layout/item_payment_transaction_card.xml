<?xml version="1.0" encoding="utf-8"?>
<!--
     One Transaction History card = one payment event (see PaymentTransactionAdapter).

     Layout, top to bottom:
       header    status icon | title (room summary, up to 2 lines) ............ amount
       badges    [BOOKING #250] [● PAID]                                        chevron
       ───────────────────────────────────────────────────────────────────────────────
       details   Stay      Sep 25 – Sep 27, 2026
                 Payment   Sep 02, 2026 • 10:24 AM
       progress  Paid ₱1,000.00  •  Remaining ₱1,900.00        (only when partially paid)
       receipts  ⟳ 2 Receipts Available                          (only when receipts exist)

     Every text that can be long (title, stay dates, progress) lives on its own line and
     wraps rather than sharing a narrow column with the amount - the previous 3-column
     layout squeezed "Booking #250 • Sep 25 – Sep 27, 2026" into ~150dp on a 360dp phone
     and ellipsized the check-out date away. The amount is wrap_content with no maxLines,
     so it is never the thing that gives way.

     Same compact glass-card style and 16dp side margins as item_notification.xml, so the
     two list screens read as one system.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Velocity.Card.Glass.Compact"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="@color/velocity_red_subtle">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card_white"
        android:padding="14dp">

        <!-- Status icon circle: same status colors as the badge (PaymentTransactionStatus). -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/iconContainerPtx"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="@color/velocity_green_soft"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivPtxIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/velocity_green_dark" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvPtxAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/velocity_red_primary"
            android:textSize="17sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="₱2,900.00" />

        <!-- The room selection ("Deluxe ×2 • Suite") - up to 2 lines, then ellipsized; the
             detail screen carries the full text. -->
        <TextView
            android:id="@+id/tvPtxTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="2"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@+id/tvPtxAmount"
            app:layout_constraintStart_toEndOf="@+id/iconContainerPtx"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Deluxe Room ×2 • Executive Suite" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierPtxHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tvPtxTitle,tvPtxAmount" />

        <!-- Type + reference chip ("Booking #250", colored by NotificationCategoryPresenter -
             the same mapping the notification cards use) and the color-coded status badge.
             A Flow so the two wrap onto a second line instead of clipping on a narrow
             screen or a large font size. -->
        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/flowPtxBadges"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            app:constraint_referenced_ids="tvPtxTypeChip,tvPtxStatusBadge"
            app:flow_horizontalBias="0"
            app:flow_horizontalGap="6dp"
            app:flow_horizontalStyle="packed"
            app:flow_verticalGap="6dp"
            app:flow_wrapMode="chain"
            app:layout_constraintEnd_toStartOf="@+id/ivPtxChevron"
            app:layout_constraintStart_toStartOf="@+id/tvPtxTitle"
            app:layout_constraintTop_toBottomOf="@+id/barrierPtxHeader" />

        <TextView
            android:id="@+id/tvPtxTypeChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_intro_pill"
            android:backgroundTint="@color/velocity_red_bg_start"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textAllCaps="true"
            android:textColor="@color/velocity_red_primary"
            android:textSize="11sp"
            tools:text="Booking #250" />

        <!-- Status badge: label, fill and leading icon are all set per status in
             PaymentTransactionAdapter (PaymentTransactionStatus#styleFor()). -->
        <TextView
            android:id="@+id/tvPtxStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_intro_pill"
            android:backgroundTint="@color/velocity_red_primary"
            android:drawablePadding="4dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center_vertical"
            android:letterSpacing="0.05"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="11sp"
            tools:text="Paid" />

        <!-- "Open the details" affordance, vertically centered on the badge row. -->
        <ImageView
            android:id="@+id/ivPtxChevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:layout_constraintBottom_toBottomOf="@+id/flowPtxBadges"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/flowPtxBadges"
            app:tint="@color/velocity_inactive_gray" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierPtxTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="iconContainerPtx,flowPtxBadges,ivPtxChevron" />

        <View
            android:id="@+id/dividerPtx"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/velocity_divider_hairline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrierPtxTop" />

        <!-- Label/value rows. The values start at a Barrier at the end of the LONGER label, so
             they line up whatever the language or font scale; a value that wraps pushes the
             next row down (each row hangs off the row above, never a fixed height). -->
        <TextView
            android:id="@+id/tvPtxStayLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ptx_stay_label"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dividerPtx" />

        <TextView
            android:id="@+id/tvPtxStay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/velocity_text_primary"
            android:textSize="12sp"
            app:layout_constraintBaseline_toBaselineOf="@+id/tvPtxStayLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/barrierPtxLabels"
            tools:text="Sep 25 – Sep 27, 2026" />

        <TextView
            android:id="@+id/tvPtxDateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ptx_payment_date_label"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvPtxStay" />

        <TextView
            android:id="@+id/tvPtxDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/velocity_text_primary"
            android:textSize="12sp"
            app:layout_constraintBaseline_toBaselineOf="@+id/tvPtxDateLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/barrierPtxLabels"
            tools:text="Sep 02, 2026  •  10:24 AM" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierPtxLabels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="end"
            app:constraint_referenced_ids="tvPtxStayLabel,tvPtxDateLabel" />

        <!-- Booking-level Paid/Remaining - shown by PaymentTransactionAdapter only when the
             transaction is genuinely PARTIALLY paid (something paid, something still owed). -->
        <TextView
            android:id="@+id/tvPtxPaymentProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvPtxDate"
            tools:text="Paid ₱1,000.00  •  Remaining ₱1,900.00" />

        <!-- "N Receipt(s) Available" - only when booking.getReceipts() is non-empty; tapping
             the card opens TransactionDetailsActivity, where every receipt is listed. -->
        <LinearLayout
            android:id="@+id/layoutPtxReceiptsAvailable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvPtxPaymentProgress"
            tools:visibility="visible">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_transaction_history"
                app:tint="@color/velocity_red_primary" />

            <TextView
                android:id="@+id/tvPtxReceiptsAvailable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/velocity_red_primary"
                android:textSize="11sp"
                tools:text="2 Receipts Available" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
