<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/velocity_red_bg_end"
    tools:context=".NotificationActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/notificationRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:liftOnScroll="true"
            app:liftOnScrollTargetViewId="@id/rvNotifications">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentScrim="@drawable/bg_guest_header"
                app:layout_scrollFlags="scroll|exitUntilCollapsed"
                app:statusBarScrim="@android:color/transparent"
                app:titleEnabled="false"
                android:minHeight="72dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="83dp"
                    android:paddingBottom="13dp"
                    app:layout_collapseMode="parallax">

                    <TextView
                        android:id="@+id/screenTitle"
                        style="@style/TextAppearance.Velocity.ScreenTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="22dp"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:text="@string/title_notifications"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="15sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:id="@+id/titleUnderline"
                        android:layout_width="56dp"
                        android:layout_height="6dp"
                        android:layout_marginTop="11dp"
                        android:background="@drawable/shape_intro_pill"
                        android:backgroundTint="@color/velocity_red_primary"
                        app:layout_constraintStart_toStartOf="@+id/screenTitle"
                        app:layout_constraintTop_toBottomOf="@+id/screenTitle" />

                    <TextView
                        android:id="@+id/screenDescription"
                        style="@style/TextAppearance.Velocity.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:layout_marginEnd="43dp"
                        android:lineSpacingMultiplier="1.4"
                        android:text="@string/notification_screen_desc"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/screenTitle"
                        app:layout_constraintTop_toBottomOf="@+id/titleUnderline" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSearchNotifications"
                        style="@style/Widget.Velocity.TextInputLayout.Filter.Search"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="22dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="22dp"
                        app:endIconMode="clear_text"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/screenDescription"
                        app:startIconDrawable="@drawable/ic_search">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSearchNotifications"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:hint="@string/search_notifications_hint"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Show: one outlined exposed dropdown, the same style as the Transaction History filters - a floating
                         "Show" label, a gray border (red only while focused / open), a non-filtering adapter so the menu always
                         lists every option, each with its category icon in the shared round circle. -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutNotificationStatusFilter"
                        style="@style/Widget.Velocity.TextInputLayout.Filter.Dropdown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="22dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="22dp"
                        android:hint="@string/notif_filter_label"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tilSearchNotifications">

                        <AutoCompleteTextView
                            android:id="@+id/dropdownNotificationStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:inputType="none"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="@string/notif_filter_all_label"
                            android:textColor="@color/velocity_text_primary"
                            android:textSize="14sp"
                            tools:ignore="LabelFor" />
                    </com.google.android.material.textfield.TextInputLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    app:contentInsetStart="0dp"
                    app:layout_collapseMode="pin">
                    <include
                        android:id="@+id/header"
                        layout="@layout/guest_header"
                        android:layout_width="match_parent"
                        android:layout_height="72dp" />
                </androidx.appcompat.widget.Toolbar>

            </com.google.android.material.appbar.CollapsingToolbarLayout>

            <!-- The summary row: a plain full-width row on the page background, aligned with the content padding (no rounded card). -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutNotifSummaryRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/velocity_sticky_bar_bg"
                android:minHeight="48dp"
                android:paddingStart="22dp"
                android:paddingEnd="14dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/velocity_divider_hairline"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <!-- "12 unread" (or "You're all caught up" only when nothing is unread) at the start, "Mark all as read" at the end
                     (hidden at 0 unread). The summary is bounded by the button so a large font wraps it instead of running underneath. -->
                <TextView
                    android:id="@+id/tvUnreadSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btnMarkAllRead"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="12 unread" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMarkAllRead"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0"
                    android:minHeight="48dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/mark_all_read_label"
                    android:textAllCaps="false"
                    android:textColor="@color/velocity_red_primary"
                    android:textSize="13sp"
                    app:cornerRadius="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:rippleColor="@color/velocity_red_soft" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- The list is the direct scrolling child: a RecyclerView that recycles its rows (it used to sit
             in a NestedScrollView at wrap_content height, which inflated every row at once and meant it
             never scrolled by itself - so scroll-based paging could never fire). The collapsing header
             still collapses, through the standard nested-scroll chain. -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingTop="6dp"
                    android:paddingBottom="90dp"
                    tools:listitem="@layout/item_notification" />

                <!-- Empty / load-error state (scrolls on its own so a short screen or a big font can
                     still reach its button). -->
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/scrollEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:overScrollMode="never"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <include
                        android:id="@+id/layoutEmptyState"
                        layout="@layout/view_empty_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </androidx.core.widget.NestedScrollView>

                <!-- First-load-only indicator - shown in place of (never alongside) both the list and
                     the empty state, exactly once per screen open, while nothing has loaded yet. -->
                <LinearLayout
                    android:id="@+id/layoutInitialLoading"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <ProgressBar
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:indeterminateTint="@color/velocity_red_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/loading_notifications_label"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        style="@style/Widget.VelocitySuites.NavigationView"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/velocity_surface_elevated"
        app:headerLayout="@layout/nav_header_guest"
        app:menu="@menu/menu_dashboard" />

</androidx.drawerlayout.widget.DrawerLayout>
