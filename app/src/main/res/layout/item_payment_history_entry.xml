<?xml version="1.0" encoding="utf-8"?>
<!-- One payment = one card: the amount leads, then who/how (method + status chip), when, the reference, and - for a
     cash payment that recorded what was handed over - the cash received and the change returned. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Velocity.Card.Flat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHistoryAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/velocity_text_primary"
                android:textSize="20sp"
                tools:text="₱6,600.00" />

            <TextView
                android:id="@+id/tvHistoryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/shape_flat_badge"
                android:backgroundTint="@color/velocity_red_subtle"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textAllCaps="true"
                android:textColor="@color/velocity_red_primary"
                android:textSize="12sp"
                tools:text="Completed" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHistoryMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/velocity_text_primary"
            android:textSize="14sp"
            tools:text="GCash" />

        <TextView
            android:id="@+id/tvHistoryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="12sp"
            tools:text="Oct 12, 2026 3:45 PM" />

        <TextView
            android:id="@+id/tvHistoryReference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Ref: 1234567890123"
            tools:visibility="visible" />

        <!-- Cash only: shown when the payment recorded what the guest handed over. -->
        <LinearLayout
            android:id="@+id/layoutHistoryCash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/receipt_cash_received_label"
                    android:textColor="@color/velocity_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvHistoryCashReceived"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="12sp"
                    tools:text="₱7,000.00" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/receipt_change_label"
                    android:textColor="@color/velocity_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvHistoryChange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="12sp"
                    tools:text="₱400.00" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
