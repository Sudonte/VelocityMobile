<?xml version="1.0" encoding="utf-8"?>
<!-- Compact row for "Other Recent and Upcoming Stays": only what identifies the transaction - reference, type, date and
     status. Everything else lives in Upcoming Hotel Transactions and Transaction History. Tapping opens that transaction
     in Upcoming Hotel Transactions. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardStayCompact"
    style="@style/Widget.Velocity.Card.Flat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStayCompactRef"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:textColor="@color/velocity_red_primary"
                android:textSize="14sp"
                tools:text="Booking #338" />

            <TextView
                android:id="@+id/tvStayCompactWhen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="12sp"
                tools:text="Check-in Oct 20, 2026" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStayCompactStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/shape_intro_pill"
            android:fontFamily="sans-serif-black"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textSize="12sp"
            tools:text="Confirmed" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:alpha="0.4"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/velocity_text_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
