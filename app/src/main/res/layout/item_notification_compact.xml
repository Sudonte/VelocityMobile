<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardNotificationCompact"
    style="@style/Widget.Velocity.Card.Glass.Compact"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card_white"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/rowNotifCompactHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/iconContainerNotifCompact"
                android:layout_width="34dp"
                android:layout_height="34dp"
                app:cardBackgroundColor="@color/velocity_blue_soft"
                app:cardCornerRadius="11dp"
                app:cardElevation="0dp">
                <ImageView
                    android:id="@+id/ivNotifCompactIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/velocity_blue_primary" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvNotifCompactTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/black"
                android:textSize="13sp"
                tools:text="Reservation Confirmation" />

            <TextView
                android:id="@+id/tvNotifCompactTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/velocity_inactive_gray"
                android:textSize="10sp"
                android:textAllCaps="true"
                tools:text="10:30 AM" />

            <View
                android:id="@+id/unreadDotCompact"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_notification_dot"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:alpha="0.4"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/velocity_text_secondary" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNotifCompactViewDetails"
            style="@style/Widget.Velocity.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:text="@string/view_details"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
