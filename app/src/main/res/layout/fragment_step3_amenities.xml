<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="20dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Velocity.Card.Glass.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card_white"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="16dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        app:cardBackgroundColor="@color/velocity_red_soft"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_services"
                            app:tint="@color/velocity_red_primary" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Velocity.Label.Section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/addon_amenities_label"
                            android:textColor="@color/velocity_text_primary"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/addon_amenities_notice"
                            android:textColor="@color/velocity_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSkipAmenities"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:maxWidth="90dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/skip_amenities_button"
                        android:textAllCaps="false"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutAmenitiesItemsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Running count/subtotal of selected amenities - only
                     shown once at least one is selected, kept in sync from
                     Step3AmenitiesFragment#updateSelectedSummary(). -->
                <LinearLayout
                    android:id="@+id/layoutAmenitiesSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/shape_notice_box_red"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tvSelectedAmenitiesCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        tools:text="Selected Amenities: 2" />

                    <TextView
                        android:id="@+id/tvSelectedAmenitiesSubtotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-black"
                        tools:text="₱1,200.00" />
                </LinearLayout>

                <!-- Shown for either a genuinely empty catalog or a failed
                     load - Step3AmenitiesFragment swaps the text and the
                     retry button's visibility depending on which. -->
                <LinearLayout
                    android:id="@+id/layoutAmenitiesEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvAmenitiesEmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/addon_amenities_empty"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRetryAmenities"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/retry_label"
                        android:textAllCaps="false"
                        app:strokeColor="@color/velocity_red_primary"
                        android:textColor="@color/velocity_red_primary"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
