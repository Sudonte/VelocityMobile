<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/velocity_red_bg_end"
    android:orientation="vertical"
    tools:context=".BillingSummaryActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="20dp"
        android:paddingTop="44dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/btnBillingBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_label"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/velocity_red_primary" />

        <TextView
            style="@style/TextAppearance.Velocity.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/billing_summary_title"
            android:textColor="@color/velocity_red_primary"
            android:textSize="18sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Booking Summary: reference + status -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/velocity_red_primary"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvBillingRef"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/booking_ref_label"
                            android:textColor="#E6FFFFFF"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvBillingStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/shape_intro_pill"
                            android:backgroundTint="#40000000"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.05"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="@string/status_pending"
                            android:textColor="@color/white"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvBillingRoomHeadline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/no_room_selected"
                        android:textColor="@color/white"
                        android:textSize="20sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Guest Information -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Velocity.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card_white"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/TextAppearance.Velocity.Label.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:drawablePadding="8dp"
                        android:text="@string/guest_information_title"
                        app:drawableStartCompat="@drawable/ic_reservation"
                        app:drawableTint="@color/velocity_red_primary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/guest_account_label" android:textColor="@color/velocity_text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                        <TextView android:id="@+id/tvBillingPrimaryGuest" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:gravity="end" android:textAlignment="viewEnd" android:text="@string/not_specified" android:textColor="@color/velocity_text_primary" android:textSize="14sp" android:fontFamily="sans-serif-bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/details_label_representative_name" android:textColor="@color/velocity_text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                        <TextView android:id="@+id/tvBillingRepresentativeName" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:gravity="end" android:textAlignment="viewEnd" android:text="@string/not_provided_label" android:textColor="@color/velocity_text_primary" android:textSize="14sp" android:fontFamily="sans-serif-bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/total_guests_label" android:textColor="@color/velocity_text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                        <TextView android:id="@+id/tvBillingGuestCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/guests_count_format" android:textColor="@color/velocity_text_primary" android:textSize="14sp" android:fontFamily="sans-serif-bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutBillingIdType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/id_type_label" android:textColor="@color/velocity_text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                        <TextView android:id="@+id/tvBillingIdType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/no_id_uploaded" android:textColor="@color/velocity_text_primary" android:textSize="14sp" android:fontFamily="sans-serif-bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutBillingAdditionalGuestsSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="10dp"
                            android:background="@color/velocity_red_subtle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/details_additional_guests_header"
                            android:textColor="@color/velocity_text_secondary"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:id="@+id/layoutBillingAdditionalGuests"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stay Information -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Velocity.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card_white"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/TextAppearance.Velocity.Label.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:drawablePadding="8dp"
                        android:text="@string/room_and_stay_title"
                        app:drawableStartCompat="@drawable/ic_booking"
                        app:drawableTint="@color/velocity_red_primary" />

                    <!-- Legacy single-room-type display - shown only when this reservation has no
                         itemized room lines (see BillingSummaryActivity#updateBillingBreakdownAmounts());
                         hidden in favor of layoutBillingRoomsRows below whenever booking.getRooms()
                         has real data, so a multi-room-type reservation is never collapsed into one
                         fake averaged room row. -->
                    <LinearLayout
                        android:id="@+id/layoutBillingSingleRoomInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/room_type_summary_label" android:textColor="@color/velocity_text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                            <TextView android:id="@+id/tvBillingRoomType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/no_room_selected" android:textColor="@color/velocity_text_primary" android:textSize="14sp" android:fontFamily="sans-serif-bold"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/selected_room_quantity_label" android:textColor="@color/velocity_text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                            <TextView android:id="@+id/tvBillingRoomQuantity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/velocity_text_primary" android:textSize="14sp" android:fontFamily="sans-serif-bold" tools:text="2 Room(s)"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/room_rate_label" android:textColor="@color/velocity_text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                            <TextView android:id="@+id/tvBillingSingleRoomRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/velocity_text_primary" android:textSize="14sp" android:fontFamily="sans-serif-bold" tools:text="₱3,500.00 / Night"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/room_subtotal_per_night_label" android:textColor="@color/velocity_text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                            <TextView android:id="@+id/tvBillingRoomSubtotalPerNight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/velocity_text_primary" android:textSize="14sp" android:fontFamily="sans-serif-bold" tools:text="₱7,000.00"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Itemized per-room-type breakdown - one block per distinct room type/rate
                         the guest selected in this ONE reservation (see BookingRoom/Booking#getRooms()).
                         Populated dynamically by BillingSummaryActivity#buildRoomLineRow(); empty/gone
                         for a legacy reservation that only ever had one room type. -->
                    <LinearLayout
                        android:id="@+id/layoutBillingRoomsRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/velocity_red_subtle" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/stay_dates_summary_label" android:textColor="@color/velocity_text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                        <TextView android:id="@+id/tvBillingDates" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/summary_dates_placeholder" android:textColor="@color/velocity_text_primary" android:textSize="13sp" android:fontFamily="sans-serif-bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/nights_label" android:textColor="@color/velocity_text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                        <TextView android:id="@+id/tvBillingNights" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/zero_price" android:textColor="@color/velocity_text_primary" android:textSize="14sp" android:fontFamily="sans-serif-bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutBillingRoomRatePerNightRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/room_rate_per_night_label" android:textColor="@color/velocity_text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                        <TextView android:id="@+id/tvBillingRoomRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/velocity_text_primary" android:textSize="14sp" android:fontFamily="sans-serif-bold" tools:text="₱5,800.00"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/room_total_label" android:fontFamily="sans-serif-black" android:textColor="@color/velocity_text_primary" android:textSize="14sp"/>
                        <TextView android:id="@+id/tvBillingStayRoomAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-black" android:textColor="@color/velocity_red_dark" android:textSize="15sp" tools:text="₱17,400.00"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Payment Information: hidden entirely until a payment method/attempt actually exists on this reservation -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBillingPaymentInfo"
                style="@style/Widget.Velocity.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card_white"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/TextAppearance.Velocity.Label.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:drawablePadding="8dp"
                        android:text="@string/payment_information_title"
                        app:drawableStartCompat="@drawable/ic_payment_card"
                        app:drawableTint="@color/velocity_red_primary" />

                    <LinearLayout
                        android:id="@+id/layoutBillingPaymentMethod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/review_payment_method_label" android:textColor="@color/velocity_text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                        <TextView android:id="@+id/tvBillingPaymentMethod" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/velocity_text_primary" android:textSize="14sp" android:fontFamily="sans-serif-bold" tools:text="GCash"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutBillingPaymentType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/review_payment_type_label" android:textColor="@color/velocity_text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                        <TextView android:id="@+id/tvBillingPaymentType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/velocity_text_primary" android:textSize="14sp" android:fontFamily="sans-serif-bold" tools:text="Partial Payment"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutBillingPaymentStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/payment_status" android:textColor="@color/velocity_text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                        <TextView android:id="@+id/tvBillingPaymentStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/velocity_text_primary" android:textSize="14sp" android:fontFamily="sans-serif-bold" tools:text="Pending Verification"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Add-on Amenities -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBillingAmenities"
                style="@style/Widget.Velocity.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card_white"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/TextAppearance.Velocity.Label.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:drawablePadding="8dp"
                        android:text="@string/billing_amenities_title"
                        app:drawableStartCompat="@drawable/ic_booking"
                        app:drawableTint="@color/velocity_red_primary" />

                    <TextView
                        android:id="@+id/tvNoAmenitiesMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/no_paid_amenities_message"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="13sp"
                        android:alpha="0.75"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/layoutBillingAmenitiesRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/velocity_red_subtle" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/total_amenities_amount_label" android:fontFamily="sans-serif-black" android:textColor="@color/velocity_text_primary" android:textSize="14sp"/>
                        <TextView android:id="@+id/tvAmenitiesSectionTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-black" android:textColor="@color/velocity_red_dark" android:textSize="15sp" tools:text="₱1,200.00"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Billing Breakdown -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Velocity.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card_white"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/TextAppearance.Velocity.Label.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:drawablePadding="8dp"
                        android:text="@string/payment_breakdown_title"
                        app:drawableStartCompat="@drawable/ic_payment_card"
                        app:drawableTint="@color/velocity_red_primary" />

                    <LinearLayout
                        android:id="@+id/layoutBillingBreakdownRoomRateRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/room_rate_per_night_label" android:textColor="@color/velocity_text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                        <TextView android:id="@+id/tvBillingBreakdownRoomRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/velocity_text_primary" android:textSize="14sp" android:fontFamily="sans-serif-bold" tools:text="₱5,800.00"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/nights_label" android:textColor="@color/velocity_text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                        <TextView android:id="@+id/tvBillingBreakdownNights" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/velocity_text_primary" android:textSize="14sp" android:fontFamily="sans-serif-bold" tools:text="3"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/total_room_stay_amount_label" android:textColor="@color/velocity_text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                        <TextView android:id="@+id/tvBillingRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/velocity_text_primary" android:textSize="14sp" android:fontFamily="sans-serif-bold" tools:text="₱17,400.00"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/total_amenities_amount_label" android:textColor="@color/velocity_text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                        <TextView android:id="@+id/tvBillingTotalAmenities" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/velocity_text_primary" android:textSize="14sp" android:fontFamily="sans-serif-bold" tools:text="₱1,800.00"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutBillingDiscount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/discount_applied_label" android:textColor="@color/velocity_text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                        <TextView android:id="@+id/tvBillingDiscount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/placeholder_amount" android:textColor="@color/velocity_green_dark" android:textSize="14sp" android:fontFamily="sans-serif-bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutBillingSelectedPayment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/selected_payment_label" android:textColor="@color/velocity_text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                        <TextView android:id="@+id/tvBillingSelectedPayment" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/placeholder_amount" android:textColor="@color/velocity_text_primary" android:textSize="14sp" android:fontFamily="sans-serif-bold"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/velocity_red_subtle" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/grand_total_label" android:fontFamily="sans-serif-black" android:textColor="@color/velocity_red_dark" android:textSize="15sp" android:textAllCaps="true" android:letterSpacing="0.03"/>
                        <TextView android:id="@+id/tvBillingBalanceDue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-black" android:textColor="@color/velocity_red_primary" android:textSize="20sp" tools:text="₱7,000.00"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Terms & Cancellation Policy -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Velocity.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card_white"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/TextAppearance.Velocity.Label.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:drawablePadding="8dp"
                        android:text="@string/terms_and_agreement_title"
                        app:drawableStartCompat="@drawable/ic_lock"
                        app:drawableTint="@color/velocity_red_primary" />

                    <LinearLayout
                        android:id="@+id/tvViewBillingTerms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="4dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_info"
                            app:tint="@color/velocity_red_primary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/view_terms_link_label"
                            android:textColor="@color/velocity_red_primary"
                            android:textSize="13sp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_expand_more"
                            android:rotation="-90"
                            app:tint="@color/velocity_red_primary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/velocity_red_subtle" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbAcceptBillingTerms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/terms_read_accepted_label"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="13sp"
                        app:buttonTint="@color/velocity_red_primary" />

                    <TextView
                        android:id="@+id/tvBillingTermsHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginStart="36dp"
                        android:text="@string/terms_view_required_hint"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom bar: Confirm Booking, bottom-right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="12dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmBilling"
            style="@style/Widget.Velocity.Button"
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:enabled="false"
            android:paddingHorizontal="24dp"
            android:text="@string/confirm_booking_label"
            android:textSize="15sp"
            app:icon="@drawable/ic_payment_card"
            app:iconGravity="textStart"
            app:iconPadding="10dp" />
    </LinearLayout>

</LinearLayout>
