<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Velocity.Card.Glass.Compact"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card_white"
        android:orientation="vertical"
        android:padding="11dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivPaymentRoomImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@color/velocity_red_soft"
                    android:contentDescription="@string/cd_room_image" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Transaction type - always shown so it's never ambiguous whether this
                     card is a view-only Booking or a still-payable Reservation, regardless
                     of payment/verification status shown elsewhere on the card. -->
                <TextView
                    android:id="@+id/tvTransactionTypePill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:background="@drawable/shape_intro_pill"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textAllCaps="true"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="RESERVATION" />

                <TextView
                    android:id="@+id/tvPaymentRoomName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/executive_suite"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvTransactionRef"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/transaction_ref_format"
                    android:textColor="@color/velocity_text_secondary"
                    android:textSize="10sp"
                    android:alpha="0.7"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="TRX-12345" />

                <TextView
                    android:id="@+id/tvPaymentMethod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/velocity_text_secondary"
                    android:textSize="10sp"
                    android:alpha="0.7"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone"
                    tools:text="Payment Method: GCash"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvPaymentDeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/shape_intro_pill"
                    android:backgroundTint="@color/velocity_red_subtle"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/velocity_red_primary"
                    android:textSize="9sp"
                    android:visibility="gone"
                    tools:text="Pay by Aug 30, 11:39 PM"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxWidth="120dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvPaymentStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:background="@drawable/shape_intro_pill"
                    android:backgroundTint="@color/velocity_red_subtle"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="@string/status_pending"
                    android:textColor="@color/velocity_red_primary"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Verification Status - distinct from Payment Status above: e.g. a
                     GCash payment can already be "Partially Paid" while still
                     "Pending Verification" until a receptionist reviews the receipt.
                     Hidden when there's no payment attempt to verify yet. -->
                <TextView
                    android:id="@+id/tvVerificationStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/shape_intro_pill"
                    android:backgroundTint="@color/velocity_gray_soft"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/velocity_inactive_gray"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="PENDING VERIFICATION" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_amount"
                    android:textSize="9sp"
                    android:textAllCaps="true"
                    android:textColor="@color/velocity_inactive_gray"
                    android:fontFamily="sans-serif-bold"/>
                <TextView
                    android:id="@+id/tvTotalAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/zero_price"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/paid_column_label"
                    android:textSize="9sp"
                    android:textAllCaps="true"
                    android:textColor="@color/velocity_inactive_gray"
                    android:fontFamily="sans-serif-bold"/>
                <TextView
                    android:id="@+id/tvAmountPaid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/zero_price"
                    android:textColor="@color/velocity_green_primary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutPaymentRemainingBalance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/remaining_balance_label"
                    android:textSize="9sp"
                    android:textAllCaps="true"
                    android:textColor="@color/velocity_inactive_gray"
                    android:fontFamily="sans-serif-bold"/>
                <TextView
                    android:id="@+id/tvPaymentRemainingBalance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/zero_price"
                    android:textColor="@color/velocity_red_primary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/view_details_label"
                    android:textColor="@color/velocity_red_primary"
                    android:textSize="11sp"
                    android:alpha="0.85" />

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginStart="2dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/velocity_red_primary" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickPay"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/pay_now"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:backgroundTint="@color/velocity_red_primary"
                app:cornerRadius="14dp"
                tools:visibility="visible" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
