<?xml version="1.0" encoding="utf-8"?>
<!-- One additional-amenity request in the Payment Details list: item x qty, status chip (icon + colour + text), prices, and for a rejection the reason. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAmenityRequestName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/velocity_text_primary"
            android:textSize="14sp"
            tools:text="Extra Bed × 2" />

        <TextView
            android:id="@+id/tvAmenityRequestStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/shape_intro_pill"
            android:fontFamily="sans-serif-black"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textSize="12sp"
            tools:backgroundTint="@color/velocity_orange_soft"
            tools:text="Pending"
            tools:textColor="@color/velocity_orange_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAmenityRequestPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/velocity_text_secondary"
        android:textSize="12sp"
        tools:text="₱200.00 each  •  ₱400.00" />

    <TextView
        android:id="@+id/tvAmenityRequestReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/velocity_red_status_dark"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Reason: Out of stock today"
        tools:visibility="visible" />
</LinearLayout>
