<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/velocity_red_bg_end">

    <LinearLayout
        android:id="@+id/wizardHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="40dp"
        android:paddingBottom="16dp"
        android:background="@color/velocity_red_primary">

        <ImageButton
            android:id="@+id/btnWizardBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvWizardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/white"
            android:textSize="18sp"
            tools:ignore="MissingConstraints"
            tools:text="New Booking" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvWizardStepLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/velocity_red_primary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="2dp"
            tools:text="Step 1 of 7 - Room Selection" />

        <TextView
            android:id="@+id/tvWizardStepsRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"
            tools:text="6 steps remaining" />

        <com.example.velocitysuites.WizardStepIndicatorView
            android:id="@+id/wizardStepIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/wizardFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Shown only while an Edit Reservation is waiting for the room catalog (see BookingWizardActivity#loadRoomsForEditThenShow()). -->
        <ProgressBar
            android:id="@+id/wizardLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>

    <!-- What the guest has picked so far: dates, rooms, guests and the running total. -->
    <TextView
        android:id="@+id/wizardSummaryBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_flat_box"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="@color/velocity_text_primary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone"
        tools:text="Oct 08 - Oct 10 • 2 rooms • 3 guests • ₱6,000.00"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"
        android:background="@drawable/bg_flat_box">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWizardPrevious"
            style="@style/Widget.Velocity.Flat.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
        android:minHeight="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/back_label"
            app:strokeColor="@color/velocity_red_primary"
            android:textColor="@color/velocity_red_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWizardNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
        android:minHeight="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/next_label"
            app:backgroundTint="@color/velocity_red_primary" />
    </LinearLayout>
</LinearLayout>
