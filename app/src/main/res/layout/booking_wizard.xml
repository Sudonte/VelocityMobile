<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/wizardRoot"
    android:orientation="vertical"
    android:background="@color/velocity_red_bg_end">

    <LinearLayout
        android:id="@+id/wizardHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:background="@color/velocity_red_primary">

        <ImageButton
            android:id="@+id/btnWizardBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvWizardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/white"
            android:textSize="16sp"
            tools:ignore="MissingConstraints"
            tools:text="New Booking" />
    </LinearLayout>

    <!-- Step header: "Step X of Y", the step's name, and a progress bar - the same on every step of every flow. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvWizardStepName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="2"
                android:textColor="@color/velocity_text_primary"
                android:textSize="18sp"
                tools:text="Room Selection" />

            <TextView
                android:id="@+id/tvWizardStepLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/velocity_red_primary"
                android:textSize="13sp"
                tools:text="Step 2 of 8" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/wizardProgressBar"
            android:saveEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="25"
            app:indicatorColor="@color/velocity_red_primary"
            app:trackColor="@color/velocity_red_soft"
            app:trackCornerRadius="4dp"
            app:trackThickness="8dp" />

        <TextView
            android:id="@+id/tvWizardStepsRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="12sp"
            tools:text="6 steps remaining" />

        <!-- Kept for the tests/legacy code that still sets it; the progress bar above replaces it visually
             (eight numbered chips do not fit a 360dp screen). -->
        <com.example.velocitysuites.WizardStepIndicatorView
            android:id="@+id/wizardStepIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/wizardFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Shown only while an Edit Reservation is waiting for the room catalog (see BookingWizardActivity#loadRoomsForEditThenShow()). -->
        <ProgressBar
            android:id="@+id/wizardLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>

    <!-- What the guest has picked so far: dates, rooms, guests and the running total. -->
    <LinearLayout
        android:id="@+id/wizardSummaryBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/velocity_red_soft"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/wizardSummaryLeft"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/velocity_text_primary"
                android:textSize="12sp"
                tools:text="2 stays · 4 rooms · 1 guest" />

            <TextView
                android:id="@+id/wizardSummaryTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-black"
                android:gravity="end"
                android:textColor="@color/velocity_text_primary"
                android:textSize="14sp"
                tools:text="₱18,600.00" />
        </LinearLayout>

        <TextView
            android:id="@+id/wizardSummaryBreakdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="end"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="Rooms ₱18,600.00 + Amenities ₱300.00 = ₱18,900.00"
            tools:visibility="visible" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/velocity_divider_hairline" />

    <LinearLayout
        android:id="@+id/wizardButtonBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="22dp"
        android:paddingVertical="12dp"
        android:background="@color/velocity_surface_elevated">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWizardPrevious"
            style="@style/Widget.Velocity.Flat.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:textAllCaps="false"
            android:text="@string/back_label"
            app:strokeColor="@color/velocity_red_primary"
            android:textColor="@color/velocity_red_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWizardNext"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textAllCaps="false"
            android:text="@string/next_label"
            app:backgroundTint="@color/velocity_red_primary" />
    </LinearLayout>
</LinearLayout>
