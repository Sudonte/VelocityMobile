<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/velocity_red_bg_end">

    <LinearLayout
        android:id="@+id/wizardHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp"
        android:background="@color/velocity_red_primary"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnWizardBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvWizardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/white"
            android:textSize="18sp"
            tools:ignore="MissingConstraints"
            tools:text="New Booking" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvWizardStepLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/velocity_red_primary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="2dp"
            tools:text="Step 1 of 7 - Room Selection" />

        <TextView
            android:id="@+id/tvWizardStepsRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="11sp"
            android:layout_marginBottom="8dp"
            tools:text="6 steps remaining" />

        <com.example.velocitysuites.WizardStepIndicatorView
            android:id="@+id/wizardStepIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/wizardFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:background="@color/velocity_surface_elevated"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWizardPrevious"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/back_label"
            app:strokeColor="@color/velocity_red_primary"
            android:textColor="@color/velocity_red_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWizardNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/next_label"
            app:backgroundTint="@color/velocity_red_primary" />
    </LinearLayout>
</LinearLayout>
