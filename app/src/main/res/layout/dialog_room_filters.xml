<?xml version="1.0" encoding="utf-8"?>
<!-- Filter rooms (a bottom sheet, RoomBrowsingActivity#showFilterDialog): a fully OPAQUE surface in light and dark mode - the page
     shows only through the sheet's dim scrim, never through the sheet. Header, two labelled dropdowns, Guests, Price per night, footer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/roomFilterSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/velocity_surface_elevated"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/tvFilterTitle"
            style="@style/TextAppearance.Velocity.Section.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/filter_rooms_title" />

        <ImageButton
            android:id="@+id/btnCloseFilters"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close_label"
            android:src="@drawable/ic_close"
            app:tint="@color/velocity_text_secondary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp">

            <!-- Room type: filters on the room's TYPE name (Deluxe, Suite ...). -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRoomTypeFilter"
                style="@style/Widget.Velocity.TextInputLayout.Filter.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/room_type_row_label">

                <AutoCompleteTextView
                    android:id="@+id/dropdownRoomType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:inputType="none"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="14sp"
                    tools:ignore="LabelFor" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Availability: filters on whether the room can be booked (Available / Limited availability / Unavailable). -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStatusFilter"
                style="@style/Widget.Velocity.TextInputLayout.Filter.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/room_status_row_label">

                <AutoCompleteTextView
                    android:id="@+id/dropdownStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:inputType="none"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="14sp"
                    tools:ignore="LabelFor" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvGuestsHeader"
                style="@style/TextAppearance.Velocity.Section.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/guests_header" />

            <!-- Four equal buttons in one row; selected = soft red fill + red text + red border, unselected = page surface. -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/capacityChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipAnyCap"
                    style="@style/Widget.Velocity.Flat.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:backgroundTint="@color/guest_chip_bg"
                    android:letterSpacing="0"
                    android:text="@string/any_guests"
                    android:textColor="@color/guest_chip_text"
                    android:textSize="13sp"
                    app:strokeColor="@color/guest_chip_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip12"
                    style="@style/Widget.Velocity.Flat.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:backgroundTint="@color/guest_chip_bg"
                    android:letterSpacing="0"
                    android:text="@string/guests_1_2_short"
                    android:textColor="@color/guest_chip_text"
                    android:textSize="13sp"
                    app:strokeColor="@color/guest_chip_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip34"
                    style="@style/Widget.Velocity.Flat.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:backgroundTint="@color/guest_chip_bg"
                    android:letterSpacing="0"
                    android:text="@string/guests_3_4_short"
                    android:textColor="@color/guest_chip_text"
                    android:textSize="13sp"
                    app:strokeColor="@color/guest_chip_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip5plus"
                    style="@style/Widget.Velocity.Flat.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:backgroundTint="@color/guest_chip_bg"
                    android:letterSpacing="0"
                    android:text="@string/guests_5_plus_short"
                    android:textColor="@color/guest_chip_text"
                    android:textSize="13sp"
                    app:strokeColor="@color/guest_chip_stroke" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPriceHeader"
                    style="@style/TextAppearance.Velocity.Section.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/price_per_night_header" />

                <TextView
                    android:id="@+id/tvPriceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:maxLines="1"
                    android:textColor="@color/velocity_action_text"
                    android:textSize="13sp"
                    tools:text="₱1,500 – ₱15,000" />
            </LinearLayout>

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/priceSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:stepSize="100"
                android:valueFrom="0"
                android:valueTo="1000"
                app:haloColor="@color/velocity_red_soft"
                app:thumbColor="@color/velocity_red_primary"
                app:thumbElevation="0dp"
                app:thumbRadius="10dp"
                app:trackColorActive="@color/velocity_red_primary"
                app:trackColorInactive="@color/velocity_red_soft"
                app:trackHeight="6dp"
                app:values="@array/room_price_default_values" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/velocity_divider_hairline"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearAll"
            style="@style/Widget.Velocity.Flat.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0"
            android:minHeight="48dp"
            android:text="@string/clear_label"
            android:textColor="@color/velocity_action_text"
            android:textSize="14sp"
            app:strokeColor="@color/velocity_red_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyFilters"
            style="@style/Widget.Velocity.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.6"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0"
            android:minHeight="48dp"
            android:text="@string/show_no_rooms"
            android:textAllCaps="false"
            android:textColor="@color/button_primary_text"
            android:textSize="14sp"
            app:backgroundTint="@color/button_primary_bg" />
    </LinearLayout>
</LinearLayout>
