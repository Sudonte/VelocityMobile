<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Velocity.Card.Glass"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card_white"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvFilterTitle"
            style="@style/TextAppearance.Velocity.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_rooms_title"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseFilters"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:backgroundTint="@color/velocity_red_soft"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_close"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="16dp"
            app:iconTint="@color/velocity_red_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:rippleColor="@color/white" />

        <View
            android:id="@+id/filterDividerTop"
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/shape_intro_pill"
            android:backgroundTint="@color/velocity_red_soft"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvFilterTitle" />

        <!-- Capacity Section -->
        <LinearLayout
            android:id="@+id/capacitySectionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/shape_search_field"
            android:backgroundTint="@color/velocity_red_bg_end"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/filterDividerTop">

            <LinearLayout
                android:id="@+id/capacityLabelContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/velocity_red_primary"
                    android:importantForAccessibility="no" />

                <TextView
                    style="@style/TextAppearance.Velocity.Label.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/capacity_label"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/capacityChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="6dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAnyCap"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/any_capacity"
                    android:textSize="11sp"
                    app:chipBackgroundColor="@color/white"
                    app:chipStrokeColor="@color/velocity_red_subtle"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip12"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guests_1_2"
                    android:textSize="11sp"
                    app:chipBackgroundColor="@color/white"
                    app:chipStrokeColor="@color/velocity_red_subtle"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip34"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guests_3_4"
                    android:textSize="11sp"
                    app:chipBackgroundColor="@color/white"
                    app:chipStrokeColor="@color/velocity_red_subtle"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip5plus"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guests_5_plus"
                    android:textSize="11sp"
                    app:chipBackgroundColor="@color/white"
                    app:chipStrokeColor="@color/velocity_red_subtle"
                    app:chipStrokeWidth="1dp" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Price Range Section -->
        <LinearLayout
            android:id="@+id/priceSectionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/shape_search_field"
            android:backgroundTint="@color/velocity_red_bg_end"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/capacitySectionCard">

            <LinearLayout
                android:id="@+id/priceHeaderContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginBottom="2dp"
                    android:src="@drawable/ic_payment"
                    app:tint="@color/velocity_red_primary"
                    android:importantForAccessibility="no" />

                <TextView
                    style="@style/TextAppearance.Velocity.Label.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/price_range_label"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvPriceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/velocity_red_primary"
                    android:textSize="13sp"
                    tools:text="Budget: Under ₱10,000" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/priceSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:stepSize="500"
                android:value="10000"
                android:valueFrom="1000"
                android:valueTo="15000"
                app:haloColor="@color/velocity_red_soft"
                app:thumbColor="@color/velocity_red_primary"
                app:thumbElevation="4dp"
                app:thumbRadius="10dp"
                app:trackColorActive="@color/velocity_red_primary"
                app:trackColorInactive="@color/velocity_red_soft"
                app:trackHeight="6dp" />
        </LinearLayout>

        <View
            android:id="@+id/filterDividerBottom"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:alpha="0.3"
            android:background="@color/velocity_red_subtle"
            app:layout_constraintTop_toBottomOf="@id/priceSectionCard" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/filterDividerBottom">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearAll"
                style="@style/Widget.Velocity.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:text="@string/reset_label"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyFilters"
                style="@style/Widget.Velocity.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1.6"
                android:text="@string/apply_filters"
                android:textSize="13sp" />
        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
