<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Velocity.Card.Glass.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card_white"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        app:cardBackgroundColor="@color/velocity_red_soft"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_person"
                            app:tint="@color/velocity_red_primary" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Velocity.Label.Section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/who_is_staying_label"
                            android:textColor="@color/velocity_text_primary"
                            android:textSize="12sp" />

                        <TextView
                            style="@style/TextAppearance.Velocity.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/who_is_staying_hint"
                            android:textColor="@color/velocity_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/required_fields_note"
                    android:textColor="@color/velocity_red_primary"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />

                <!-- Last Name: static top-left label, always visible (not a
                     floating Material hint) - the label never depends on
                     focus/typed-text state, per spec. The field's own hint
                     is just an inline placeholder (hintEnabled=false so it
                     never doubles as a second, redundant label). -->
                <TextView
                    style="@style/TextAppearance.Velocity.Label.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/guest_last_name_hint"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPrimaryGuestLastName"
                    style="@style/Widget.Velocity.TextInputLayout.OutlinedBox.Rounded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/velocity_red_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPrimaryGuestLastName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/guest_last_name_placeholder"
                        android:textColorHint="@color/velocity_text_secondary"
                        android:inputType="textPersonName"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- First Name: same static-label pattern as Last Name. -->
                <TextView
                    style="@style/TextAppearance.Velocity.Label.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/guest_first_name_hint"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPrimaryGuestFirstName"
                    style="@style/Widget.Velocity.TextInputLayout.OutlinedBox.Rounded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/velocity_red_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPrimaryGuestFirstName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/guest_first_name_placeholder"
                        android:textColorHint="@color/velocity_text_secondary"
                        android:inputType="textPersonName"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Middle Name: same pattern, de-emphasized icon tint since
                     it's the one optional field. -->
                <TextView
                    style="@style/TextAppearance.Velocity.Label.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/middle_name_label"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPrimaryGuestMiddleName"
                    style="@style/Widget.Velocity.TextInputLayout.OutlinedBox.Rounded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/velocity_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPrimaryGuestMiddleName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/middle_name_placeholder"
                        android:textColorHint="@color/velocity_text_secondary"
                        android:inputType="textPersonName"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
