<?xml version="1.0" encoding="utf-8"?>
<!-- Reset password in three short steps (email, code, new password) under the SAME header as Sign in (view_auth_header). Everything
     sits in one vertical column below the header, so nothing can be drawn over the logo; the back arrow floats on the red curve. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/resetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_introduction"
    tools:context=".ResetPasswordActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/resetScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/resetColumn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <include
                android:id="@+id/resetHeader"
                layout="@layout/view_auth_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/resetHeadingBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/resetHeading"
                    style="@style/TextAppearance.Velocity.ScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="@string/reset_step1_title"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/resetStepLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.85"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="@color/velocity_text_secondary"
                    android:textSize="12sp"
                    tools:text="Step 1 of 3 · Your email" />
            </LinearLayout>

            <!-- Why this screen opened (after three failed sign-ins) -->
            <TextView
                android:id="@+id/resetBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/velocity_red_subtle"
                android:fontFamily="sans-serif-medium"
                android:padding="12dp"
                android:text="@string/reset_banner_trouble"
                android:textColor="@color/velocity_text_primary"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- ============ Step 1: your email ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/resetStep1"
                style="@style/Widget.Velocity.Card.Glass.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_gradient_light"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp">

                    <ImageView
                        android:id="@+id/resetLockIcon"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/bg_icon_circle_red_soft"
                        android:importantForAccessibility="no"
                        android:padding="14dp"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/velocity_red_primary" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/resetEmailLayout"
                        style="@style/Widget.Velocity.TextInputLayout.OutlinedBox.Floating"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/login_email_hint"
                        app:helperText="@string/reset_email_helper"
                        app:helperTextEnabled="true"
                        app:startIconDrawable="@drawable/ic_email">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/resetEmailEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:imeOptions="actionSend"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:paddingVertical="13dp"
                            android:textColor="@color/velocity_text_primary"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/resetEmailError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:accessibilityLiveRegion="polite"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/velocity_action_text"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sendCodeButton"
                        style="@style/Widget.Velocity.Button"
                        android:layout_width="match_parent"
                        android:layout_marginTop="12dp"
                        android:text="@string/reset_send_code" />

                    <TextView
                        android:id="@+id/backToSignInLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:paddingHorizontal="12dp"
                        android:text="@string/back_to_sign_in"
                        android:textColor="@color/velocity_action_text"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Step 2: the code ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/resetStep2"
                style="@style/Widget.Velocity.Card.Glass.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_gradient_light"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp">

                    <TextView
                        android:id="@+id/resetCodeDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="14sp"
                        tools:text="We sent a 6-digit code to j***@gmail.com" />

                    <TextView
                        android:id="@+id/resetSentNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/reset_generic_sent"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/resetOtpBoxes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/resetCodeError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:accessibilityLiveRegion="polite"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/velocity_action_text"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/resetCodeChecking"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/verifying"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/resetResendLink"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:text="@string/reg_resend_code"
                            android:textColor="@color/velocity_action_text"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/resetChangeEmailLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:text="@string/reg_change_email"
                            android:textColor="@color/velocity_action_text"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Step 3: a new password ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/resetStep3"
                style="@style/Widget.Velocity.Card.Glass.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_gradient_light"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/resetNewPasswordLayout"
                        style="@style/Widget.Velocity.TextInputLayout.OutlinedBox.Floating"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/new_password_hint"
                        app:passwordToggleEnabled="true"
                        app:startIconDrawable="@drawable/ic_lock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/resetNewPasswordEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:paddingVertical="13dp"
                            android:textColor="@color/velocity_text_primary"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/resetConfirmPasswordLayout"
                        style="@style/Widget.Velocity.TextInputLayout.OutlinedBox.Floating"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/confirm_password_label"
                        app:passwordToggleEnabled="true"
                        app:startIconDrawable="@drawable/ic_lock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/resetConfirmPasswordEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:paddingVertical="13dp"
                            android:textColor="@color/velocity_text_primary"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- The same checklist and strength bar as sign-up and change password -->
                    <com.example.velocitysuites.PasswordRulesView
                        android:id="@+id/resetPasswordRules"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/resetSaveError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:accessibilityLiveRegion="polite"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/velocity_action_text"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/saveAndSignInButton"
                        style="@style/Widget.Velocity.Button"
                        android:layout_width="match_parent"
                        android:layout_marginTop="12dp"
                        android:text="@string/reset_save_and_sign_in" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Back: a plain white arrow on the red header (48dp touch target), same place as on Sign in -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back_label"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>
