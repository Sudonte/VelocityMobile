<?xml version="1.0" encoding="utf-8"?>
<!-- The header shared by Sign in and Reset password: curved red top, the logo card, the app name and the tagline. One layout so the two
     screens can never drift apart (same height, same logo size). The logo card sits inside the red curve and the name below it, so
     nothing that follows the header can overlap the logo. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.example.velocitysuites.CurvedHeaderView
        android:id="@+id/curvedHeaderView"
        android:layout_width="0dp"
        android:layout_height="182dp"
        android:layout_marginStart="-16dp"
        android:layout_marginEnd="-16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/logoContainer"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="52dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="@dimen/card_elevation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/curvedHeaderView"
        app:strokeColor="@color/velocity_red_primary"
        app:strokeWidth="2dp">

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_logo"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/velocity_suites_logo" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/appNameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0"
        android:text="@string/velocity_suites"
        android:textAllCaps="false"
        android:textColor="@color/velocity_action_text"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/curvedHeaderView" />

    <TextView
        android:id="@+id/taglineLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0"
        android:text="@string/welcome_tagline"
        android:textAllCaps="false"
        android:textColor="@color/velocity_text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appNameLabel" />

</androidx.constraintlayout.widget.ConstraintLayout>
