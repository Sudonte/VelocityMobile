<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_introduction"
    android:clipChildren="false"
    tools:context=".LoginActivity">

    <!-- Atmospheric Glow Effects -->
    <View
        android:id="@+id/glowTop"
        android:layout_width="600dp"
        android:layout_height="600dp"
        android:layout_marginTop="-300dp"
        android:alpha="0.15"
        android:background="@drawable/shape_intro_red_glow"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/glowBottom"
        android:layout_width="500dp"
        android:layout_height="500dp"
        android:layout_marginEnd="-200dp"
        android:layout_marginBottom="-200dp"
        android:alpha="0.12"
        android:background="@drawable/shape_intro_red_glow"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- Hero Branding Section: photo header + circular logo + curved
                 red/white transition + brand name + tagline. The hero photo
                 and curve deliberately break out of the 24dp side padding
                 via -24dp margins so they render full-bleed edge to edge. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:visibility="invisible"
                app:layout_constraintBottom_toTopOf="@+id/loginLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintVertical_bias="0">

                <com.example.velocitysuites.CurvedHeaderView
                    android:id="@+id/curvedHeaderView"
                    android:layout_width="0dp"
                    android:layout_height="182dp"
                    android:layout_marginStart="-16dp"
                    android:layout_marginEnd="-16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/logoContainer"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginTop="52dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/card_elevation"
                    app:strokeColor="@color/velocity_red_primary"
                    app:strokeWidth="2dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/curvedHeaderView">

                    <ImageView
                        android:id="@+id/logoImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/app_logo"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/velocity_suites_logo" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/appNameLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0"
                    android:text="@string/velocity_suites"
                    android:textAllCaps="false"
                    android:textColor="@color/velocity_action_text"
                    android:textSize="20sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/curvedHeaderView" />

                <TextView
                    android:id="@+id/taglineLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0"
                    android:text="@string/welcome_tagline"
                    android:textAllCaps="false"
                    android:textColor="@color/velocity_text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/appNameLabel" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/loginLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="invisible"
                app:layout_constraintBottom_toTopOf="@+id/loginCard"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/headerSection">

                <TextView
                    android:id="@+id/loginHeading"
                    style="@style/TextAppearance.Velocity.ScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/login_heading"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.85"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/login_subtitle"
                    android:textColor="@color/velocity_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/loginCard"
                style="@style/Widget.Velocity.Card.Glass.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="invisible"
                app:layout_constraintBottom_toTopOf="@+id/signupRedirect"
                app:layout_constraintTop_toBottomOf="@id/loginLabel">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_gradient_light"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/emailLayout"
                        style="@style/Widget.Velocity.TextInputLayout.OutlinedBox.Floating"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/login_email_hint"
                        app:startIconDrawable="@drawable/ic_email">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/emailEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:paddingVertical="13dp"
                            android:textColor="@color/velocity_text_primary"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/passwordLayout"
                        style="@style/Widget.Velocity.TextInputLayout.OutlinedBox.Floating"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/login_password_hint"
                        app:passwordToggleEnabled="true"
                        app:startIconDrawable="@drawable/ic_lock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/passwordEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:paddingVertical="13dp"
                            android:textColor="@color/velocity_text_primary"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:id="@+id/rememberRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/rememberMeCheckbox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remember_me"
                            android:textColor="@color/velocity_text_secondary"
                            android:textSize="13sp"
                            android:minHeight="48dp"
                            android:minWidth="0dp"
                            app:buttonTint="@color/velocity_red_primary"
                            app:useMaterialThemeColors="false" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/forgotPasswordText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:paddingHorizontal="4dp"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/forgot_password"
                            android:textColor="@color/velocity_action_text"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- What the server said, in plain words, under the form (never a popup). -->
                    <TextView
                        android:id="@+id/loginError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:accessibilityLiveRegion="polite"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/velocity_action_text"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/loginResendCode"
                        style="@style/Widget.Velocity.Flat.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/login_resend_code"
                        android:textAllCaps="false"
                        android:textColor="@color/velocity_action_text"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/signInButton"
                        style="@style/Widget.Velocity.Button"
                        android:layout_width="match_parent"
                        android:layout_marginTop="8dp"
                        android:text="@string/sign_in"
                        app:icon="@drawable/ic_arrow_forward"
                        app:iconGravity="textEnd"
                        app:iconSize="20dp"
                        app:iconTint="@color/white" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <LinearLayout
                android:id="@+id/signupRedirect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/loginCard">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dont_have_account"
                    android:textColor="@color/velocity_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/signUpLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:paddingHorizontal="4dp"
                    android:text="@string/sign_up"
                    android:textColor="@color/velocity_action_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Forgot Password Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/forgotPasswordCard"
                style="@style/Widget.Velocity.Card.Glass.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/signupRedirect"
                app:layout_constraintTop_toBottomOf="@id/loginLabel">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_gradient_light"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="29dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@android:drawable/ic_dialog_info"
                        app:tint="@color/velocity_red_primary"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:id="@+id/forgotPasswordTitle"
                        style="@style/TextAppearance.Velocity.ScreenTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textAllCaps="false" />

                    <TextView
                        android:id="@+id/forgotPasswordDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/forgot_password_instruction"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />

                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="22dp"
                        android:background="@color/velocity_red_subtle" />

                    <!-- Form Fields -->
                    <TextView
                        android:id="@+id/forgotEmailLabel"
                        style="@style/TextAppearance.Velocity.Label.Input"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/email_label" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/forgotEmailLayout"
                        style="@style/Widget.Velocity.TextInputLayout.OutlinedBox.Rounded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:helperText="@string/helper_email_any"
                        app:startIconDrawable="@drawable/ic_email">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/forgotEmailEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/email_hint"
                            android:inputType="textEmailAddress"
                            android:paddingVertical="13dp"
                            android:textColor="@color/velocity_text_primary"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/otpLabel"
                        style="@style/TextAppearance.Velocity.Label.Input"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/otp_label"
                        android:visibility="gone" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/loginOtpLayout"
                        style="@style/Widget.Velocity.TextInputLayout.OutlinedBox.Rounded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:startIconDrawable="@android:drawable/ic_dialog_info">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/loginOtpEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/otp_hint"
                            android:inputType="number"
                            android:maxLength="6"
                            android:paddingVertical="13dp"
                            android:textSize="13sp"
                            android:textColor="@color/velocity_text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/resendOtpLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:fontFamily="sans-serif-black"
                        android:padding="4dp"
                        android:text="@string/resend_otp"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/newPasswordLabel"
                        style="@style/TextAppearance.Velocity.Label.Input"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/password_label"
                        android:visibility="gone" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/newPasswordLayout"
                        style="@style/Widget.Velocity.TextInputLayout.OutlinedBox.Rounded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:passwordToggleEnabled="true"
                        app:startIconDrawable="@drawable/ic_lock">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/newPasswordEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/new_password_hint"
                            android:inputType="textPassword"
                            android:paddingVertical="13dp"
                            android:textColor="@color/velocity_text_primary"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/confirmPasswordLabel"
                        style="@style/TextAppearance.Velocity.Label.Input"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/confirm_password_label"
                        android:visibility="gone" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/confirmNewPasswordLayout"
                        style="@style/Widget.Velocity.TextInputLayout.OutlinedBox.Rounded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:passwordToggleEnabled="true"
                        app:startIconDrawable="@drawable/ic_lock">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/confirmNewPasswordEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/confirm_new_password_hint"
                            android:inputType="textPassword"
                            android:paddingVertical="13dp"
                            android:textColor="@color/velocity_text_primary"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/forgotActionButton"
                        style="@style/Widget.Velocity.Button"
                        android:layout_width="match_parent"
                        android:layout_marginTop="25dp"
                        android:text="@string/send_otp_button" />

                    <TextView
                        android:id="@+id/backToLoginLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="14dp"
                        android:padding="11dp"
                        android:text="@string/back_to_sign_in"
                        android:textColor="@color/velocity_red_primary"
                        android:fontFamily="sans-serif-bold"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Account Reactivation Card - shown only when handleLogin() gets
                 reactivation_required=true back (correct credentials, but the
                 account is deactivated - see Api\AuthController::login()'s
                 ACCOUNT_DEACTIVATED branch). Mirrors forgotPasswordCard's visual
                 style for consistency; a distinct card rather than folding a
                 fourth state into that card's own state machine. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/reactivationCard"
                style="@style/Widget.Velocity.Card.Glass.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/signupRedirect"
                app:layout_constraintTop_toBottomOf="@id/loginLabel">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_gradient_light"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="29dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_pause"
                        app:tint="@color/velocity_orange_primary" />

                    <TextView
                        style="@style/TextAppearance.Velocity.ScreenTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/reactivate_account_title"
                        android:textAllCaps="false" />

                    <TextView
                        android:id="@+id/reactivationDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="13sp"
                        tools:text="Your Velocity Suites account is currently deactivated. We've sent a 6-digit verification code to:\nj***@gmail.com" />

                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="22dp"
                        android:background="@color/velocity_red_subtle" />

                    <TextView
                        style="@style/TextAppearance.Velocity.Label.Input"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/otp_label" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/reactivationOtpLayout"
                        style="@style/Widget.Velocity.TextInputLayout.OutlinedBox.Rounded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:startIconDrawable="@android:drawable/ic_dialog_info">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/reactivationOtpEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/otp_hint"
                            android:inputType="number"
                            android:maxLength="6"
                            android:paddingVertical="13dp"
                            android:textColor="@color/velocity_text_primary"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/reactivationResendLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-black"
                        android:padding="4dp"
                        android:text="@string/resend_otp"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/reactivationActionButton"
                        style="@style/Widget.Velocity.Button"
                        android:layout_width="match_parent"
                        android:layout_marginTop="11dp"
                        android:text="@string/verify_reactivate_button" />

                    <TextView
                        android:id="@+id/backToLoginFromReactivationLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="14dp"
                        android:padding="11dp"
                        android:text="@string/back_to_sign_in"
                        android:textColor="@color/velocity_red_primary"
                        android:fontFamily="sans-serif-bold"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Back: a plain white arrow on the red header (48dp touch target), returns to Welcome -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back_label"
