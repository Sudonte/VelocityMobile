<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHistoryRowName"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/velocity_text_primary"
            android:textSize="13sp"
            tools:text="Additional Towel × 1" />

        <TextView
            android:id="@+id/tvHistoryRowStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_intro_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:fontFamily="sans-serif-black"
            android:textSize="10sp"
            android:textAllCaps="true"
            tools:text="Pending"
            tools:backgroundTint="@color/velocity_orange_soft"
            tools:textColor="@color/velocity_orange_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHistoryRowMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/velocity_text_secondary"
        android:textSize="11sp"
        tools:text="₱50.00  •  Requested Aug 22, 2026" />

</LinearLayout>
