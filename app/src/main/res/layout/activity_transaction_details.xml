<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/velocity_red_bg_end"
    android:orientation="vertical"
    tools:context=".TransactionDetailsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/velocity_red_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnTransactionDetailsBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_label"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/transaction_details_title"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Header card: the selected payment's own summary. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Velocity.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card_white"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/iconContainerTxDetail"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="14dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/velocity_green_soft">

                        <ImageView
                            android:id="@+id/ivTxDetailIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/velocity_green_dark" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTxDetailTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            tools:text="Payment Successful" />

                        <TextView
                            android:id="@+id/tvTxDetailRoom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/velocity_text_secondary"
                            android:textSize="12sp"
                            tools:text="Booking Payment  •  Executive Room" />

                        <TextView
                            android:id="@+id/tvTxDetailDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/velocity_inactive_gray"
                            android:textSize="11sp"
                            tools:text="Sep 02, 2026  •  10:24 AM" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTxDetailAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="16sp"
                        tools:text="₱2,900.00" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Payment Information card - built dynamically in Java. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Velocity.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card_white"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/details_section_payment"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/sectionTxDetailInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- "Receipts" - one card per booking.getReceipts() entry (see
                 ReceiptCardHelper#buildReceiptsSection()), populated only when the
                 backend has already issued at least one; empty/untouched otherwise. -->
            <LinearLayout
                android:id="@+id/sectionTxDetailReceipts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="vertical" />

            <!-- Payment Receipt: same gated card/action as BookingDetailsActivity's
                 Payment tab (see item_payment_receipt_action.xml) - replaces the old
                 unconditional Download Receipt button that used to call
                 ReceiptPdfGenerator directly regardless of verification status.
                 Request Amenities intentionally removed from Transaction History
                 (kept only on the live Booking Details screen, not this historical
                 per-payment record view). Hidden entirely once sectionTxDetailReceipts
                 above is populated - see TransactionDetailsActivity#buildReceiptActionCard(). -->
            <include
                android:id="@+id/includeReceiptAction"
                layout="@layout/item_payment_receipt_action" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
