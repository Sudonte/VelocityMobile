<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/velocity_red_bg_end"
    android:orientation="vertical"
    tools:context=".TransactionDetailsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/velocity_red_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnTransactionDetailsBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_label"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/transaction_details_title"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Header card: status badge + reference, the headline, and the money at a glance
                 (grand total, verified paid, balance, anything awaiting verification - filled in by
                 TransactionDetailsActivity#bindHeader() from TransactionStatusHelper, the same source the
                 Transaction History card uses, so the two can never disagree). -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Velocity.Card.Glass.Compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/velocity_surface_elevated"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTxDetailStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/shape_intro_pill"
                            android:drawablePadding="4dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center_vertical"
                            android:letterSpacing="0.04"
                            android:maxLines="1"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:textAllCaps="true"
                            android:textSize="11sp"
                            tools:text="Pending" />

                        <TextView
                            android:id="@+id/tvTxDetailRef"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.03"
                            android:maxLines="2"
                            android:textAllCaps="true"
                            android:textColor="@color/velocity_text_secondary"
                            android:textSize="11sp"
                            tools:text="Reservation #588" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTxDetailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="17sp"
                        tools:text="Payment Awaiting Verification" />

                    <TextView
                        android:id="@+id/tvTxDetailRoom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="13sp"
                        tools:text="Deluxe" />

                    <TextView
                        android:id="@+id/tvTxDetailDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="12sp"
                        tools:text="Last payment: Sep 30, 2026 • 10:09 PM" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/velocity_divider_hairline" />

                    <LinearLayout
                        android:id="@+id/sectionTxDetailMoney"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Opens the full Booking/Reservation Details screen for this transaction's
                 parent booking - restores the access this screen's own notification
                 deep-link used to give directly (see NotificationPrimaryActionResolver),
                 now that "View Transaction" always lands here first instead. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewBookingDetails"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-black"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:strokeColor="@color/velocity_red_primary"
                app:rippleColor="@color/velocity_red_subtle"
                android:textColor="@color/velocity_red_primary"
                app:iconTint="@color/velocity_red_primary"
                tools:text="View Booking Details" />

            <!-- Details card - built dynamically in Java, grouped into its own
                 "Stay Information" / "Guest Information" / "Payment Information"
                 addSectionDivider() headers (see buildInfoSection()) rather than
                 one static label, since the container holds all three now. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Velocity.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card_white"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:id="@+id/sectionTxDetailInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- "Receipts" - one card per booking.getReceipts() entry (see
                 ReceiptCardHelper#buildReceiptsSection()), populated only when the
                 backend has already issued at least one; empty/untouched otherwise. -->
            <LinearLayout
                android:id="@+id/sectionTxDetailReceipts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="vertical" />

            <!-- Payment Receipt: same gated card/action as BookingDetailsActivity's
                 Payment tab (see item_payment_receipt_action.xml) - replaces the old
                 unconditional Download Receipt button that used to call
                 ReceiptPdfGenerator directly regardless of verification status.
                 Request Amenities intentionally removed from Transaction History
                 (kept only on the live Booking Details screen, not this historical
                 per-payment record view). Hidden entirely once sectionTxDetailReceipts
                 above is populated - see TransactionDetailsActivity#buildReceiptActionCard(). -->
            <include
                android:id="@+id/includeReceiptAction"
                layout="@layout/item_payment_receipt_action" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
