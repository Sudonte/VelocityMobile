<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Date-group header ("Today"/"Yesterday"/"Earlier") - GONE by default, shown by
         NotificationAdapter only for the first row of each new group (see
         NotificationDateGrouper). Outside cardNotification's own border/background so
         it reads as a section label above the card, not part of its content. -->
    <TextView
        android:id="@+id/tvNotificationDateGroup"
        style="@style/TextAppearance.Velocity.Label.Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="Today" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNotification"
        style="@style/Widget.Velocity.Card.Glass.Compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="7dp"
        android:clickable="true"
        android:focusable="true"
        app:rippleColor="@color/velocity_red_subtle">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card_white"
        android:padding="10dp">

        <!-- Category Icon Container with soft background -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/iconContainer"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:cardBackgroundColor="@color/velocity_red_soft"
            app:cardCornerRadius="13dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivNotificationIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_notifications"
                app:tint="@color/velocity_red_primary" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvNotificationTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="12dp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:letterSpacing="-0.02"
            app:layout_constraintEnd_toStartOf="@+id/unreadDot"
            app:layout_constraintStart_toEndOf="@+id/iconContainer"
            app:layout_constraintTop_toTopOf="@+id/iconContainer"
            tools:text="Reservation Confirmation" />

        <TextView
            android:id="@+id/tvNotificationMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.85"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingMultiplier="1.3"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvNotificationTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvNotificationTitle"
            tools:text="Your booking for Executive Suite (Ref: VS-1024) has been confirmed for Oct 12-15, 2023." />

        <LinearLayout
            android:id="@+id/layoutNotificationBadges"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvNotificationTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvNotificationMessage">

            <TextView
                android:id="@+id/tvNotificationCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_intro_pill"
                android:backgroundTint="@color/velocity_red_soft"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/velocity_red_primary"
                android:textSize="9sp"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                tools:text="Booking" />

            <TextView
                android:id="@+id/tvNotificationStatusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/shape_intro_pill"
                android:backgroundTint="@color/velocity_green_soft"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/velocity_green_dark"
                android:textSize="9sp"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="Confirmed" />

            <TextView
                android:id="@+id/tvNotificationTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="end"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.04"
                android:textColor="@color/velocity_inactive_gray"
                android:textSize="11sp"
                android:textAllCaps="true"
                tools:text="Today • 10:30 AM" />
        </LinearLayout>

        <!-- Unread Indicator -->
        <View
            android:id="@+id/unreadDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_notification_dot"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvNotificationTitle"
            app:layout_constraintBottom_toBottomOf="@+id/tvNotificationTitle" />

        <!-- Decorative chevron - signals the whole card is tappable for full details. -->
        <ImageView
            android:id="@+id/ivNotificationChevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/velocity_inactive_gray"
            app:layout_constraintBottom_toBottomOf="@+id/btnToggleReadState"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnToggleReadState" />

        <!-- Mark as read/unread toggle - separately clickable from the card's own
             tap-for-details gesture (a nested clickable View naturally consumes its own
             touch, see NotificationAdapter). Icon/description swapped in code based on
             the row's current read state. -->
        <ImageButton
            android:id="@+id/btnToggleReadState"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_eye"
            app:tint="@color/velocity_inactive_gray"
            app:layout_constraintEnd_toStartOf="@+id/ivNotificationChevron"
            app:layout_constraintTop_toBottomOf="@+id/layoutNotificationBadges"
            tools:contentDescription="@string/mark_as_read_action" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>