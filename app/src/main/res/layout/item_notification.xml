<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Date-group header ("Today"/"Yesterday"/"Earlier") - GONE by default, shown by
         NotificationAdapter only for the first row of each new group (see
         NotificationDateGrouper). Outside cardNotification's own border/background so
         it reads as a section label above the card, not part of its content. A hairline
         divider makes the separation from the previous group's last card unambiguous
         even when the header text alone (e.g. after a long "Earlier" run) might not
         stand out enough on its own. -->
    <View
        android:id="@+id/dividerNotificationDateGroup"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        android:background="@color/velocity_divider_hairline"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvNotificationDateGroup"
        style="@style/TextAppearance.Velocity.Label.Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.04"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="Today" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNotification"
        style="@style/Widget.Velocity.Card.Glass.Compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true"
        app:rippleColor="@color/velocity_red_subtle">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card_white"
        android:padding="12dp">

        <!-- Category icon in a true colored circle (40dp, 20dp corner radius). -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/iconContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="@color/velocity_red_soft"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivNotificationIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_notifications"
                app:tint="@color/velocity_red_primary" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvNotificationTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:textColor="@color/velocity_text_primary"
            android:textSize="14sp"
            android:letterSpacing="-0.01"
            app:layout_constraintEnd_toStartOf="@+id/btnToggleReadState"
            app:layout_constraintStart_toEndOf="@+id/iconContainer"
            app:layout_constraintTop_toTopOf="@+id/iconContainer"
            tools:fontFamily="sans-serif-black"
            tools:text="Reservation Confirmation" />

        <!-- Guarantees tvNotificationMessage starts below WHICHEVER of the title or the
             top-right toggle button is taller - a plain toBottomOf="tvNotificationTitle"
             would let a short single-line title leave the (wider/taller) toggle button
             hanging over the message text below it, since the button sits in the same
             end-aligned column the message's own end edge extends into. -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierNotificationTitleRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tvNotificationTitle,btnToggleReadState" />

        <TextView
            android:id="@+id/tvNotificationMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingMultiplier="1.3"
            android:maxLines="2"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvNotificationTitle"
            app:layout_constraintTop_toBottomOf="@+id/barrierNotificationTitleRow"
            tools:text="Your booking for Executive Suite (Ref: VS-1024) has been confirmed for Oct 12-15, 2023. We look forward to welcoming you." />

        <LinearLayout
            android:id="@+id/layoutNotificationBadges"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvNotificationTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvNotificationMessage">

            <TextView
                android:id="@+id/tvNotificationCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_intro_pill"
                android:backgroundTint="@color/velocity_red_soft"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/velocity_red_primary"
                android:textSize="9sp"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                tools:text="Booking" />

            <TextView
                android:id="@+id/tvNotificationStatusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/shape_intro_pill"
                android:backgroundTint="@color/velocity_green_soft"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/velocity_green_dark"
                android:textSize="9sp"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="Confirmed" />

            <TextView
                android:id="@+id/tvNotificationTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="end"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.02"
                android:textColor="@color/velocity_inactive_gray"
                android:textSize="10sp"
                tools:text="5 minutes ago" />
        </LinearLayout>

        <!-- Read/Unread toggle - icon-only (closed envelope = unread/"tap to mark
             read", open envelope = read/"tap to mark unread"), top-right corner of
             the card. Replaces both the old bottom-row icon+text button (whose label
             could get squeezed against "View Transaction Details" on a narrow
             screen) and the separate unread dot - the envelope's own open/closed
             shape now carries that same at-a-glance unread signal by itself.
             MaterialButton (not a plain ImageButton) purely so the existing
             setIconResource()/setOnClickListener() code in NotificationAdapter
             needed no change - its text-button insets/min-size are zeroed out below
             so it renders as a plain 40dp circular icon button instead of a text
             button with no text. Content description and tooltip are set in code
             (NotificationAdapter#bindActions()) since they depend on the current
             read state, not something a static XML value could express. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleReadState"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_email"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/velocity_red_primary"
            app:cornerRadius="20dp"
            app:rippleColor="@color/velocity_red_subtle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iconContainer"
            tools:ignore="ContentDescription" />

        <!-- Bottom action row: "View Transaction Details" alone now that the Read/
             Unread toggle lives at the card's top-right corner (see
             btnToggleReadState above) - GONE entirely (divider included) for a
             notification with nothing to deep-link to (Promotions/System - see
             NotificationAdapter's own bindActions()), so a Promotions/System card
             never ends in a dangling empty divider with nothing below it. -->
        <View
            android:id="@+id/dividerNotificationActions"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/velocity_divider_hairline"
            app:layout_constraintTop_toBottomOf="@+id/layoutNotificationBadges" />

        <!-- wrap_content, end-aligned, no ellipsize/maxLines - alone on this row now,
             so its full "View Transaction Details" text always has the row's whole
             width available (comfortably under 360dp's available card width) and is
             never at risk of being squeezed by a sibling the way it was when the
             toggle button shared this row. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewTransactionDetails"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-bold"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/view_transaction_details_label"
            android:textAllCaps="false"
            android:textColor="@color/velocity_red_primary"
            android:textSize="12sp"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd"
            app:iconPadding="4dp"
            app:iconSize="14dp"
            app:iconTint="@color/velocity_red_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dividerNotificationActions"
            app:rippleColor="@color/velocity_red_subtle" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
