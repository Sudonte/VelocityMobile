<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the notifications "Show" dropdown - the category icon in the same round soft circle every notification
     uses (NotificationCategoryPresenter), the option's label (with its unread count, e.g. "Booking (3)"), and a checkmark on
     the selected option. 48dp tall (Material's list-item minimum), so the whole list opens below the field without
     clipping its first row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="6dp">

    <FrameLayout
        android:id="@+id/iconContainerFilterOption"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/shape_notification_icon_circle"
        android:backgroundTint="@color/velocity_red_soft">

        <ImageView
            android:id="@+id/ivFilterOptionIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_notifications"
            app:tint="@color/velocity_red_primary" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvFilterOptionLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/velocity_text_primary"
        android:textSize="13sp"
        tools:text="Booking (3)" />

    <ImageView
        android:id="@+id/ivFilterOptionCheck"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_check_circle"
        android:visibility="invisible"
        app:tint="@color/velocity_red_primary"
        tools:visibility="visible" />

</LinearLayout>
