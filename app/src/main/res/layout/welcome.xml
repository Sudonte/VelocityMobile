<?xml version="1.0" encoding="utf-8"?>
<!--
    Welcome screen: what the app is, what it does, and what to do next, in that order.
      logo -> headline -> one supporting line -> value points  (all in the scroller)
      primary action + secondary action                        (pinned bar, always reachable)
    The content scrolls on a small screen, with a large font size or in a short window; the actions never scroll away.
    Spacing is on the app's 8dp grid (8 / 16 / 24), text is in sp, and every touch target is at least 48dp.
    No rounded corners and no shadows; the logo is meaningful (described), everything else decorative is hidden from
    accessibility services.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/welcomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome">

    <!-- Atmospheric glow and faint room-sketch watermarks: decoration only, kept behind all content -->

    <View
        android:id="@+id/glowTop"
        android:layout_width="600dp"
        android:layout_height="600dp"
        android:layout_marginTop="-260dp"
        android:alpha="0.2"
        android:background="@drawable/shape_intro_red_glow"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="-40dp"
        android:layout_marginEnd="-60dp"
        android:alpha="0.05"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:rotation="-18"
        android:src="@drawable/ic_bed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/velocity_red_primary" />

    <ImageView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginStart="-50dp"
        android:layout_marginBottom="-30dp"
        android:alpha="0.05"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:rotation="14"
        android:src="@drawable/ic_bed"
        app:layout_constraintBottom_toTopOf="@+id/buttonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/velocity_red_primary" />

    <!-- Back: outside the scroller so it is always reachable -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWelcomeBack"
        style="@style/Widget.MaterialComponents.Button.Icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/back_label"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:stateListAnimator="@null"
        app:backgroundTint="@color/white"
        app:cornerRadius="0dp"
        app:elevation="0dp"
        app:icon="@drawable/ic_arrow_back"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="20dp"
        app:iconTint="@color/velocity_red_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rippleColor="@color/velocity_red_soft" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/welcomeScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        app:layout_constraintBottom_toTopOf="@+id/buttonContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnWelcomeBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingVertical="14dp">

            <!-- 1. Brand -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/logoBorder"
                android:layout_width="112dp"
                android:layout_height="112dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeColor="@color/velocity_red_primary"
                app:strokeWidth="2dp">

                <ImageView
                    android:id="@+id/welcomeLogoImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/app_logo"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/velocity_suites_logo" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Brand name, then its tagline and the short divider -->
            <TextView
                android:id="@+id/welcomeBrandText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:letterSpacing="0"
                android:text="@string/welcome_brand"
                android:textColor="@color/velocity_red_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/welcomeTaglineText"
                style="@style/TextAppearance.Velocity.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/welcome_tagline"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="13sp" />

            <View
                android:id="@+id/welcomeDivider"
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/shape_intro_pill"
                android:backgroundTint="@color/velocity_red_primary"
                android:importantForAccessibility="no" />

            <!-- 3. Headline -->
            <TextView
                android:id="@+id/welcomeTitleText"
                style="@style/TextAppearance.Velocity.ScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="@string/welcome_headline"
                android:textColor="@color/velocity_text_primary"
                android:textSize="24sp" />

            <!-- 4. One short supporting line -->
            <TextView
                android:id="@+id/welcomeDescriptionText"
                style="@style/TextAppearance.Velocity.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/welcome_support"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="14sp" />

            <!-- 5. What the app does: a 2 x 2 grid of equal cards, like the landing page's feature grid -->
            <LinearLayout
                android:id="@+id/welcomePoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/welcomeCardRooms"
                        style="@style/Widget.Velocity.Card.Flat"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:minHeight="132dp"
                        android:layout_marginEnd="6dp"
                        android:screenReaderFocusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/shape_notification_icon_circle"
                                android:backgroundTint="@color/velocity_red_soft"
                                android:importantForAccessibility="no">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_bed"
                                    app:tint="@color/velocity_red_primary" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/welcomeCardRoomsTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="sans-serif-black"
                                android:gravity="center"
                                android:minLines="2"
                                android:text="@string/welcome_point_rooms_title"
                                android:textColor="@color/velocity_text_primary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/welcomeCardRoomsDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:minLines="2"
                                android:text="@string/welcome_point_rooms_desc"
                                android:textColor="@color/velocity_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/welcomeCardPay"
                        style="@style/Widget.Velocity.Card.Flat"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:minHeight="132dp"
                        android:layout_marginStart="6dp"
                        android:screenReaderFocusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/shape_notification_icon_circle"
                                android:backgroundTint="@color/velocity_red_soft"
                                android:importantForAccessibility="no">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_payment_card"
                                    app:tint="@color/velocity_red_primary" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/welcomeCardPayTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="sans-serif-black"
                                android:gravity="center"
                                android:minLines="2"
                                android:text="@string/welcome_point_pay_title"
                                android:textColor="@color/velocity_text_primary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/welcomeCardPayDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:minLines="2"
                                android:text="@string/welcome_point_pay_desc"
                                android:textColor="@color/velocity_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/welcomeCardTrack"
                        style="@style/Widget.Velocity.Card.Flat"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:minHeight="132dp"
                        android:layout_marginEnd="6dp"
                        android:screenReaderFocusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/shape_notification_icon_circle"
                                android:backgroundTint="@color/velocity_red_soft"
                                android:importantForAccessibility="no">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_transaction_history"
                                    app:tint="@color/velocity_red_primary" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/welcomeCardTrackTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="sans-serif-black"
                                android:gravity="center"
                                android:minLines="2"
                                android:text="@string/welcome_point_track_title"
                                android:textColor="@color/velocity_text_primary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/welcomeCardTrackDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:minLines="2"
                                android:text="@string/welcome_point_track_desc"
                                android:textColor="@color/velocity_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/welcomeCardSupport"
                        style="@style/Widget.Velocity.Card.Flat"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:minHeight="132dp"
                        android:layout_marginStart="6dp"
                        android:screenReaderFocusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/shape_notification_icon_circle"
                                android:backgroundTint="@color/velocity_red_soft"
                                android:importantForAccessibility="no">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_headset"
                                    app:tint="@color/velocity_red_primary" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/welcomeCardSupportTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="sans-serif-black"
                                android:gravity="center"
                                android:minLines="2"
                                android:text="@string/welcome_point_notify_title"
                                android:textColor="@color/velocity_text_primary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/welcomeCardSupportDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:minLines="2"
                                android:text="@string/welcome_point_notify_desc"
                                android:textColor="@color/velocity_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 5. Actions: one obvious primary (filled), one clearly secondary (outlined, lighter). Same ids and
         destinations as before: Sign Up -> RegistrationActivity, Sign In -> LoginActivity. -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/velocity_surface_elevated"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/velocity_red_subtle"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingVertical="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/registrationButton"
                style="@style/Widget.Velocity.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0"
                android:minHeight="52dp"
                android:stateListAnimator="@null"
                android:text="@string/welcome_action_create_account"
                android:textAllCaps="false"
                android:textSize="15sp"
                app:icon="@drawable/ic_person"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />

            <!-- "Already have an account? Sign in": the whole line taps; "Sign in" is picked out in bold red (WelcomeActivity). -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/loginButton"
                style="@style/Widget.Velocity.Flat.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0"
                android:minHeight="48dp"
                android:text="@string/welcome_action_sign_in"
                android:textAllCaps="false"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
