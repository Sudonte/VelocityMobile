<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/welcomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome"
    android:clipChildren="false">

    <!-- Atmospheric Glow Background Elements (kept behind all content) -->

    <View
        android:id="@+id/glowTop"
        android:layout_width="600dp"
        android:layout_height="600dp"
        android:layout_marginTop="-260dp"
        android:alpha="0.2"
        android:background="@drawable/shape_intro_red_glow"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/bottomFade"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:alpha="0.8"
        android:background="@drawable/bg_intro_bottom_fade"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Subtle hotel-room line-art watermarks, very low alpha so they read as
         background texture rather than competing with the logo/content cards
         on top of them - matching the reference's faint room-sketch motif
         without needing a brand-new illustration asset (reuses the existing
         bed icon at a much larger size/opacity than its normal icon use). -->
    <ImageView
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="-40dp"
        android:layout_marginEnd="-60dp"
        android:alpha="0.05"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:rotation="-18"
        android:src="@drawable/ic_bed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/velocity_red_primary" />

    <ImageView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginBottom="-30dp"
        android:layout_marginStart="-50dp"
        android:alpha="0.05"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:rotation="14"
        android:src="@drawable/ic_bed"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/velocity_red_primary" />

    <!-- Scrollable Main Content Container: prevents buttons from being
         clipped on short screens or when the user has scaled up font size -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="24dp"
        android:clipToPadding="false"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="32dp"
            android:paddingVertical="24dp">

            <!-- Back Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWelcomeBack"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/back_label"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/white"
                app:cornerRadius="24dp"
                app:elevation="4dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="@color/velocity_red_primary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:rippleColor="@color/velocity_red_soft" />

            <!-- Logo Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/logoBorder"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="38dp"
                app:cardElevation="12dp"
                app:strokeColor="@color/velocity_red_primary"
                app:strokeWidth="2dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/welcomeMainCard"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintVertical_bias="0.4">

                <ImageView
                    android:id="@+id/welcomeLogoImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/app_logo"
                    android:padding="22dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/velocity_suites_logo" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Main Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/welcomeMainCard"
                style="@style/Widget.Velocity.Card.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/velocity_surface_elevated"
                app:layout_constraintTop_toBottomOf="@id/logoBorder"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/buttonContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:id="@+id/welcomeTitleText"
                        style="@style/TextAppearance.Velocity.ScreenTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/welcome_title"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/welcomeTaglineText"
                        style="@style/TextAppearance.Velocity.Label.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/welcome_tagline"
                        android:textColor="@color/velocity_text_secondary" />

                    <View
                        android:layout_width="40dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/shape_intro_pill"
                        android:backgroundTint="@color/velocity_red_primary"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/welcomeDescriptionText"
                        style="@style/TextAppearance.Velocity.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.25"
                        android:text="@string/welcome_description" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:id="@+id/buttonContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/welcomeMainCard"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginButton"
                    style="@style/Widget.Velocity.Button"
                    android:layout_width="match_parent"
                    android:text="@string/login"
                    app:icon="@drawable/ic_logout"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/registrationButton"
                    style="@style/Widget.Velocity.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_marginTop="12dp"
                    android:text="@string/registration"
                    app:icon="@drawable/ic_logout"
                    app:iconGravity="textStart"
                    app:iconTint="@color/velocity_red_primary" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
