<?xml version="1.0" encoding="utf-8"?>
<!-- Reuses the exact card/dialog pattern already established by
     dialog_room_filters.xml (RoomBrowsingActivity's own Filter feature) -
     title + close button, chip-group sections in shape_search_field
     containers, and a Reset/Apply Filters action row - rather than
     introducing a new dialog style/component this project doesn't
     otherwise use anywhere. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Velocity.Card.Glass"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card_white"
        android:padding="22dp">

        <TextView
            android:id="@+id/tvTransactionFilterTitle"
            style="@style/TextAppearance.Velocity.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_transactions_title"
            android:textSize="17sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseTransactionFilters"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:backgroundTint="@color/velocity_red_soft"
            app:cornerRadius="15dp"
            app:icon="@drawable/ic_close"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="14dp"
            app:iconTint="@color/velocity_red_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:rippleColor="@color/white" />

        <View
            android:id="@+id/filterTransactionsDividerTop"
            android:layout_width="30dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/shape_intro_pill"
            android:backgroundTint="@color/velocity_red_soft"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTransactionFilterTitle" />

        <!-- Sort Section -->
        <LinearLayout
            android:id="@+id/sortSectionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/shape_search_field"
            android:backgroundTint="@color/velocity_red_bg_end"
            android:orientation="vertical"
            android:padding="14dp"
            app:layout_constraintTop_toBottomOf="@id/filterTransactionsDividerTop">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/velocity_red_primary" />

                <TextView
                    style="@style/TextAppearance.Velocity.Label.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/filter_sort_label"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSortOrder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="6dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSortNewest"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/filter_sort_newest"
                    android:textSize="11sp"
                    app:chipBackgroundColor="@color/white"
                    app:chipStrokeColor="@color/velocity_red_subtle"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSortOldest"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_sort_oldest"
                    android:textSize="11sp"
                    app:chipBackgroundColor="@color/white"
                    app:chipStrokeColor="@color/velocity_red_subtle"
                    app:chipStrokeWidth="1dp" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Room Type Section - chips populated dynamically at runtime from
             the room types actually present in the guest's own transaction
             list (see BookingAndReservationActivity#showFilterBottomSheet()) -
             hidden entirely when there's nothing to filter by yet. -->
        <LinearLayout
            android:id="@+id/roomTypeSectionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/shape_search_field"
            android:backgroundTint="@color/velocity_red_bg_end"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone"
            tools:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/sortSectionCard">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bed"
                    app:tint="@color/velocity_red_primary" />

                <TextView
                    style="@style/TextAppearance.Velocity.Label.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/filter_room_type_label"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupRoomTypeFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="6dp" />
        </LinearLayout>

        <View
            android:id="@+id/filterTransactionsDividerBottom"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:alpha="0.3"
            android:background="@color/velocity_red_subtle"
            app:layout_constraintTop_toBottomOf="@id/roomTypeSectionCard" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/filterTransactionsDividerBottom">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearTransactionFilters"
                style="@style/Widget.Velocity.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:text="@string/clear_filters"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyTransactionFilters"
                style="@style/Widget.Velocity.Button"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.6"
                android:text="@string/apply_filters"
                android:textSize="12sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
