<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".BookingDetailsActivity">

    <!-- Custom back-arrow header, matching this app's established convention
         (custom bar, not a native ActionBar) elsewhere in the app. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/velocity_red_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/btnBookingDetailsBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_label"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvDetailsScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/booking_details_screen_title"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshDetails"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Header card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Velocity.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_flat_box"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- No room image here by design - a room photo belongs only in
                         the Room Information section below (item_selected_room_type_card.xml,
                         one per selected room type), never beside the Booking/Reservation
                         ID (see BookingDetailsActivity#bindHeader() - the header previously
                         showed a single image representing only the first/legacy room type,
                         which was misleading for a multi-room-type transaction). -->

                    <!-- The status leads: it is what the guest looks for first. -->
                    <TextView
                        android:id="@+id/tvDetailsStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/shape_flat_badge"
                        android:backgroundTint="@color/velocity_green_subtle"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/velocity_green_primary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-black"
                        tools:text="CONFIRMED" />

                    <!-- Primary highlighted identifier - the Booking/Reservation ID
                         itself (e.g. "BOOKING #338"), never the room name and never
                         repeated a second time anywhere else in this header (see
                         BookingDetailsActivity#bindHeader()). -->
                    <TextView
                        android:id="@+id/tvDetailsRoomHeadline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:textAllCaps="false"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        tools:text="Booking #338" />

                    <TextView
                        android:id="@+id/tvDetailsDates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="12sp"
                        tools:text="Sep 04, 2026 - Sep 05, 2026" />

                    <!-- Every selected room type and its quantity - e.g. "Bryan Dela
                         Cruz ×1 • Deluxe ×1" - directly below the stay dates and
                         directly above the status pill, per the required info
                         hierarchy (see Booking#formatRoomSelectionSummary()). Not
                         line/ellipsize-constrained, so a long multi-room-type
                         selection wraps rather than truncating. -->
                    <TextView
                        android:id="@+id/tvDetailsRoomGuestCounts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="12sp"
                        tools:text="Bryan Dela Cruz ×1 • Deluxe ×1" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Balance summary + progress: what the guest looks for first - what is still owed, what was paid, and where the stay is. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBalanceSummary"
                style="@style/Widget.Velocity.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:id="@+id/sectionBalanceContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_flat_box"
                    android:orientation="vertical"
                    android:padding="14dp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Velocity.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_flat_box"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/TextAppearance.Velocity.Label.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/section_title_booking_information"
                        android:drawablePadding="8dp"
                        app:drawableStartCompat="@drawable/ic_booking"
                        app:drawableTint="@color/velocity_red_primary"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/sectionBookingInfoContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Velocity.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_flat_box"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/TextAppearance.Velocity.Label.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/details_title_stay"
                        android:drawablePadding="8dp"
                        app:drawableStartCompat="@drawable/ic_bed"
                        app:drawableTint="@color/velocity_red_primary"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/sectionRoomInfoContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Velocity.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_flat_box"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/TextAppearance.Velocity.Label.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/details_title_guests"
                        android:drawablePadding="8dp"
                        app:drawableStartCompat="@drawable/ic_person"
                        app:drawableTint="@color/velocity_red_primary"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/sectionGuestInfoContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDiscountId"
                style="@style/Widget.Velocity.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_flat_box"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/TextAppearance.Velocity.Label.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/section_title_discount_id"
                        android:drawablePadding="8dp"
                        app:drawableStartCompat="@drawable/ic_shield_check"
                        app:drawableTint="@color/velocity_red_primary"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/sectionDiscountIdContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Velocity.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_flat_box"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/TextAppearance.Velocity.Label.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/details_title_bill"
                        android:drawablePadding="8dp"
                        app:drawableStartCompat="@drawable/ic_payment"
                        app:drawableTint="@color/velocity_red_primary"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/sectionPaymentSummaryContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Velocity.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_flat_box"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/TextAppearance.Velocity.Label.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/details_title_payments"
                        android:drawablePadding="8dp"
                        app:drawableStartCompat="@drawable/ic_payment_card"
                        app:drawableTint="@color/velocity_red_primary"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/sectionPaymentInfoContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Velocity.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_flat_box"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/TextAppearance.Velocity.Label.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/details_title_payments"
                        android:drawablePadding="8dp"
                        app:drawableStartCompat="@drawable/ic_transaction_history"
                        app:drawableTint="@color/velocity_red_primary"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/sectionPaymentHistoryContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReceiptsSection"
                style="@style/Widget.Velocity.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_flat_box"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/TextAppearance.Velocity.Label.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/details_label_receipts_section"
                        android:drawablePadding="8dp"
                        app:drawableStartCompat="@drawable/ic_transaction_history"
                        app:drawableTint="@color/velocity_red_primary"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/sectionReceiptsContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Velocity.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_flat_box"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/TextAppearance.Velocity.Label.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/section_title_transaction_timeline"
                        android:drawablePadding="8dp"
                        app:drawableStartCompat="@drawable/ic_clock"
                        app:drawableTint="@color/velocity_red_primary"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/sectionTimelineContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Actions (bottom of the screen). Edit Reservation: only offered while the reservation can still be changed
                 (see ReservationEditPolicy); hidden otherwise. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditReservation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:minHeight="48dp"
                android:text="@string/edit_reservation_button"
                android:textAllCaps="false"
                android:visibility="gone"
                app:backgroundTint="@color/velocity_red_primary" />

            <!-- Request Additional Amenities: same picker as Payment Details; disabled with the server's reason when this stay can't request. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRequestAmenitiesDetails"
                style="@style/Widget.Velocity.Flat.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:minHeight="48dp"
                android:text="@string/request_additional_amenities_button"
                android:textAllCaps="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvRequestAmenitiesDetailsReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
