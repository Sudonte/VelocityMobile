<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/TextAppearance.Velocity.Label.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/id_verification_title"
            android:textColor="@color/velocity_text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="@string/discount_step_intro"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="14sp" />

        <!-- Always available: continue without a discount. -->
        <include
            android:id="@+id/rowNoDiscount"
            layout="@layout/item_discount_option" />

        <!-- Loading -->
        <LinearLayout
            android:id="@+id/layoutDiscountLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/discount_loading"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Error + retry -->
        <LinearLayout
            android:id="@+id/layoutDiscountError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_flat_box"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvDiscountError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/discount_load_error"
                android:textColor="@color/velocity_red_dark"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiscountRetry"
                style="@style/Widget.Velocity.Flat.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/retry_label"
                android:textAllCaps="false"
                android:textColor="@color/velocity_red_primary"
                app:strokeColor="@color/velocity_red_primary" />
        </LinearLayout>

        <!-- Empty -->
        <TextView
            android:id="@+id/tvDiscountEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_flat_box"
            android:padding="16dp"
            android:text="@string/discount_empty"
            android:textColor="@color/velocity_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutDiscountList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ID upload: only for a chosen discount -->
        <LinearLayout
            android:id="@+id/layoutIdUpload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_flat_box"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvIdUploadTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="@string/discount_upload_title"
                android:textColor="@color/velocity_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvIdUploadStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/no_id_uploaded"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/ivIdPreview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_flat_box"
                android:contentDescription="@string/discount_id_preview_desc"
                android:padding="1dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadId"
                style="@style/Widget.Velocity.Flat.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/upload_id_card"
                android:textAllCaps="false"
                android:textColor="@color/velocity_red_primary"
                app:strokeColor="@color/velocity_red_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemoveId"
                style="@style/Widget.Velocity.Flat.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/discount_remove_id"
                android:textAllCaps="false"
                android:textColor="@color/velocity_text_secondary"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
