<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/velocity_red_bg_end"
    tools:context=".AdditionalAmenitiesActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_guest_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingTop="32dp"
            android:paddingBottom="11dp">

            <ImageButton
                android:id="@+id/btnAdditionalAmenitiesBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/velocity_red_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="@string/request_additional_amenities_button"
                android:textColor="@color/velocity_red_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Which stay this request is for. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/additionalAmenitiesStay"
                    style="@style/Widget.Velocity.Card.Flat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tvAmenitiesStaySummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:padding="12dp"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="14sp"
                        tools:text="Booking #567 · Room 303 · Oct 20 → Oct 21, 2026" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvAmenitiesIntro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/additional_amenities_intro"
                    android:textColor="@color/velocity_text_secondary"
                    android:textSize="13sp" />

                <!-- Loading / error (with Retry) / "can't request" explanation -->
                <LinearLayout
                    android:id="@+id/additionalAmenitiesState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="24dp">

                    <TextView
                        android:id="@+id/additionalAmenitiesStateText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/additional_amenities_loading"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/additionalAmenitiesRetry"
                        style="@style/Widget.Velocity.Flat.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:minWidth="140dp"
                        android:text="@string/retry_label"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/additionalAmenitiesForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/TextAppearance.Velocity.Section.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:accessibilityHeading="true"
                        android:text="@string/additional_amenities_rooms_title" />

                    <LinearLayout
                        android:id="@+id/additionalAmenitiesRooms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/additionalAmenitiesSummaryHeader"
                        style="@style/TextAppearance.Velocity.Section.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:accessibilityHeading="true"
                        android:text="@string/additional_amenities_summary_title"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/additionalAmenitiesSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Pinned to the bottom: the billing note, the hint while nothing is chosen, then Total and Send Request. -->
        <LinearLayout
            android:id="@+id/additionalAmenitiesBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/velocity_surface_elevated"
            android:elevation="6dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/additional_amenities_billing_note"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/additionalAmenitiesHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/additional_amenities_hint_add_one"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/additional_amenities_total_label"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/additionalAmenitiesTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="16sp"
                        tools:text="₱400.00" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/additionalAmenitiesSubmit"
                    style="@style/Widget.Velocity.Flat.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:enabled="false"
                    android:letterSpacing="0"
                    android:minWidth="140dp"
                    android:text="@string/additional_amenities_submit"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
