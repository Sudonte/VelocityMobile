<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Velocity.Card.Glass"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/room_card_corner_radius">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card_white"
        android:orientation="vertical">

        <!-- Visual Hero Section -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/room_card_image_height">

            <ImageView
                android:id="@+id/detailRoomImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_room_placeholder_gradient"
                android:scaleType="centerCrop"
                android:contentDescription="@string/cd_room_image" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/detailRoomImagePager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_overlay" />

            <!-- Gallery photo-count chip - also the "tap to view full screen" hint. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/detailGalleryCountCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="#99000000"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                tools:visibility="visible">
                <TextView
                    android:id="@+id/detailGalleryCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="5dp"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    app:drawableStartCompat="@drawable/ic_star"
                    app:drawableTint="@color/white"
                    tools:text="1 / 5 · Tap to view" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Floating Top Badges -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/detailStatusCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/velocity_green_subtle"
                app:strokeWidth="1dp">
                <TextView
                    android:id="@+id/detailStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:text="@string/available_label"
                    android:textColor="@color/velocity_green_primary"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClose"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_close"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="17dp"
                app:iconTint="@color/white"
                app:backgroundTint="#99000000"
                app:cornerRadius="17dp"
                android:contentDescription="@string/cd_close_dialog" />

            <!-- Price Chip -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="16dp"
                app:cardBackgroundColor="@color/velocity_red_primary"
                app:cardCornerRadius="14dp"
                app:cardElevation="10dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="9dp">

                    <TextView
                        android:id="@+id/detailRoomPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:letterSpacing="-0.02"
                        tools:text="₱5,500" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:alpha="0.85"
                        android:fontFamily="sans-serif-bold"
                        android:includeFontPadding="false"
                        android:text="@string/per_night_suffix"
                        android:textColor="@color/white"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- Detailed Information -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="400dp"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/room_card_content_padding"
                android:paddingTop="18dp"
                android:paddingBottom="20dp">

                <TextView
                    style="@style/TextAppearance.Velocity.Label.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/room_overview_label"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/detailRoomName"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/velocity_text_primary"
                    android:textSize="19sp"
                    android:letterSpacing="-0.03"
                    android:lineSpacingMultiplier="0.95"
                    tools:text="Executive City Suite" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/velocity_red_soft"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:id="@+id/detailRoomType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/velocity_red_primary"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05"
                            tools:text="Suite" />
                    </com.google.android.material.card.MaterialCardView>

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginHorizontal="12dp"
                        android:background="@drawable/shape_intro_pill"
                        android:backgroundTint="@color/velocity_inactive_gray"
                        android:alpha="0.4" />

                    <TextView
                        android:id="@+id/detailRoomCapacity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="14sp"
                        app:drawableStartCompat="@drawable/ic_person"
                        app:drawableTint="@color/velocity_text_secondary"
                        android:drawablePadding="6dp"
                        tools:text="Up to 4 Persons" />
                </LinearLayout>

                <!-- Bed Type / Room Size Stat Strip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/shape_search_field"
                    android:backgroundTint="@color/velocity_red_bg_end"
                    android:orientation="horizontal"
                    android:paddingVertical="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_bed"
                            app:tint="@color/velocity_red_primary" />

                        <TextView
                            android:id="@+id/detailRoomBedType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/velocity_text_primary"
                            android:textSize="13sp"
                            tools:text="King Bed" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.08"
                            android:text="@string/bed_type_label"
                            android:textAllCaps="true"
                            android:textColor="@color/velocity_inactive_gray"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/velocity_red_subtle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_area"
                            app:tint="@color/velocity_red_primary" />

                        <TextView
                            android:id="@+id/detailRoomSize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/velocity_text_primary"
                            android:textSize="13sp"
                            tools:text="42 sqm" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.08"
                            android:text="@string/room_size_label"
                            android:textAllCaps="true"
                            android:textColor="@color/velocity_inactive_gray"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:alpha="0.1"
                    android:background="@color/black" />

                <!-- Description Block -->
                <TextView
                    style="@style/TextAppearance.Velocity.Label.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/description_label"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/detailRoomDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/velocity_text_secondary"
                    android:textSize="13sp"
                    android:alpha="0.9"
                    tools:text="Spacious suite with premium bedding, work lounge, city view, and complimentary breakfast." />

                <!-- Amenities Block -->
                <TextView
                    style="@style/TextAppearance.Velocity.Label.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/amenities_label"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/detailRoomAmenities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/velocity_text_secondary"
                    android:textSize="13sp"
                    android:background="@drawable/shape_search_field"
                    android:backgroundTint="@color/velocity_red_bg_end"
                    android:padding="14dp"
                    tools:text="• Free Wi-Fi\n• Air Conditioning\n• Flat-screen TV" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="22dp"
                    android:alpha="0.1"
                    android:background="@color/black" />

                <!-- Hotel Policies Section - the fixed 7-line block applies
                     identically to every room type (it's hotel-wide, not
                     admin-editable per room type). The admin's optional
                     per-room notes field (detailRoomPolicies) is shown
                     underneath, separately labeled, so the two are never
                     confused with each other. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        style="@style/TextAppearance.Velocity.Label.Section"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/hotel_policies_label"
                        android:textSize="11sp" />
                    <ImageView
                        android:id="@+id/detailRoomTypeIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        app:tint="@color/velocity_red_primary"
                        tools:src="@drawable/ic_bank" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/shape_search_field"
                    android:backgroundTint="@color/velocity_red_bg_end"
                    android:padding="14dp"
                    android:lineSpacingExtra="6dp"
                    android:text="@string/hotel_policies_content"
                    android:textColor="@color/velocity_text_secondary"
                    android:textSize="12sp" />

                <!-- Occupied info: shown instead of the CTA row when the room is
                     unavailable for the searched dates. No guest/booking identity
                     is shown here, only the occupancy period. -->
                <LinearLayout
                    android:id="@+id/layoutDetailOccupiedInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/shape_search_field"
                    android:backgroundTint="@color/velocity_red_bg_end"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/velocity_inactive_gray" />

                    <TextView
                        android:id="@+id/tvDetailOccupiedRange"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="12sp"
                        tools:text="Occupied: Aug 10, 2026 – Aug 14, 2026" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutDetailActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Velocity.Label.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="@string/actions_label"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReserveRoom"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="@string/reserve_now"
                            android:textAllCaps="false"
                            android:textColor="@color/velocity_red_primary"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-black"
                            app:cornerRadius="26dp"
                            app:icon="@drawable/ic_reservation"
                            app:iconGravity="textStart"
                            app:iconSize="16dp"
                            app:iconTint="@color/velocity_red_primary"
                            app:strokeColor="@color/velocity_red_soft" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBookRoom"
                            style="@style/Widget.Velocity.Button"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="@string/book_now"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
