<?xml version="1.0" encoding="utf-8"?>
<!-- Room details, in clear sections (Title Case headers, label left / value right):
       photo gallery (availability chip, close)
       name and price per night (bold, large), room-type and refund chips
       Overview ..... the full description
       Room Facts ... Guests / Beds / Size
       Amenities .... a two-column list with icons
       Policies ..... refund policy and check-in / check-out times, then the full hotel policies (folded)
     and a sticky bottom bar that never scrolls away: the price and the dates, Reserve and Book now (or, when picking rooms for a
     booking in progress, the room quantity and Done). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Velocity.Card.Glass"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/card_corner_radius">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card_white"
        android:orientation="vertical">

        <!-- Photo gallery -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/room_card_image_height">

            <ImageView
                android:id="@+id/detailRoomImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_room_placeholder_gradient"
                android:contentDescription="@string/cd_room_image"
                android:scaleType="centerCrop" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/detailRoomImagePager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_overlay" />

            <!-- Gallery photo-count chip - also the "tap to view full screen" hint. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/detailGalleryCountCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="#99000000"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeWidth="0dp"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/detailGalleryCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="5dp"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:drawableStartCompat="@drawable/ic_star"
                    app:drawableTint="@color/white"
                    tools:text="1 / 5 · Tap to view" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Availability chip, top-left -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/detailStatusCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="10dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeColor="@color/velocity_green_subtle"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/detailStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:letterSpacing="0"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="@string/available_label"
                    android:textAllCaps="false"
                    android:textColor="@color/velocity_green_primary"
                    android:textSize="12sp" />
            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClose"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:contentDescription="@string/cd_close_dialog"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:backgroundTint="#99000000"
                app:cornerRadius="0dp"
                app:icon="@drawable/ic_close"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="17dp"
                app:iconTint="@color/white" />
        </FrameLayout>

        <!-- The sections. MaxHeightNestedScrollView (not plain NestedScrollView, which silently ignores android:maxHeight) -
             capped in RoomDetailsDialog so the bottom bar below always stays on screen. -->
        <com.example.velocitysuites.MaxHeightNestedScrollView
            android:id="@+id/scrollRoomDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/room_card_content_padding"
                android:paddingTop="14dp"
                android:paddingBottom="12dp">

                <!-- Name (bold, large) and price per night, side by side or stacked when they do not fit. -->
                <com.example.velocitysuites.NamePriceRow
                    android:id="@+id/detailNamePriceRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/detailRoomName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="22sp"
                        tools:text="Executive City Suite" />

                    <TextView
                        android:id="@+id/detailRoomPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="22sp"
                        tools:text="₱5,500 / night" />
                </com.example.velocitysuites.NamePriceRow>

                <!-- Room type (only when it is not just the name again) and the refund policy, as small chips. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/detailRoomType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/shape_intro_pill"
                        android:backgroundTint="@color/status_cancelled_bg"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0"
                        android:maxLines="1"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textColor="@color/status_cancelled_fg"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="Suite"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/detailRefundChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_warning"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:letterSpacing="0"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="4dp"
                        android:text="@string/no_refund_badge"
                        android:textColor="@color/velocity_action_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Promos: every promo running for this room type (title, value, short description, valid until). Left out when none. -->
                <TextView
                    android:id="@+id/headPromos"
                    style="@style/TextAppearance.Velocity.Section.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/promos_heading"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutDetailPromos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- Overview -->
                <TextView
                    android:id="@+id/headOverview"
                    style="@style/TextAppearance.Velocity.Section.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/room_section_overview" />

                <TextView
                    android:id="@+id/detailRoomDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/velocity_text_secondary"
                    android:textSize="13sp"
                    tools:text="Spacious suite with premium bedding, work lounge, city view, and complimentary breakfast." />

                <!-- Room facts: label left, value right -->
                <TextView
                    android:id="@+id/headFacts"
                    style="@style/TextAppearance.Velocity.Section.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/room_section_facts" />

                <LinearLayout
                    android:id="@+id/layoutDetailFacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Amenities: two columns, each with its icon -->
                <TextView
                    android:id="@+id/headAmenities"
                    style="@style/TextAppearance.Velocity.Section.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/amenities_label" />

                <GridLayout
                    android:id="@+id/detailRoomAmenities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:columnCount="2" />

                <!-- Policies: refund policy and the check-in / check-out times, then everything else (folded) -->
                <TextView
                    android:id="@+id/headPolicies"
                    style="@style/TextAppearance.Velocity.Section.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/room_section_policies" />

                <LinearLayout
                    android:id="@+id/layoutDetailPolicies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/headMorePolicies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:text="@string/hotel_policies_label"
                    android:textColor="@color/velocity_action_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/detailPoliciesBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_search_field"
                    android:backgroundTint="@color/velocity_red_bg_end"
                    android:lineSpacingExtra="5dp"
                    android:padding="13dp"
                    android:textColor="@color/velocity_text_secondary"
                    android:textSize="12sp" />

                <!-- Occupied info: shown instead of the actions when the room is unavailable for the searched dates. No guest or
                     booking identity - only the occupancy period. -->
                <LinearLayout
                    android:id="@+id/layoutDetailOccupiedInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/shape_search_field"
                    android:backgroundTint="@color/velocity_red_bg_end"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="13dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/velocity_inactive_gray" />

                    <TextView
                        android:id="@+id/tvDetailOccupiedRange"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="12sp"
                        tools:text="Occupied: Aug 10, 2026 – Aug 14, 2026" />
                </LinearLayout>
            </LinearLayout>
        </com.example.velocitysuites.MaxHeightNestedScrollView>

        <!-- Sticky bottom bar -->
        <LinearLayout
            android:id="@+id/layoutDetailBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/velocity_surface_elevated"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/velocity_divider_hairline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/room_card_content_padding"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <!-- The price, and the dates when the guest searched for some. -->
                <LinearLayout
                    android:id="@+id/layoutDetailBarSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/detailBarPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:maxLines="1"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="15sp"
                        tools:text="₱3,500 / night" />

                    <TextView
                        android:id="@+id/detailBarDates"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="Oct 21 → Oct 22 · 1 night"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- Reserve and Book now -->
                <LinearLayout
                    android:id="@+id/layoutDetailActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReserveRoom"
                        style="@style/Widget.Velocity.Flat.Button.Compact"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingHorizontal="8dp"
                        android:text="@string/room_card_reserve"
                        app:icon="@drawable/ic_calendar"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/velocity_action_text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBookRoom"
                        style="@style/Widget.Velocity.Flat.Button.Compact.Filled"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingHorizontal="8dp"
                        android:text="@string/room_card_book_now"
                        app:icon="@drawable/ic_booking"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/button_primary_text" />
                </LinearLayout>

                <!-- Choosing rooms for a booking in progress (RoomDetailsDialog#showForStaging): the quantity, what it costs, Done. -->
                <LinearLayout
                    android:id="@+id/layoutDetailQuantitySection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/room_quantity_label"
                            android:textColor="@color/velocity_text_primary"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDetailQtyMinus"
                            style="@style/Widget.MaterialComponents.Button.Icon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="@string/cd_decrease_quantity"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:backgroundTint="@color/velocity_red_subtle"
                            app:cornerRadius="0dp"
                            app:icon="@drawable/ic_remove"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="18dp"
                            app:iconTint="@color/velocity_red_primary" />

                        <TextView
                            android:id="@+id/tvDetailQty"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:textColor="@color/velocity_text_primary"
                            android:textSize="16sp"
                            tools:text="2" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDetailQtyPlus"
                            style="@style/Widget.MaterialComponents.Button.Icon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="@string/cd_increase_quantity"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:backgroundTint="@color/velocity_red_subtle"
                            app:cornerRadius="0dp"
                            app:icon="@drawable/ic_add"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="18dp"
                            app:iconTint="@color/velocity_red_primary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetailSelectedIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="12sp"
                        tools:text="2 Rooms Selected" />

                    <LinearLayout
                        android:id="@+id/layoutDetailSubtotalRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/shape_search_field"
                        android:backgroundTint="@color/velocity_red_bg_end"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/subtotal_label"
                            android:textColor="@color/velocity_text_primary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvDetailSubtotalAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/velocity_red_primary"
                            android:textSize="14sp"
                            tools:text="₱14,000.00" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetailDone"
                        style="@style/Widget.Velocity.Flat.Button.Compact.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/done_label" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
