<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Velocity.Card.Glass"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card_white"
        android:padding="24dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/iconContainer"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:cardBackgroundColor="@color/velocity_red_soft"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivDetailIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_notifications"
                app:tint="@color/velocity_red_primary" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:backgroundTint="@color/velocity_red_soft"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_close"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/velocity_red_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:rippleColor="@color/white" />

        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/velocity_red_dark"
            android:textSize="22sp"
            android:letterSpacing="-0.02"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iconContainer"
            tools:text="Reservation Confirmation" />

        <TextView
            android:id="@+id/tvDetailTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/velocity_inactive_gray"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDetailTitle"
            tools:text="Today • 10:30 AM" />

        <View
            android:id="@+id/divider"
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/shape_intro_pill"
            android:backgroundTint="@color/velocity_red_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDetailTime" />

        <TextView
            android:id="@+id/tvDetailMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.4"
            android:textColor="@color/velocity_text_primary"
            android:textSize="15sp"
            android:alpha="0.9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider"
            tools:text="Your booking for Executive Suite (Ref: VS-1024) has been confirmed for Oct 12-15, 2023. We look forward to welcoming you to Velocity Suites!" />

        <TextView
            android:id="@+id/tvDetailBookingId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/shape_intro_pill"
            android:backgroundTint="@color/velocity_red_bg_end"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:textColor="@color/velocity_red_dark"
            android:textSize="14sp"
            android:letterSpacing="0.02"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/tvDetailMessage"
            tools:visibility="visible"
            tools:text="Booking ID: VS-8829" />

        <TextView
            android:id="@+id/tvDetailAudience"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/shape_intro_pill"
            android:backgroundTint="@color/velocity_blue_soft"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="12dp"
            android:textColor="@color/velocity_blue_primary"
            android:textSize="13sp"
            android:letterSpacing="0.02"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/tvDetailBookingId"
            tools:visibility="visible"
            tools:text="Sent to: Guest &amp; Mobile App, Manager" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/view_transaction_details_label"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:backgroundTint="@color/velocity_red_primary"
            app:cornerRadius="20dp"
            app:layout_constraintTop_toBottomOf="@+id/tvDetailAudience" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSecondaryAction"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-bold"
            android:text="Dismiss"
            android:textAllCaps="false"
            android:textColor="@color/velocity_inactive_gray"
            app:layout_constraintTop_toBottomOf="@+id/btnPrimaryAction" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>