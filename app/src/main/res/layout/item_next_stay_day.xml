<?xml version="1.0" encoding="utf-8"?>
<!-- One day in the Your Next Stay day selector: friendly name or weekday, date, and a count badge when it has transactions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nextStayDay"
    android:layout_width="68dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_next_day_chip"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:minHeight="72dp"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/tvDayName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textSize="12sp"
        tools:text="Today" />

    <TextView
        android:id="@+id/tvDayDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textSize="12sp"
        tools:text="Oct 18" />

    <TextView
        android:id="@+id/tvDayCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/shape_intro_pill"
        android:backgroundTint="@color/velocity_red_primary"
        android:fontFamily="sans-serif-black"
        android:importantForAccessibility="no"
        android:minWidth="18dp"
        android:gravity="center"
        android:paddingHorizontal="6dp"
        android:textColor="@color/white"
        android:textSize="11sp"
        tools:text="2" />
</LinearLayout>
