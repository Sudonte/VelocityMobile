<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_flat_box"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvEntryRef"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/velocity_text_primary"
            android:textSize="14sp"
            tools:text="Booking #338" />

        <TextView
            android:id="@+id/tvEntryKind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_success"
            android:fontFamily="sans-serif-black"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/velocity_green_dark"
            android:textSize="11sp"
            tools:text="Check-in" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEntryRooms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/velocity_text_secondary"
        android:textSize="12sp"
        tools:text="Deluxe Room x2" />

    <TextView
        android:id="@+id/tvEntryWhen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/velocity_text_primary"
        android:textSize="12sp"
        tools:text="Oct 20, 2026 - 02:00:00 PM" />

    <TextView
        android:id="@+id/tvEntryStay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/velocity_text_secondary"
        android:textSize="12sp"
        tools:text="Stay: Oct 20, 2026 to Oct 22, 2026" />

    <TextView
        android:id="@+id/tvEntryBalance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-bold"
        android:textColor="@color/velocity_text_primary"
        android:textSize="12sp"
        tools:text="Balance: PHP 1,500.00" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEntryDetails"
        style="@style/Widget.Velocity.Flat.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minHeight="48dp"
        android:text="@string/stay_calendar_view_full" />
</LinearLayout>
