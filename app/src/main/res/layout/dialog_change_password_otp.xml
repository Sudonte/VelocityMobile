<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Velocity.Card.Glass"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Two steps in one dialog, one visible at a time: step 1 (OTP) and step 2 (new password).
         The scrolling form and the button footer are siblings so the buttons stay above the keyboard. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card_white"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        app:cardBackgroundColor="@color/velocity_red_soft"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/card_elevation">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/velocity_red_primary" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="13dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Velocity.ScreenTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/change_password"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/changePasswordStepText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/velocity_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Three segments, one per step: request the code, enter it, choose the new password. -->
                <LinearLayout
                    android:id="@+id/changePasswordProgress"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    android:importantForAccessibility="no"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/changePasswordSeg1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/shape_intro_pill"
                        android:backgroundTint="@color/velocity_red_primary" />

                    <View
                        android:id="@+id/changePasswordSeg2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/shape_intro_pill"
                        android:backgroundTint="@color/velocity_red_soft" />

                    <View
                        android:id="@+id/changePasswordSeg3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/shape_intro_pill"
                        android:backgroundTint="@color/velocity_red_soft" />
                </LinearLayout>

                <!-- The three stages the guest sees: Verify (ask for + enter the code), New Password, Done. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-8dp"
                    android:layout_marginBottom="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/changePasswordLabelVerify"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/change_password_stage_verify"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/changePasswordLabelNew"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/change_password_stage_new"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/changePasswordLabelDone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@string/change_password_stage_done"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- ============ Step 1: ask for the code ============ -->
                <LinearLayout
                    android:id="@+id/changePasswordStepRequest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Velocity.Label.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/change_password_request_title"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/changePasswordRequestDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_flat_box"
                        android:lineSpacingExtra="3dp"
                        android:padding="12dp"
                        android:text="@string/change_password_request_hint"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/changePasswordRequestError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- ============ Step 2: enter the code ============ -->
                <LinearLayout
                    android:id="@+id/changePasswordStepOtp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/changePasswordOtpDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/changePasswordOtpBoxes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/change_password_otp_expiry_hint"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/changePasswordOtpError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/resendChangePasswordOtpLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-bold"
                        android:minHeight="40dp"
                        android:gravity="center_vertical"
                        android:padding="2dp"
                        android:text="@string/resend_otp"
                        android:textColor="@color/velocity_red_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- ============ Step 3: new password (only shown after the server verified the code) ============ -->
                <LinearLayout
                    android:id="@+id/changePasswordStepPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/change_password_new_desc"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/TextAppearance.Velocity.Label.Input"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:labelFor="@+id/changePasswordNew"
                        android:text="@string/new_password_hint"
                        android:textColor="@color/velocity_text_primary" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/changePasswordNewLayout"
                        style="@style/Widget.Velocity.TextInputLayout.OutlinedBox.Rounded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:endIconMode="password_toggle"
                        app:startIconDrawable="@drawable/ic_lock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/changePasswordNew"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/TextAppearance.Velocity.Label.Input"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:labelFor="@+id/changePasswordConfirmNew"
                        android:text="@string/confirm_new_password_hint"
                        android:textColor="@color/velocity_text_primary" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/changePasswordConfirmNewLayout"
                        style="@style/Widget.Velocity.TextInputLayout.OutlinedBox.Rounded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:endIconMode="password_toggle"
                        app:startIconDrawable="@drawable/ic_lock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/changePasswordConfirmNew"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Strength: a hint on top of the server's own rule (at least 8 characters + a matching confirmation). -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/changePasswordStrengthBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="4"
                        android:progress="0"
                        app:indicatorColor="@color/velocity_red_primary"
                        app:trackColor="@color/velocity_red_soft"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="6dp" />

                    <TextView
                        android:id="@+id/changePasswordStrengthText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="12sp" />

                    <!-- Live rule hints; they mirror the server's validation exactly (min 8 + confirmation). -->
                    <TextView
                        android:id="@+id/changePasswordRuleLength"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/password_rule_length"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/changePasswordRuleMatch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/password_rule_match"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- ============ Done: the success screen ============ -->
                <LinearLayout
                    android:id="@+id/changePasswordStepDone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingVertical="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/velocity_green_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:accessibilityHeading="true"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="@string/change_password_done_title"
                        android:textColor="@color/velocity_text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/change_password_done_desc"
                        android:textColor="@color/velocity_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/velocity_red_soft" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|end"
            android:orientation="horizontal"
            android:paddingHorizontal="22dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelChangePasswordOtp"
                style="@style/Widget.Velocity.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:paddingHorizontal="16dp"
                android:text="@string/cancel_label"
                android:textAllCaps="false"
                android:textColor="@color/velocity_text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmChangePasswordOtp"
                style="@style/Widget.Velocity.Button"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="11dp"
                android:paddingHorizontal="18dp"
                android:text="@string/change_password_send_code"
                android:textAllCaps="false"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
