<?xml version="1.0" encoding="utf-8"?>
<!-- The live password checklist (PasswordRulesView): a strength bar and word, then the four rules - at least 8 characters, a letter, a number,
     and both passwords match. The same view is used for sign-up, forgot-password reset and change password. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/passwordStrengthBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="4"
        android:progress="0"
        android:saveEnabled="false"
        app:indicatorColor="@color/velocity_action_text"
        app:trackColor="@color/velocity_divider_hairline"
        app:trackCornerRadius="4dp"
        app:trackThickness="6dp" />

    <TextView
        android:id="@+id/passwordStrengthText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="sans-serif-bold"
        android:textColor="@color/velocity_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/ruleLength"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="2dp"
        android:text="@string/password_rule_length"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/ruleLetter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="2dp"
        android:text="@string/password_rule_letter"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/ruleNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="2dp"
        android:text="@string/password_rule_number"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/ruleMatch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="2dp"
        android:text="@string/password_rule_match"
        android:textSize="13sp" />
</merge>
