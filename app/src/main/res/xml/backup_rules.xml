<?xml version="1.0" encoding="utf-8"?>
<!--
   Legacy Auto Backup rules - only consulted on API 23-30 (ignored on API 31+,
   which reads data_extraction_rules.xml instead; both files must stay in
   sync). "VelocitySecurePrefs" holds the auth token and Remember Me state
   (see SessionManager's own doc) and must never be restored onto a fresh
   install/device - a restored copy would otherwise resurrect a working
   session with zero backend validation. Every other prefs file (account
   display fields, theme) is left backup-eligible on purpose.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="VelocitySecurePrefs.xml" />
</full-backup-content>
