<?xml version="1.0" encoding="utf-8"?>
<!-- The border of a Transaction History filter field: the same quiet gray for every field, red only while it is focused
     (or its menu is open). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/velocity_red_primary" android:state_focused="true" />
    <item android:color="@color/velocity_red_primary" android:state_activated="true" />
    <item android:color="@color/velocity_filter_stroke" />
</selector>
