<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Required at runtime on Android 13+ (API 33) for any notification to post at all;
         requested from DashboardActivity - see NotificationHelper/NotificationPermissionHelper. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:name=".VelocitySuitesApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VelocitySuites">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.VelocitySuites.Introduction">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WelcomeActivity"
            android:theme="@style/Theme.VelocitySuites.Introduction" />

        <activity
            android:name=".LandingActivity"
            android:theme="@style/Theme.VelocitySuites" />

        <activity
            android:name=".LoginActivity"
            android:theme="@style/Theme.VelocitySuites.Auth" />

        <activity
            android:name=".ResetPasswordActivity"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.VelocitySuites.Auth" />

        <activity
            android:name=".RegistrationActivity"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.VelocitySuites.Auth" />

        <activity
            android:name=".DashboardActivity"
            android:theme="@style/Theme.VelocitySuites" />

        <activity
            android:name=".RoomBrowsingActivity"
            android:exported="true"
            android:theme="@style/Theme.VelocitySuites" />

        <activity
            android:name=".ReceiptImageViewerActivity"
            android:theme="@style/Theme.VelocitySuites" />

        <activity
            android:name=".RoomGalleryActivity"
            android:theme="@style/Theme.VelocitySuites" />

        <activity
            android:name=".BookingAndReservationActivity"
            android:theme="@style/Theme.VelocitySuites.Flat" />

        <activity
            android:name=".BookingDetailsActivity"
            android:parentActivityName=".BookingAndReservationActivity"
            android:theme="@style/Theme.VelocitySuites.RedBg" />

        <activity
            android:name=".PaymentReceiptActivity"
            android:parentActivityName=".BookingDetailsActivity"
            android:theme="@style/Theme.VelocitySuites.ElevatedBg" />

        <activity
            android:name=".BookingWizardActivity"
            android:configChanges="screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.VelocitySuites.Flat" />

        <activity
            android:name=".StartingTransactionActivity"
            android:theme="@style/Theme.VelocitySuites" />

        <activity
            android:name=".PaymentActivity"
            android:theme="@style/Theme.VelocitySuites"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AdditionalAmenitiesActivity"
            android:theme="@style/Theme.VelocitySuites" />

        <activity
            android:name=".BillingSummaryActivity"
            android:theme="@style/Theme.VelocitySuites" />

        <activity
            android:name=".TransactionHistoryActivity"
            android:theme="@style/Theme.VelocitySuites" />

        <activity
            android:name=".TransactionDetailsActivity"
            android:parentActivityName=".TransactionHistoryActivity"
            android:theme="@style/Theme.VelocitySuites" />

        <activity
            android:name=".TransactionListActivity"
            android:theme="@style/Theme.VelocitySuites" />

        <activity
            android:name=".NotificationActivity"
            android:theme="@style/Theme.VelocitySuites" />

        <activity
            android:name=".NotificationDetailsActivity"
            android:parentActivityName=".NotificationActivity"
            android:theme="@style/Theme.VelocitySuites.RedBg" />

        <activity
            android:name=".ProfileManagementActivity"
            android:theme="@style/Theme.VelocitySuites" />

        <activity
            android:name=".UpcomingTransactionsActivity"
            android:theme="@style/Theme.VelocitySuites" />

        <activity
            android:name=".CalendarActivity"
            android:theme="@style/Theme.VelocitySuites.RedBg" />
    </application>

</manifest>

